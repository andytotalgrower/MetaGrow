@page "/r/{ShareId:guid}"
@layout SharedReportLayout
@attribute [AllowAnonymous]
@using ApiModels
@using ApiModels.MetaGrow
@using MetaGrow.Shared.Models
@using MetaGrow.Web.Components.Pages
@using MetaGrow.Web.Services
@using Metagen.Shared.Services
@inject ReportShareApiClient Shares
@inject ITgsApiService TgsApi
@inject IJSRuntime JavaScript
@inject ILogger<SharedMultiCropReport> Logger

<PageTitle>Shared survey report | MetaGrow</PageTitle>

@if (_loading)
{
    <div class="shared-report-state" role="status">
        <div class="spinner-border" aria-hidden="true"></div>
        <span>Opening shared report...</span>
    </div>
}
else if (_soilReport is not null)
{
    <div class="soil-share-toolbar"><DxButton Text="Print / save PDF" Click="PrintSoil" /></div>
    @* Public soil output uses the same resolved brand as the other shared report types. *@
    <SoilReportContent Document="_soilReport" BrandKey="@_brandKey" />
    <style>@@media print { .soil-share-toolbar { display:none; } }</style>
}
else if (_multiCropReport is not null)
{
    <MultiCropReport SurveyId="@_multiCropReport.SurveyId" Report="@_multiCropReport" Shared="true" SharedBrandKey="@_brandKey" />
}
else if (_bananaReport is not null)
{
    <BananaReport SurveyId="@_bananaReport.SurveyId" Report="@_bananaReport" Shared="true" SharedBrandKey="@_brandKey" />
}
else
{
    <div class="shared-report-state">
        <h1>Shared report unavailable</h1>
        <p>@_errorMessage</p>
    </div>
}

@code {
    [Parameter] public Guid ShareId { get; set; }

    private MultiCropOnlineReportDto? _multiCropReport;
    private SoilReportDocument? _soilReport;
    private async Task PrintSoil() => await JavaScript.InvokeVoidAsync("metaGrowReportPrinting.print", $"{_soilReport!.SurveyDate:yyyyMMdd}_{_soilReport.PropertyName}_{_soilReport.FileMaterialLabel}_Rev{_soilReport.Revision}.pdf", 100);
    private BananaOnlineReportDto? _bananaReport;
    private string _errorMessage = "This report link is invalid or has been revoked.";
    private string? _brandKey;
    private bool _loading = true;
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;

        try
        {
            var token = await JavaScript.InvokeAsync<string>("metaGrowReportSharing.getFragmentToken");
            if (string.IsNullOrWhiteSpace(token)) return;

            var (access, accessError) = await Shares.ResolveAsync(ShareId, token);
            if (access is null)
            {
                _errorMessage = accessError ?? _errorMessage;
                return;
            }

            // Preserve the share owner preference even when the viewer is logged in.
            _brandKey = access.BrandKey;
            if (string.Equals(access.ReportArea, MetaGrowReportAreas.Soil, StringComparison.OrdinalIgnoreCase))
                _soilReport = access.SoilReport;
            else if (string.Equals(access.ReportArea, MetaGrowReportAreas.Banana, StringComparison.OrdinalIgnoreCase))
                _bananaReport = await TgsApi.GetBananaOnlineReport(access.SurveyId);
            else
                _multiCropReport = await TgsApi.GetMultiCropOnlineReport(access.SurveyId);

            if (_multiCropReport is null && _bananaReport is null && _soilReport is null)
                _errorMessage = TgsApi.ErrorMessage ?? "The survey report could not be loaded.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to open shared report {ReportShareId}.", ShareId);
            _errorMessage = "The shared report could not be loaded. Please try again shortly.";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
