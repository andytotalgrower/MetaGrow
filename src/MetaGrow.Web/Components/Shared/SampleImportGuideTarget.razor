@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="guide-target @(_revealed ? "revealed" : null)" tabindex="-1" @ref="_element"
     role="region" aria-label="@Label">
    @if (_revealed)
    {
        <p class="guide-instruction" role="status"><strong>Start here:</strong> @Instruction</p>
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Destination { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Instruction { get; set; } = string.Empty;
    [Parameter] public int RequestVersion { get; set; }
    [Parameter] public bool Ready { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [SupplyParameterFromQuery(Name = "importGuide")] public string? RequestedGuide { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private string? _lastGuide;
    private int _lastRequestVersion;
    private bool _revealed;
    private bool _pending;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        if (RequestVersion != _lastRequestVersion ||
            (RequestedGuide == Destination && RequestedGuide != _lastGuide))
        {
            _revealed = true;
            _pending = true;
        }
        _lastGuide = RequestedGuide;
        _lastRequestVersion = RequestVersion;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pending || !Ready || _disposed) return;
        _pending = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./scripts/sample-import-guide.js");
            if (!_disposed) await _module.InvokeVoidAsync("reveal", _element);
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed while navigating away.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
