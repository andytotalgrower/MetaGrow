@using MetaGrow.Web.Services
@using System.Globalization

<footer class="survey-report-footer">
    <div><strong>@PropertyName</strong><span>@SurveyDateText</span><span>@PreparedBy</span><span>@Reference</span></div>
    <p>@Disclaimer</p>
</footer>
@((MarkupString)PrintStyle)

@code {
    [Parameter, EditorRequired] public ReportBrandOption Brand { get; set; } = default!;
    [Parameter] public string? PropertyName { get; set; }
    [Parameter] public string? AgronomistName { get; set; }
    [Parameter] public string? AgronomistPhone { get; set; }
    [Parameter] public string? Reference { get; set; }
    [Parameter] public DateTime SurveyDate { get; set; }

    private string SurveyDateText => $"Survey date: {SurveyDate:dd MMM yyyy}";

    private string PreparedBy => $"Prepared by {AgronomistName}" +
        (string.IsNullOrWhiteSpace(AgronomistPhone) ? "" : $"  P: {AgronomistPhone}");
    private string Disclaimer => $"{Brand.CompanyName} does not make any representations or warranties in respect hereof and expressly disclaims any liability for loss, damage or expenditure of whatsoever nature which may result from reliance on the contents of any advice given.";

    // Native page counters include pages created by long tables and optional photos.
    // This style exists only while the report is rendered. Use the document page:
    // switching to a named page inside the app shell creates blank boundary pages.
    private string PrintStyle => "<style>@page { size: A4 landscape; margin: 11mm 12mm 19mm; " +
        "@bottom-left { content: \"" + CssText($"{PropertyName}  |  {SurveyDateText}  |  {PreparedBy}  |  {Reference}") +
        "\\A " + CssText(Disclaimer) + "\"; width: 238mm; white-space: pre-wrap; font: 6.5pt/1.45 Arial, sans-serif; " +
        "color: #222; text-align: left; vertical-align: top; padding-top: 2mm; border-top: .25mm solid #777; } " +
        "@bottom-right { content: \"Page \" counter(page) \" of \" counter(pages); width: 35mm; " +
        "font: bold 8pt/1.45 Arial, sans-serif; color: #111; text-align: right; vertical-align: top; padding-top: 2mm; border-top: .25mm solid #777; } }</style>";

    // Escape arbitrary report text as CSS code points, including HTML delimiters.
    private static string CssText(string text) => string.Concat(text.Select(character =>
        char.IsAsciiLetterOrDigit(character) || character == ' '
            ? character.ToString()
            : "\\" + ((int)character).ToString("x", CultureInfo.InvariantCulture) + " "));
}
