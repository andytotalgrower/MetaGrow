@using System.Globalization
@using System.Net
@using System.Text
@using ApiModels

<div class="print-chart" aria-label="Printable chart for @Section.Title">
    @if (ChartSeries.Count > 0)
    {
        @((MarkupString)BuildSvg())
    }
    else
    {
        <p>No chart values were recorded for this section.</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public MultiCropReportSectionDto Section { get; set; } = default!;

    private const double PlotLeft = 70;
    private const double PlotRight = 980;
    private const double PlotTop = 65;
    private const double PlotBottom = 385;
    private const int TickCount = 5;

    private sealed record Category(string Code, string Label);
    private sealed record BarGeometry(double X, double Y, double Width, double Height);

    private IReadOnlyList<MultiCropReportSeriesDto> ChartSeries => Section.Series
        .Where(series => series.Points.Any(point => point.Value.HasValue))
        .ToList();

    private IReadOnlyList<Category> Categories
    {
        get
        {
            var definitions = Section.Metrics
                .OrderBy(metric => metric.SortOrder)
                .Select(metric => new Category(metric.MetricCode, metric.MetricLabel))
                .ToList();

            if (definitions.Count > 0) return definitions;

            return ChartSeries
                .SelectMany(series => series.Points)
                .Where(point => !string.IsNullOrWhiteSpace(point.MetricCode))
                .GroupBy(point => point.MetricCode, StringComparer.OrdinalIgnoreCase)
                .Select(group => new Category(group.Key, group.First().MetricLabel))
                .ToList();
        }
    }

    private IReadOnlyList<DateTime> Dates => ChartSeries
        .SelectMany(series => series.Points)
        .Where(point => point.Date.HasValue)
        .Select(point => point.Date!.Value.Date)
        .Distinct()
        .OrderBy(date => date)
        .ToList();

    private IReadOnlyList<DateTime> VisibleDates
    {
        get
        {
            if (Dates.Count <= 6) return Dates;

            var step = (int)Math.Ceiling(Dates.Count / 6d);
            var visible = Dates.Where((_, index) => index % step == 0).ToList();
            if (visible[^1] != Dates[^1]) visible.Add(Dates[^1]);
            return visible;
        }
    }

    private double AxisMaximum => NiceAxisMaximum(ChartSeries
        .SelectMany(series => series.Points)
        .Where(point => point.Value.HasValue)
        .Select(point => point.Value!.Value)
        .DefaultIfEmpty(0)
        .Max());

    private IEnumerable<double> YTicks => Enumerable.Range(0, TickCount + 1)
        .Select(index => AxisMaximum * index / TickCount);

    private double ValueY(double value) => PlotBottom - ((value / AxisMaximum) * (PlotBottom - PlotTop));

    private double CategoryX(int categoryIndex) =>
        PlotLeft + (((categoryIndex + 0.5) / Math.Max(1, Categories.Count)) * (PlotRight - PlotLeft));

    private double DateX(DateTime date)
    {
        if (Dates.Count <= 1) return (PlotLeft + PlotRight) / 2;
        var range = (Dates[^1] - Dates[0]).TotalDays;
        return PlotLeft + (((date - Dates[0]).TotalDays / Math.Max(1, range)) * (PlotRight - PlotLeft));
    }

    private BarGeometry Bar(int categoryIndex, int seriesIndex, double value)
    {
        var groupWidth = (PlotRight - PlotLeft) / Math.Max(1, Categories.Count);
        var availableWidth = groupWidth * 0.76;
        var barWidth = Math.Max(2, Math.Min(34, availableWidth / Math.Max(1, ChartSeries.Count)));
        var barsWidth = barWidth * ChartSeries.Count;
        var x = PlotLeft + (categoryIndex * groupWidth) + ((groupWidth - barsWidth) / 2) + (seriesIndex * barWidth);
        var y = ValueY(value);
        return new BarGeometry(x, y, Math.Max(1, barWidth - 1), Math.Max(0, PlotBottom - y));
    }

    private static double? CurrentValue(MultiCropReportSeriesDto series, string metricCode) =>
        series.Points.FirstOrDefault(point =>
            string.Equals(point.MetricCode, metricCode, StringComparison.OrdinalIgnoreCase))?.Value;

    private static List<MultiCropReportPointDto> HistoricalPoints(MultiCropReportSeriesDto series) =>
        series.Points
            .Where(point => point.Date.HasValue && point.Value.HasValue)
            .OrderBy(point => point.Date)
            .ToList();

    private string LinePoints(IEnumerable<MultiCropReportPointDto> points) => string.Join(' ', points.Select(point =>
        $"{SvgNumber(DateX(point.Date!.Value))},{SvgNumber(ValueY(point.Value!.Value))}"));

    private string BuildSvg()
    {
        var svg = new StringBuilder();
        svg.Append("<svg viewBox=\"0 0 1000 560\" role=\"img\" aria-label=\"")
            .Append(Encode($"{Section.Title} chart"))
            .Append("\"><title>")
            .Append(Encode(Section.Title))
            .Append("</title>");

        AppendLegend(svg);

        foreach (var tick in YTicks)
        {
            var y = ValueY(tick);
            svg.Append("<line class=\"grid-line\" x1=\"70\" x2=\"980\" y1=\"")
                .Append(SvgNumber(y)).Append("\" y2=\"").Append(SvgNumber(y)).Append("\"/>");
            AppendText(svg, "axis-label y-label", 58, y + 5, FormatValue(tick), "end");
        }

        svg.Append("<line class=\"axis-line\" x1=\"70\" x2=\"70\" y1=\"25\" y2=\"385\"/>")
            .Append("<line class=\"axis-line\" x1=\"70\" x2=\"980\" y1=\"385\" y2=\"385\"/>");

        if (Section.IsHistorical)
        {
            AppendHistoricalChart(svg);
        }
        else
        {
            AppendCurrentChart(svg);
        }

        return svg.Append("</svg>").ToString();
    }

    private void AppendHistoricalChart(StringBuilder svg)
    {
        for (var seriesIndex = 0; seriesIndex < ChartSeries.Count; seriesIndex++)
        {
            var series = ChartSeries[seriesIndex];
            var points = HistoricalPoints(series);
            if (points.Count > 1)
            {
                svg.Append("<polyline class=\"history-line\" points=\"")
                    .Append(LinePoints(points)).Append("\" stroke=\"")
                    .Append(SeriesColour(seriesIndex)).Append("\"/>");
            }

            foreach (var point in points)
            {
                svg.Append("<circle class=\"history-point\" cx=\"")
                    .Append(SvgNumber(DateX(point.Date!.Value))).Append("\" cy=\"")
                    .Append(SvgNumber(ValueY(point.Value!.Value))).Append("\" r=\"5\" fill=\"")
                    .Append(SeriesColour(seriesIndex)).Append("\"><title>")
                    .Append(Encode($"{series.Name}: {point.Value:0.##} on {point.Date:dd MMM yyyy}"))
                    .Append("</title></circle>");
            }
        }

        foreach (var date in VisibleDates)
        {
            var x = DateX(date);
            svg.Append("<line class=\"axis-tick\" x1=\"").Append(SvgNumber(x))
                .Append("\" x2=\"").Append(SvgNumber(x)).Append("\" y1=\"385\" y2=\"393\"/>");
            AppendText(svg, "axis-label", x, 414, date.ToString("dd MMM yy"), "middle");
        }
    }

    private void AppendLegend(StringBuilder svg)
    {
        for (var seriesIndex = 0; seriesIndex < ChartSeries.Count; seriesIndex++)
        {
            var column = seriesIndex % 5;
            var row = seriesIndex / 5;
            var x = 72 + (column * 180);
            var y = 12 + (row * 23);
            svg.Append("<rect class=\"legend-swatch\" x=\"").Append(x).Append("\" y=\"").Append(y)
                .Append("\" width=\"14\" height=\"14\" fill=\"").Append(SeriesColour(seriesIndex)).Append("\"/>");
            AppendText(svg, "legend-label", x + 21, y + 12, ChartSeries[seriesIndex].Name, "start");
        }
    }

    private void AppendCurrentChart(StringBuilder svg)
    {
        for (var categoryIndex = 0; categoryIndex < Categories.Count; categoryIndex++)
        {
            var category = Categories[categoryIndex];
            for (var seriesIndex = 0; seriesIndex < ChartSeries.Count; seriesIndex++)
            {
                var value = CurrentValue(ChartSeries[seriesIndex], category.Code);
                if (!value.HasValue) continue;

                var bar = Bar(categoryIndex, seriesIndex, value.Value);
                svg.Append("<rect class=\"chart-bar\" x=\"").Append(SvgNumber(bar.X))
                    .Append("\" y=\"").Append(SvgNumber(bar.Y))
                    .Append("\" width=\"").Append(SvgNumber(bar.Width))
                    .Append("\" height=\"").Append(SvgNumber(bar.Height))
                    .Append("\" fill=\"").Append(SeriesColour(seriesIndex)).Append("\"><title>")
                    .Append(Encode($"{ChartSeries[seriesIndex].Name} - {category.Label}: {value.Value:0.##}"))
                    .Append("</title></rect>");

                if (Categories.Count <= 12 && value.Value != 0)
                {
                    AppendText(svg, "bar-value", bar.X + (bar.Width / 2), Math.Max(18, bar.Y - 6),
                        value.Value.ToString("0.##"), "middle");
                }
            }

            var labelX = CategoryX(categoryIndex);
            AppendText(svg, "axis-label category-label", labelX, 410, ShortLabel(category.Label), "end",
                $"rotate(-60 {SvgNumber(labelX)} 410)");
        }
    }

    private static void AppendText(StringBuilder svg, string cssClass, double x, double y, string value,
        string anchor, string? transform = null)
    {
        svg.Append("<text class=\"").Append(cssClass).Append("\" x=\"").Append(SvgNumber(x))
            .Append("\" y=\"").Append(SvgNumber(y)).Append("\" text-anchor=\"").Append(anchor).Append('"');
        if (transform is not null) svg.Append(" transform=\"").Append(transform).Append('"');
        svg.Append('>').Append(Encode(value)).Append("</text>");
    }

    private static double NiceAxisMaximum(double maximum)
    {
        if (maximum <= 0) return 1;
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(maximum)));
        var normalized = maximum / magnitude;
        var nice = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10;
        return nice * magnitude;
    }

    private static string FormatValue(double value) => value.ToString(value >= 10 ? "0" : "0.##");
    private static string SvgNumber(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string ShortLabel(string value) => value.Length <= 22 ? value : $"{value[..19]}...";
    private static string Encode(string value) => WebUtility.HtmlEncode(value);

    private static string SeriesColour(int index)
    {
        string[] colours = ["#007cba", "#00654e", "#7a4cc2", "#df7b00", "#cf3651", "#4a4f54", "#00a1a3", "#7b8f20"];
        return colours[index % colours.Length];
    }
}
