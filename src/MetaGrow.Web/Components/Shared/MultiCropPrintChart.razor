@using System.Globalization
@using System.Net
@using System.Text
@using ApiModels
@using Metagen.Shared.Services
@using MetaGrow.Web.Services

<div class="print-chart @(Compact ? "print-chart-compact" : string.Empty)" aria-label="Printable chart for @Section.Title">
    @if (ChartSeries.Count > 0)
    {
        @((MarkupString)BuildSvg())
    }
    else
    {
        <p>No chart values were recorded for this section.</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public MultiCropReportSectionDto Section { get; set; } = default!;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool Rotated { get; set; }
    [Parameter] public double? FixedAxisMaximum { get; set; }
    [Parameter] public bool PercentageAxis { get; set; }
    [Parameter] public IReadOnlyList<string> Palette { get; set; } = UtilsService.ChartPalette;

    private const int TickCount = 5;

    private double PlotLeft => Rotated
        ? Math.Clamp(Categories.Select(c => c.Label.Length * 8 + 18).DefaultIfEmpty(70).Max(), 75, 235)
        : 45;
    private double PlotRight => 980;
    private int LegendColumns => Math.Clamp(900 / Math.Max(180, ChartSeries.Select(s => s.Name.Length * 7 + 35).DefaultIfEmpty(180).Max()), 1, 5);
    private double LegendHeight => Math.Ceiling(ChartSeries.Count / (double)LegendColumns) * 27 + 18;
    private double PlotTop => LegendHeight + 28;
    private double PlotBottom => Compact ? 780 : 385;
    private double ViewBoxHeight => Compact ? 840 : 470;

    private sealed record Category(string Code, string Label);
    private sealed record BarGeometry(double X, double Y, double Width, double Height);

    private IReadOnlyList<MultiCropReportSeriesDto> ChartSeries => Section.Series
        .Where(series => series.Points.Any(point => point.Value.HasValue))
        .ToList();

    private IReadOnlyList<Category> Categories
    {
        get
        {
            var definitions = Section.Metrics
                .OrderBy(metric => metric.SortOrder)
                .Select(metric => new Category(metric.MetricCode, metric.MetricLabel))
                .ToList();

            if (definitions.Count > 0) return definitions;

            return ChartSeries
                .SelectMany(series => series.Points)
                .Where(point => !string.IsNullOrWhiteSpace(point.MetricCode))
                .GroupBy(point => point.MetricCode, StringComparer.OrdinalIgnoreCase)
                .Select(group => new Category(group.Key, group.First().MetricLabel))
                .ToList();
        }
    }

    private IReadOnlyList<DateTime> Dates => ChartSeries
        .SelectMany(series => series.Points)
        .Where(point => point.Date.HasValue)
        .Select(point => point.Date!.Value.Date)
        .Distinct()
        .OrderBy(date => date)
        .ToList();

    private IReadOnlyList<DateTime> VisibleDates
    {
        get
        {
            if (Dates.Count <= 6) return Dates;

            var step = (int)Math.Ceiling(Dates.Count / 6d);
            var visible = Dates.Where((_, index) => index % step == 0).ToList();
            if (visible[^1] != Dates[^1]) visible.Add(Dates[^1]);
            return visible;
        }
    }

    private double AxisMaximum => FixedAxisMaximum is > 0
        ? FixedAxisMaximum.Value
        : NiceAxisMaximum(ChartSeries
            .SelectMany(series => series.Points)
            .Where(point => point.Value.HasValue)
            .Select(point => point.Value!.Value)
            .DefaultIfEmpty(0)
            .Max());

    private IEnumerable<double> YTicks => Enumerable.Range(0, TickCount + 1)
        .Select(index => AxisMaximum * index / TickCount);

    private double ValueY(double value) => PlotBottom - ((value / AxisMaximum) * (PlotBottom - PlotTop));

    private double CategoryX(int categoryIndex) =>
        PlotLeft + (((categoryIndex + 0.5) / Math.Max(1, Categories.Count)) * (PlotRight - PlotLeft));

    private double DateX(DateTime date)
    {
        if (Dates.Count <= 1) return (PlotLeft + PlotRight) / 2;
        var range = (Dates[^1] - Dates[0]).TotalDays;
        return PlotLeft + (((date - Dates[0]).TotalDays / Math.Max(1, range)) * (PlotRight - PlotLeft));
    }

    private BarGeometry Bar(int categoryIndex, int seriesIndex, double value)
    {
        var groupWidth = (PlotRight - PlotLeft) / Math.Max(1, Categories.Count);
        var availableWidth = groupWidth * 0.76;
        var barWidth = Math.Max(2, availableWidth / Math.Max(1, ChartSeries.Count));
        var barsWidth = barWidth * ChartSeries.Count;
        var x = PlotLeft + (categoryIndex * groupWidth) + ((groupWidth - barsWidth) / 2) + (seriesIndex * barWidth);
        var y = ValueY(value);
        return new BarGeometry(x, y, Math.Max(1, barWidth - 1), Math.Max(0, PlotBottom - y));
    }

    private double ValueX(double value) => PlotLeft + ((value / AxisMaximum) * (PlotRight - PlotLeft));

    private BarGeometry RotatedBar(int categoryIndex, int seriesIndex, double value)
    {
        var groupHeight = (PlotBottom - PlotTop) / Math.Max(1, Categories.Count);
        var availableHeight = groupHeight * 0.72;
        var barHeight = Math.Max(2, Math.Min(16, availableHeight / Math.Max(1, ChartSeries.Count)));
        var barsHeight = barHeight * ChartSeries.Count;
        var y = PlotTop + (categoryIndex * groupHeight) + ((groupHeight - barsHeight) / 2) + (seriesIndex * barHeight);
        return new BarGeometry(PlotLeft, y, Math.Max(0, ValueX(value) - PlotLeft), Math.Max(1, barHeight - 1));
    }

    private static double? CurrentValue(MultiCropReportSeriesDto series, string metricCode) =>
        series.Points.FirstOrDefault(point =>
            string.Equals(point.MetricCode, metricCode, StringComparison.OrdinalIgnoreCase))?.Value;

    private static List<MultiCropReportPointDto> HistoricalPoints(MultiCropReportSeriesDto series) =>
        series.Points
            .Where(point => point.Date.HasValue && point.Value.HasValue)
            .OrderBy(point => point.Date)
            .ToList();

    private string LinePoints(IEnumerable<MultiCropReportPointDto> points) => string.Join(' ', points.Select(point =>
        $"{SvgNumber(DateX(point.Date!.Value))},{SvgNumber(ValueY(point.Value!.Value))}"));

    private string BuildSvg()
    {
        var svg = new StringBuilder();
        svg.Append("<svg viewBox=\"0 0 1000 ").Append(SvgNumber(ViewBoxHeight))
            .Append("\" role=\"img\" aria-label=\"")
            .Append(Encode($"{Section.Title} chart"))
            .Append("\"><title>")
            .Append(Encode(Section.Title))
            .Append("</title>");

        AppendLegend(svg);

        if (Rotated && !Section.IsHistorical)
        {
            AppendRotatedCurrentChart(svg);
        }
        else
        {
            foreach (var tick in YTicks)
            {
                var y = ValueY(tick);
                svg.Append("<line class=\"grid-line\" x1=\"").Append(SvgNumber(PlotLeft))
                    .Append("\" x2=\"").Append(SvgNumber(PlotRight)).Append("\" y1=\"")
                    .Append(SvgNumber(y)).Append("\" y2=\"").Append(SvgNumber(y)).Append("\"/>");
                AppendText(svg, "axis-label y-label", PlotLeft - 8, y + 5, AxisLabel(tick), "end");
            }

            svg.Append("<line class=\"axis-line\" x1=\"").Append(SvgNumber(PlotLeft))
                .Append("\" x2=\"").Append(SvgNumber(PlotLeft)).Append("\" y1=\"").Append(SvgNumber(PlotTop)).Append("\" y2=\"")
                .Append(SvgNumber(PlotBottom)).Append("\"/>")
                .Append("<line class=\"axis-line\" x1=\"").Append(SvgNumber(PlotLeft))
                .Append("\" x2=\"").Append(SvgNumber(PlotRight)).Append("\" y1=\"")
                .Append(SvgNumber(PlotBottom)).Append("\" y2=\"").Append(SvgNumber(PlotBottom)).Append("\"/>");

            if (Section.IsHistorical)
            {
                AppendHistoricalChart(svg);
            }
            else
            {
                AppendCurrentChart(svg);
            }
        }

        return svg.Append("</svg>").ToString();
    }

    private void AppendHistoricalChart(StringBuilder svg)
    {
        for (var seriesIndex = 0; seriesIndex < ChartSeries.Count; seriesIndex++)
        {
            var series = ChartSeries[seriesIndex];
            var points = HistoricalPoints(series);
            if (points.Count > 1)
            {
                svg.Append("<polyline class=\"history-line")
                    .Append(ReportChartLayout.IsAreaAverage(series.Name) ? " area-average" : "")
                    .Append("\" points=\"")
                    .Append(LinePoints(points)).Append("\" stroke=\"")
                    .Append(SeriesColour(seriesIndex)).Append("\"/>");
            }

            foreach (var point in points.Where(_ => !ReportChartLayout.IsAreaAverage(series.Name)))
            {
                svg.Append("<circle class=\"history-point\" cx=\"")
                    .Append(SvgNumber(DateX(point.Date!.Value))).Append("\" cy=\"")
                    .Append(SvgNumber(ValueY(point.Value!.Value))).Append("\" r=\"5\" fill=\"")
                    .Append(SeriesColour(seriesIndex)).Append("\"><title>")
                    .Append(Encode($"{series.Name}: {point.Value:0.##} on {point.Date:dd MMM yyyy}"))
                    .Append("</title></circle>");
            }
        }

        foreach (var date in VisibleDates)
        {
            var x = DateX(date);
            svg.Append("<line class=\"axis-tick\" x1=\"").Append(SvgNumber(x))
                .Append("\" x2=\"").Append(SvgNumber(x)).Append("\" y1=\"").Append(SvgNumber(PlotBottom))
                .Append("\" y2=\"").Append(SvgNumber(PlotBottom + 8)).Append("\"/>");
            AppendText(svg, "axis-label", x, PlotBottom + 29, date.ToString("dd MMM yy"), "middle");
        }
    }

    private void AppendLegend(StringBuilder svg)
    {
        svg.Append("<rect class=\"legend-box\" x=\"4\" y=\"2\" width=\"992\" height=\"")
            .Append(SvgNumber(LegendHeight)).Append("\" rx=\"7\"/>");
        for (var seriesIndex = 0; seriesIndex < ChartSeries.Count; seriesIndex++)
        {
            var column = seriesIndex % LegendColumns;
            var row = seriesIndex / LegendColumns;
            var x = 18 + (column * 970 / LegendColumns);
            var y = 14 + (row * 27);
            if (Section.IsHistorical)
            {
                svg.Append("<line class=\"history-line")
                    .Append(ReportChartLayout.IsAreaAverage(ChartSeries[seriesIndex].Name) ? " area-average" : "")
                    .Append("\" x1=\"").Append(x).Append("\" x2=\"").Append(x + 28)
                    .Append("\" y1=\"").Append(y + 7).Append("\" y2=\"").Append(y + 7)
                    .Append("\" stroke=\"").Append(SeriesColour(seriesIndex)).Append("\"/>");
            }
            else
                svg.Append("<rect class=\"legend-swatch\" x=\"").Append(x).Append("\" y=\"").Append(y)
                    .Append("\" width=\"18\" height=\"16\" rx=\"2\" fill=\"").Append(SeriesColour(seriesIndex)).Append("\"/>");
            AppendText(svg, "legend-label", x + 36, y + 13, ChartSeries[seriesIndex].Name, "start");
        }
    }

    private void AppendCurrentChart(StringBuilder svg)
    {
        for (var categoryIndex = 0; categoryIndex < Categories.Count; categoryIndex++)
        {
            var category = Categories[categoryIndex];
            for (var seriesIndex = 0; seriesIndex < ChartSeries.Count; seriesIndex++)
            {
                var value = CurrentValue(ChartSeries[seriesIndex], category.Code);
                if (!value.HasValue) continue;

                var bar = Bar(categoryIndex, seriesIndex, value.Value);
                svg.Append("<rect class=\"chart-bar\" x=\"").Append(SvgNumber(bar.X))
                    .Append("\" y=\"").Append(SvgNumber(bar.Y))
                    .Append("\" width=\"").Append(SvgNumber(bar.Width))
                    .Append("\" height=\"").Append(SvgNumber(bar.Height))
                    .Append("\" fill=\"").Append(SeriesColour(seriesIndex)).Append("\"><title>")
                    .Append(Encode($"{ChartSeries[seriesIndex].Name} - {category.Label}: {value.Value:0.##}"))
                    .Append("</title></rect>");

                // Keep labels inside bars only where they fit. Dense charts retain
                // their exact values in the summary and interactive tooltips.
                if (value.Value != 0 && bar.Height >= 18 && bar.Width >= value.Value.ToString("0.##").Length * 6 + 4)
                {
                    AppendText(svg, "bar-value", bar.X + (bar.Width / 2), bar.Y + 13,
                        value.Value.ToString("0.##"), "middle");
                }
            }

            var labelX = CategoryX(categoryIndex);
            var labelY = PlotBottom + 25;
            var columnWidth = (PlotRight - PlotLeft) / Math.Max(1, Categories.Count);
            var fontSize = Math.Clamp(columnWidth / 7, 10, 13);
            var lines = WrapLabel(category.Label, Math.Max(6, (int)(columnWidth / (fontSize * .55))));
            for (var line = 0; line < lines.Count; line++)
                AppendText(svg, "axis-label category-label", labelX, labelY + line * (fontSize + 2), lines[line], "middle", fontSize: fontSize);
        }
    }

    private void AppendRotatedCurrentChart(StringBuilder svg)
    {
        foreach (var tick in YTicks)
        {
            var x = ValueX(tick);
            svg.Append("<line class=\"grid-line\" x1=\"").Append(SvgNumber(x))
                .Append("\" x2=\"").Append(SvgNumber(x)).Append("\" y1=\"").Append(SvgNumber(PlotTop))
                .Append("\" y2=\"").Append(SvgNumber(PlotBottom)).Append("\"/>");
            AppendText(svg, "axis-label", x, PlotBottom + 29, AxisLabel(tick), "middle");
        }

        svg.Append("<line class=\"axis-line\" x1=\"").Append(SvgNumber(PlotLeft))
            .Append("\" x2=\"").Append(SvgNumber(PlotLeft)).Append("\" y1=\"").Append(SvgNumber(PlotTop))
            .Append("\" y2=\"").Append(SvgNumber(PlotBottom)).Append("\"/>")
            .Append("<line class=\"axis-line\" x1=\"").Append(SvgNumber(PlotLeft))
            .Append("\" x2=\"").Append(SvgNumber(PlotRight)).Append("\" y1=\"").Append(SvgNumber(PlotBottom))
            .Append("\" y2=\"").Append(SvgNumber(PlotBottom)).Append("\"/>");

        for (var categoryIndex = 0; categoryIndex < Categories.Count; categoryIndex++)
        {
            var category = Categories[categoryIndex];
            var groupHeight = (PlotBottom - PlotTop) / Math.Max(1, Categories.Count);
            var labelY = PlotTop + ((categoryIndex + 0.5) * groupHeight) + 4;
            AppendText(svg, "axis-label category-label", PlotLeft - 10, labelY, category.Label, "end",
                fontSize: Math.Clamp((PlotLeft - 18) / Math.Max(1, category.Label.Length) / .55, 12, 18));

            for (var seriesIndex = 0; seriesIndex < ChartSeries.Count; seriesIndex++)
            {
                var value = CurrentValue(ChartSeries[seriesIndex], category.Code);
                if (!value.HasValue) continue;

                var bar = RotatedBar(categoryIndex, seriesIndex, value.Value);
                svg.Append("<rect class=\"chart-bar\" x=\"").Append(SvgNumber(bar.X))
                    .Append("\" y=\"").Append(SvgNumber(bar.Y))
                    .Append("\" width=\"").Append(SvgNumber(bar.Width))
                    .Append("\" height=\"").Append(SvgNumber(bar.Height))
                    .Append("\" fill=\"").Append(SeriesColour(seriesIndex)).Append("\"><title>")
                    .Append(Encode($"{ChartSeries[seriesIndex].Name} - {category.Label}: {value.Value:0.##}"))
                    .Append("</title></rect>");
            }
        }
    }

    private static void AppendText(StringBuilder svg, string cssClass, double x, double y, string value,
        string anchor, string? transform = null, double? fontSize = null)
    {
        svg.Append("<text class=\"").Append(cssClass).Append("\" x=\"").Append(SvgNumber(x))
            .Append("\" y=\"").Append(SvgNumber(y)).Append("\" text-anchor=\"").Append(anchor).Append('"');
        if (transform is not null) svg.Append(" transform=\"").Append(transform).Append('"');
        if (fontSize.HasValue) svg.Append(" style=\"font-size:").Append(SvgNumber(fontSize.Value)).Append("px\"");
        svg.Append('>').Append(Encode(value)).Append("</text>");
    }

    private static double NiceAxisMaximum(double maximum)
    {
        if (maximum <= 0) return 1;
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(maximum)));
        var normalized = maximum / magnitude;
        var nice = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10;
        return nice * magnitude;
    }

    private static string FormatValue(double value) => value.ToString(value >= 10 ? "0" : "0.##");
    private string AxisLabel(double value) => FormatValue(value) + (PercentageAxis ? "%" : "");
    private static string SvgNumber(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static List<string> WrapLabel(string value, int maximumLength)
    {
        var lines = new List<string>();
        foreach (var word in value.Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            if (lines.Count > 0 && lines[^1].Length + word.Length + 1 <= maximumLength) lines[^1] += " " + word;
            else lines.Add(word);
        }
        return lines;
    }
    private static string Encode(string value) => WebUtility.HtmlEncode(value);

    private string SeriesColour(int index)
    {
        return Palette[index % Palette.Count];
    }
}
