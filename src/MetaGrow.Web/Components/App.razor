<!DOCTYPE html>
<html lang="en" data-bs-theme="@_colorScheme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script src="@Assets["scripts/theme-preferences.js"]"></script>
    @DxResourceManager.RegisterTheme(_activeTheme)
    @DxResourceManager.RegisterScripts()
    <script src="@Assets["_content/Metagen.AccountSettings.Razor/account-settings-authenticator-code.js"]"></script>
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    <link rel="stylesheet" href="@Assets["MetaGrow.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Metagen.AccountSettings.Razor/metagen-account-settings.css"]" />
    <link rel="stylesheet" href="@Assets["css/application-theme.css"]" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="@_bodyClass">
    <script>
        window.mantineScheme.restore();
    </script>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["scripts/report-sharing.js"]"></script>
    <script src="@Assets["scripts/report-printing.js"]"></script>
    <script src="@Assets["scripts/filter-preferences.js"]"></script>
    <script src="@Assets["scripts/new-tab-navigation.js"]"></script>
    <script src="@Assets["scripts/file-download.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Enhanced navigation can replace server-rendered body attributes without reloading scripts.
        Blazor.addEventListener('enhancedload', function () { window.mantineScheme.restore(); });
    </script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="@Assets["scripts/passkey-management.js"]" type="module"></script>
    <script src="@Assets["_content/Metagen.AccountSettings.Razor/account-settings.js"]" type="module"></script>
</body>

</html>

@code {
    public static readonly ITheme _mantineLight = Themes.Fluent.Clone(properties => {
        properties.Name = "MetaGrow Light";
        properties.Mode = ThemeMode.Light;
        properties.AddFilePaths(
            "css/mantine/mantine-palette.css",
            "css/mantine/mantine-light.css",
            "css/mantine/mantine-components.css",
            "css/metagen-branding.css");
    });

    public static readonly ITheme _mantineDark = Themes.Fluent.Clone(properties => {
        properties.Name = "MetaGrow Dark";
        properties.Mode = ThemeMode.Dark;
        properties.AddFilePaths(
            "css/mantine/mantine-palette.css",
            "css/mantine/mantine-dark.css",
            "css/mantine/mantine-components.css",
            "css/metagen-branding.css");
    });

    private ITheme _activeTheme = _mantineLight;
    private string _bodyClass = string.Empty;
    private string _colorScheme = "light";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    protected override void OnInitialized()
    {
        var isDark = HttpContext.Request.Cookies["mantine-color-scheme"] == "dark";
        _activeTheme = isDark ? _mantineDark : _mantineLight;
        _bodyClass = isDark ? "mantine-dark" : string.Empty;
        _colorScheme = isDark ? "dark" : "light";
    }
}
