@page "/surveys/banana/{SurveyId:int}/report"
@using ApiModels
@using ApiModels.MetaGrow
@using Metagen.Shared.Services
@using MetaGrow.Web.Services
@attribute [Authorize(Roles = MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager + "," + MetaGrowRoles.Agronomist)]
@inject ITgsApiService TgsApi
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript
@inject IReportPreferenceApiClient _reportPreferences

<PageTitle>Banana survey @SurveyId | MetaGrow</PageTitle>

<div class="banana-report survey-print-report @(Print ? "print-layout" : string.Empty) @(_includePhotosForPrint ? "include-print-photos" : string.Empty)">
    @if (_loading)
    {
        <div class="report-loading" role="status">
            <div class="spinner-border" aria-hidden="true"></div>
            <span>Building banana survey report...</span>
        </div>
    }
    else if (_report is null)
    {
        <div class="title">
            <h1 class="title-header-text">Banana survey @SurveyId</h1>
            <div class="title-content-text">Online report</div>
        </div>
        <div class="alert alert-danger" role="alert">
            <strong>The report could not be loaded.</strong>
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <span> @_errorMessage</span>
            }
        </div>
        <DxButton Text="Back to surveys" RenderStyle="ButtonRenderStyle.Secondary" Click="BackToSurveys" />
    }
    else
    {
        <div class="report-toolbar no-print" role="toolbar" aria-label="Banana report tools">
            <div class="report-toolbar-navigation">
                @if (!Shared)
                {
                    <DxButton Text="Back to surveys" RenderStyle="ButtonRenderStyle.Secondary" Click="BackToSurveys" />
                    <DxButton Text="Edit survey" RenderStyle="ButtonRenderStyle.Secondary" Click="EditSurvey" />
                    <DxButton Text="Edit photos" RenderStyle="ButtonRenderStyle.Secondary" Click="ManagePhotos" />
                    <ReportShareButton SurveyId="@_report.SurveyId"
                                       PropertyName="@_report.PropertyName"
                                       ReportArea="@MetaGrowReportAreas.Banana" />
                }
            </div>
            <div class="report-toolbar-controls">
                <div class="report-brand-option">
                    <label for="banana-report-brand">Report brand</label>
                    <DxComboBox Id="banana-report-brand"
                                Data="@ReportBranding.Options"
                                @bind-Value="_reportBrandKey"
                                TextFieldName="Label"
                                ValueFieldName="Key"
                                AllowUserInput="false" />
                </div>
                @if (_report.Photos.Count > 0)
                {
                    <div class="print-photo-option" title="Photos are excluded from printed reports unless selected">
                        <DxCheckBox @bind-Checked="_includePhotosForPrint">Include photos in printout</DxCheckBox>
                    </div>
                }
                <DxButton Text="Print / save PDF" RenderStyle="ButtonRenderStyle.Primary" Click="PrintReportAsync" />
            </div>
        </div>

        <header class="report-header">
            <div class="report-title-block">
                <img class="report-cover-logo" src="@SelectedBrand.LogoPath" alt="@SelectedBrand.AltText" />
                <span class="report-eyebrow">Banana survey</span>
                <h1>@_report.PropertyName</h1>
                <p>Crop health and productivity report</p>
            </div>
        </header>

        <section class="report-meta" aria-label="Survey details">
            <div><span>Survey date</span><strong>@_report.SurveyDate.ToString("dd MMMM yyyy")</strong></div>
            @if (!string.IsNullOrWhiteSpace(_report.SurveyReference))
            {
                <div><span>Reference</span><strong>@_report.SurveyReference</strong></div>
            }
            <div><span>Agronomist</span><strong>@_report.AgronomistName</strong></div>
            <div><span>Status</span><strong>@_report.StatusName</strong></div>
            <div><span>Survey ID</span><strong>@_report.SurveyId</strong></div>
        </section>

        @if (_report.KeyFindings.Count > 0)
        {
            <section class="report-panel key-findings" aria-labelledby="banana-key-findings-title">
                <div class="section-heading">
                    <span class="section-kicker">At a glance</span>
                    <h2 id="banana-key-findings-title">Key findings</h2>
                </div>
                <ol>
                    @foreach (var finding in _report.KeyFindings)
                    {
                        <li>@finding</li>
                    }
                </ol>
            </section>
        }

            <section class="report-panel observations-section" aria-labelledby="banana-observations-title">
                <div class="section-heading">
                    <span class="section-kicker">Agronomist notes</span>
                    <h2 id="banana-observations-title">Observations</h2>
                </div>
                @if (_report.Comments.Any(comment => !string.IsNullOrWhiteSpace(comment.Text)))
                {
                <div class="comment-grid">
                    @foreach (var comment in _report.Comments.Where(comment => !string.IsNullOrWhiteSpace(comment.Text)))
                    {
                        <article>
                            @if (!string.Equals(comment.Title, "Agronomist comments", StringComparison.OrdinalIgnoreCase) &&
                                 !string.Equals(comment.Title, "Observations", StringComparison.OrdinalIgnoreCase))
                            {
                                <h3>@comment.Title</h3>
                            }
                            <p>@comment.Text</p>
                        </article>
                    }
                </div>
                }
                else
                {
                    <p class="no-comments">No observations were recorded for this survey.</p>
                }
            </section>

        @if (_report.Actions.Count > 0)
        {
            <section class="report-panel operational-section" aria-labelledby="banana-actions-title">
                <div class="operational-heading">
                    <div>
                        <span class="section-kicker">Work instructions</span>
                        <h2 id="banana-actions-title">Actions</h2>
                    </div>
                    <img class="handout-brand-logo" src="@SelectedBrand.LogoPath" alt="@SelectedBrand.AltText" />
                </div>
                <div class="action-table-scroll">
                    <table class="action-table">
                        <thead>
                            <tr><th>Date</th><th>Category / recommendation</th><th>Blocks</th><th>Notes</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var action in _report.Actions)
                            {
                                <tr>
                                    <td>@ActionDateText(action)</td>
                                    <td><strong class="action-category">@ActionGroupTitle(action.ActionGroupName)</strong>@action.Recommendation</td>
                                    <td>@action.Blocks</td>
                                    <td>@action.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <div class="chart-pairs">
        @foreach (var chartPair in ChartPairs)
        {
            <div class="chart-pair">
            @foreach (var chart in chartPair)
            {
                var chartId = $"banana-chart-{chart.Code}";
                <section class="report-panel chart-panel" aria-labelledby="@chartId">
                <img class="section-brand-logo print-only" src="@SelectedBrand.LogoPath" alt="@SelectedBrand.AltText" />
                <div class="section-heading">
                    <span class="section-kicker">@(chart.IsHistorical ? "Survey history" : "Current survey")</span>
                    <h2 id="@chartId">@chart.Title</h2>
                    <p class="no-print">Move over a point or bar for its value. Select a legend item to show or hide that series.</p>
                    @if (chart.Code != "soil-moisture" && !string.IsNullOrWhiteSpace(chart.ValueScaleText))
                    {
                        <p class="chart-unit">Values: @chart.ValueScaleText</p>
                    }
                </div>

                @if (chart.IsHistorical)
                {
                    var points = HistoricalChartPoints(chart);
                    <DxChart Data="@points"
                             Width="100%"
                             CssClass="report-chart interactive-chart"
                             Palette="@ReportChartLayout.Palette"
                             PaletteExtensionMode="ChartPaletteExtensionMode.Blend">
                        <DxChartArgumentAxis>
                            <DxChartAxisLabel Format="ChartElementFormat.ShortDate" />
                        </DxChartArgumentAxis>
                        @foreach (var series in chart.Series)
                        {
                            var seriesName = series.Name;
                            <DxChartLineSeries Name="@seriesName"
                                               DashStyle="@(ReportChartLayout.IsAreaAverage(seriesName) ? ChartDashStyle.Dash : ChartDashStyle.Solid)"
                                               ArgumentField="@((BananaHistoryChartPoint point) => point.Date)"
                                               ValueField="@((BananaHistoryChartPoint point) => point.Value)"
                                               Filter="@((BananaHistoryChartPoint point) => point.SeriesName == seriesName)" />
                        }
                        <DxChartLegend Position="RelativePosition.Outside" Orientation="Orientation.Horizontal" AllowToggleSeries="true" />
                        <DxChartTooltip Enabled="true" Position="RelativePosition.Outside">
                            <div class="chart-tooltip">
                                <strong>@context.Point.SeriesName</strong>
                                <span>@context.Point.Argument</span>
                                <span>@context.Point.Value</span>
                            </div>
                        </DxChartTooltip>
                    </DxChart>
                }
                else
                {
                    var points = CurrentChartPoints(chart);
                    <DxChart Data="@points"
                             Width="100%"
                             Rotated="true"
                             CssClass="report-chart interactive-chart"
                             Palette="@ReportChartLayout.Palette"
                             PaletteExtensionMode="ChartPaletteExtensionMode.Blend">
                        <DxChartArgumentAxis Type="ChartAxisType.Discrete" DiscreteDivisionMode="ChartDiscreteAxisDivisionMode.CrossLabels" />
                        @foreach (var series in chart.Series)
                        {
                            var seriesName = series.Name;
                            <DxChartBarSeries Name="@seriesName"
                                              ArgumentField="@((BananaCurrentChartPoint point) => point.Category)"
                                              ValueField="@((BananaCurrentChartPoint point) => point.Value)"
                                              Filter="@((BananaCurrentChartPoint point) => point.SeriesName == seriesName)" />
                        }
                        @if (chart.Code == "soil-moisture")
                        {
                            <DxChartValueAxis SideMarginsEnabled="false" EndOnTick="false"
                                              TickInterval="@(1d)" VisualRangeUpdateMode="ChartVisualRangeUpdateMode.Keep">
                                <DxChartAxisRange StartValue="@(0d)" EndValue="@(5d)" />
                            </DxChartValueAxis>
                        }
                        else if (chart.Code == "mites-beneficials")
                        {
                            <DxChartValueAxis>
                                <DxChartAxisRange StartValue="@(0d)" EndValue="@(5d)" />
                            </DxChartValueAxis>
                        }
                        else if (chart.Code == "leaf-disease")
                        {
                            <DxChartValueAxis>
                                <DxChartAxisRange StartValue="@(0d)" EndValue="@(100d)" />
                            </DxChartValueAxis>
                        }
                        <DxChartLegend Position="RelativePosition.Outside" Orientation="Orientation.Horizontal" AllowToggleSeries="true" />
                        <DxChartTooltip Enabled="true" Position="RelativePosition.Outside">
                            <div class="chart-tooltip">
                                <strong>@context.Point.SeriesName</strong>
                                <span>@context.Point.Argument</span>
                                <span>@context.Point.Value</span>
                            </div>
                        </DxChartTooltip>
                    </DxChart>
                }
                    <MultiCropPrintChart Section="@AsPrintSection(chart)"
                                         Palette="@ReportChartLayout.Palette"
                                         Compact="true"
                                         Rotated="@(!chart.IsHistorical)"
                                         FixedAxisMaximum="@(chart.Code is "soil-moisture" or "mites-beneficials" ? 5d : chart.Code == "leaf-disease" ? 100d : (double?)null)"
                                         PercentageAxis="@(chart.Code == "leaf-disease")" />
                    @if (chart.Code == "soil-moisture")
                    {
                        <ReportScaleKey Title="Soil moisture scale" Items="@SoilMoistureKey" />
                    }
                </section>
            }
            </div>
        }
        </div>

        @if (_report.RustThrips is { Rows.Count: > 0, Dates.Count: > 0 })
        {
            @foreach (var dateIndexes in Enumerable.Range(0, _report.RustThrips.Dates.Count).Chunk(20))
            {
            var rustThripsTitle = $"rust-thrips-history-title-{dateIndexes[0]}";
            <section class="report-panel summary-panel wide-print-section" aria-labelledby="@rustThripsTitle">
                <img class="section-brand-logo print-only" src="@SelectedBrand.LogoPath" alt="@SelectedBrand.AltText" />
                <div class="section-heading">
                    <span class="section-kicker">Survey history</span>
                    <h2 id="@rustThripsTitle">Rust thrips history@(dateIndexes[0] > 0 ? " (continued)" : "")</h2>
                    <p class="rust-thrips-legend">
                        <span class="rust-thrips-key rust-thrips-present">P</span> Present on pseudostem
                        <span class="rust-thrips-key rust-thrips-marks">M</span> Feeding marks
                    </p>
                </div>
                <div class="summary-scroll">
                    <table class="summary-table rust-thrips-table" style="--rust-columns: @dateIndexes.Length">
                        <thead>
                            <tr>
                                <th scope="col">Block</th>
                                @foreach (var index in dateIndexes)
                                {
                                    var date = _report.RustThrips.Dates[index];
                                    <th scope="col"><span class="summary-header-text">@date.ToString("dd/MM/yy")</span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _report.RustThrips.Rows)
                            {
                                <tr>
                                    <th scope="row">@row.BlockName</th>
                                    @foreach (var index in dateIndexes)
                                    {
                                        <td class="@RustThripsCssClass(row, index)">@RustThripsValue(row, index)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            }
        }

        @RenderTables(false)

        @if (_report.Actions.Count > 0 && ChecklistBlocks.Count > 0)
        {
            <section class="report-panel operational-section action-checklist-section print-only" aria-labelledby="banana-action-checklist-title">
                <div class="operational-heading">
                    <div>
                        <span class="section-kicker">Work instructions</span>
                        <h2 id="banana-action-checklist-title">Action checklist</h2>
                    </div>
                    <img class="handout-brand-logo" src="@SelectedBrand.LogoPath" alt="@SelectedBrand.AltText" />
                </div>
                <div class="action-checklist-scroll">
                    <table class="action-checklist-table">
                        <thead>
                            <tr>
                                <th class="checklist-date">Date</th>
                                <th class="checklist-action">Action</th>
                                @foreach (var block in ChecklistBlocks)
                                {
                                    <th class="checklist-block"><span>@block</span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var action in _report.Actions)
                            {
                                <tr>
                                    <td>@ActionDateText(action)</td>
                                    <td><strong>@ActionGroupTitle(action.ActionGroupName)</strong><span>@action.Recommendation</span></td>
                                    @foreach (var block in ChecklistBlocks)
                                    {
                                        var applies = ActionAppliesToBlock(action, block);
                                        <td class="@(applies ? "checklist-target" : "checklist-not-applicable")">@(applies ? "☐" : string.Empty)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="checklist-note">Tick each applicable block when the work has been completed.</p>
            </section>
        }

        @RenderTables(true)

        @if (_report.Photos.Count > 0)
        {
            <section class="report-panel photo-section" aria-labelledby="banana-photos-title">
                <img class="section-brand-logo print-only" src="@SelectedBrand.LogoPath" alt="@SelectedBrand.AltText" />
                <div class="section-heading">
                    <span class="section-kicker">Field images</span>
                    <h2 id="banana-photos-title">Survey photos</h2>
                    <p>Select an image to open the full-size version from the Total Grower Services image library.</p>
                </div>
                <div class="photo-grid">
                    @foreach (var photo in _report.Photos.OrderBy(photo => photo.DisplayOrder))
                    {
                        <figure>
                            <a class="photo-link" href="@photo.Url" target="_blank" rel="noopener noreferrer">
                                <img src="@photo.Url" alt="@PhotoHeading(photo)" loading="lazy" />
                                <span class="photo-open-cue no-print">Open full size</span>
                            </a>
                            <figcaption>
                                <strong>@PhotoHeading(photo)</strong>
                                @if (!string.IsNullOrWhiteSpace(photo.Comments))
                                {
                                    <span>@photo.Comments</span>
                                }
                            </figcaption>
                        </figure>
                    }
                </div>
            </section>
        }

        <SurveyReportFooter Brand="@SelectedBrand" PropertyName="@_report.PropertyName"
                            SurveyDate="@_report.SurveyDate"
                            AgronomistName="@_report.AgronomistName" AgronomistPhone="@_report.AgronomistPhone"
                            Reference="@_report.SurveyReference" />
    }
</div>

@code {
    private RenderFragment RenderTables(bool optional) => @<text>
        @foreach (var table in (_report?.Tables ?? []).Where(table => (table.Code != "pest-summary") == optional).OrderBy(table => table.Code switch { "bwb" => 0, "soil-health" => 1, "nematode" => 2, _ => 3 }))
        {
            var tableId = $"banana-table-{table.Code}";
            <section class="report-panel summary-panel wide-print-section" aria-labelledby="@tableId">
                <img class="section-brand-logo print-only" src="@SelectedBrand.LogoPath" alt="@SelectedBrand.AltText" />
                <div class="section-heading">
                    <span class="section-kicker">Current survey</span>
                    <h2 id="@tableId">@table.Title</h2>
                    @if (table.Code != "pest-summary" && !string.IsNullOrWhiteSpace(table.Description))
                    {
                        <p>@table.Description</p>
                    }
                </div>
                @if (table.Code == "pest-summary")
                {
                    <p class="summary-note">Current survey averages by block, with the whole-farm result shown last.</p>
                    <ReportScaleKey Title="Rating key" Items="@PestSummaryKey" />
                }
                <div class="summary-scroll">
                    <table class="summary-table @(string.Equals(table.Code, "pest-summary", StringComparison.OrdinalIgnoreCase) ? "pest-summary-table" : string.Empty)">
                        <thead>
                            <tr>
                                <th scope="col">Block</th>
                                @foreach (var column in table.Columns)
                                {
                                    <th scope="col">
                                        <span class="summary-header-text">
                                            <span>@column.Label</span>
                                            @if (!string.IsNullOrWhiteSpace(column.ScaleText))
                                            {
                                                <small>@column.ScaleText</small>
                                            }
                                        </span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in table.Rows)
                            {
                                <tr class="@(row.IsFarmAverage ? "farm-average" : string.Empty)">
                                    <th scope="row">@row.Label</th>
                                    @foreach (var column in table.Columns)
                                    {
                                        <td>@ReportChartLayout.BananaValue(TableValue(row, column.Code), column.Code)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

    </text>;

    [Parameter] public int SurveyId { get; set; }
    [Parameter] public BananaOnlineReportDto? Report { get; set; }
    [Parameter] public bool Shared { get; set; }
    [SupplyParameterFromQuery(Name = "print")] public bool Print { get; set; }

    private BananaOnlineReportDto? _report;
    private bool _loading;
    private bool _printInvoked;
    private bool _includePhotosForPrint;
    // Shared reports receive the creator preference from the validated share response.
    [Parameter] public string? SharedBrandKey { get; set; }
    private string _reportBrandKey = ReportBranding.MetagenKey;
    private string? _errorMessage;

    private ReportBrandOption SelectedBrand => ReportBranding.Get(_reportBrandKey);
    private sealed record BananaCurrentChartPoint(string SeriesName, string Category, double Value);
    private sealed record BananaHistoryChartPoint(string SeriesName, DateTime Date, double Value);
    private static readonly (string Label, string Description)[] SoilMoistureKey =
        [("0", "No moisture"), ("1", "Dry"), ("2", "Slightly dry"), ("3", "Optimum"), ("4", "Wet"), ("5", "Too wet")];
    private static readonly (string Label, string Description)[] PestSummaryKey =
        [("0 low - 5 high", "Stem, mite and disease ratings"), ("0 low - 3 high", "Bunch-pest ratings")];

    private IEnumerable<BananaReportChartDto[]> ChartPairs =>
        _report is null ? [] : _report.Charts.OrderBy(chart => chart.Code switch { "leaf-emergence-rate" => 0, "sigatoka-lesions" => 1, "mites-beneficials" => 2, "leaf-disease" => 3, "finger-count" => 4, "soil-moisture" => 5, _ => 6 }).Chunk(2);

    private IReadOnlyList<string> ChecklistBlocks
    {
        get
        {
            var summaryBlocks = _report?.Tables
                .FirstOrDefault(table => string.Equals(table.Code, "pest-summary", StringComparison.OrdinalIgnoreCase))?
                .Rows
                .Where(row => !row.IsFarmAverage && !string.IsNullOrWhiteSpace(row.Label))
                .Select(row => row.Label.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ?? [];

            if (summaryBlocks.Count > 0) return summaryBlocks;

            return _report?.Actions
                .SelectMany(action => action.Blocks.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(block => block)
                .ToList() ?? [];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _report = null;
        _errorMessage = null;
        _printInvoked = false;
        _includePhotosForPrint = false;
        _reportBrandKey = ReportBranding.MetagenKey;

        try
        {
            // Load before rendering or automatic printing to avoid a flash of the wrong brand.
            _reportBrandKey = Shared ? ReportBranding.Get(SharedBrandKey).Key : await _reportPreferences.GetAsync();
            if (Report is not null)
            {
                _report = Report;
                return;
            }

            _report = await TgsApi.GetBananaOnlineReport(SurveyId);
            if (_report is null) _errorMessage = TgsApi.ErrorMessage ?? "No report data was found for this survey.";
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Print && _report is not null && !_printInvoked)
        {
            _printInvoked = true;
            await PrintReportAsync();
        }
    }

    private void BackToSurveys() => Navigation.NavigateTo("/surveys/banana");
    private void EditSurvey() => Navigation.NavigateTo($"/surveys/banana/{SurveyId}/edit");
    private void ManagePhotos() => Navigation.NavigateTo($"/surveys/banana/{SurveyId}/photos");

    private async Task PrintReportAsync()
    {
        if (_report is null) return;
        var fileName = BananaReportFileName.Build(_report.PropertyName, _report.PropertyId, _report.SurveyDate);
        await JavaScript.InvokeVoidAsync("metaGrowReportPrinting.print", fileName, Print ? 1500 : 0);
    }

    private static double? TableValue(BananaReportTableRowDto row, string code) =>
        row.Values.FirstOrDefault(value => string.Equals(value.Code, code, StringComparison.OrdinalIgnoreCase))?.Value;

    private static string FormatValue(double? value) => value?.ToString("0.##") ?? "—";
    private static string RustThripsValue(BananaRustThripsRowDto row, int index) =>
        index < row.Values.Count && !string.IsNullOrWhiteSpace(row.Values[index]) ? row.Values[index] : "—";

    private static string RustThripsCssClass(BananaRustThripsRowDto row, int index) =>
        RustThripsValue(row, index).Trim().ToUpperInvariant() switch
        {
            "P" => "rust-thrips-status rust-thrips-present",
            "M" => "rust-thrips-status rust-thrips-marks",
            _ => string.Empty
        };

    private static List<BananaCurrentChartPoint> CurrentChartPoints(BananaReportChartDto chart) =>
        chart.Series.SelectMany(series => series.Points
            .Where(point => !string.IsNullOrWhiteSpace(point.Category) && point.Value.HasValue)
            .Select(point => new BananaCurrentChartPoint(series.Name, point.Category!, point.Value!.Value)))
            .ToList();

    private static List<BananaHistoryChartPoint> HistoricalChartPoints(BananaReportChartDto chart) =>
        chart.Series.SelectMany(series => series.Points
            .Where(point => point.Date.HasValue && point.Value.HasValue)
            .Select(point => new BananaHistoryChartPoint(series.Name, point.Date!.Value, point.Value!.Value)))
            .ToList();

    private static MultiCropReportSectionDto AsPrintSection(BananaReportChartDto chart)
    {
        var categories = chart.Series
            .SelectMany(series => series.Points)
            .Where(point => !string.IsNullOrWhiteSpace(point.Category))
            .Select(point => point.Category!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return new MultiCropReportSectionDto
        {
            Code = chart.Code,
            Title = chart.Title,
            IsHistorical = chart.IsHistorical,
            Metrics = categories.Select((category, index) => new MultiCropReportMetricDefinitionDto
            {
                MetricCode = category,
                MetricLabel = category,
                SortOrder = index
            }).ToList(),
            Series = chart.Series.Select(series => new MultiCropReportSeriesDto
            {
                Name = series.Name,
                Points = series.Points.Select(point => new MultiCropReportPointDto
                {
                    MetricCode = point.Category ?? string.Empty,
                    MetricLabel = point.Category ?? string.Empty,
                    Date = point.Date,
                    Value = point.Value
                }).ToList()
            }).ToList()
        };
    }

    private static string ActionGroupTitle(string name) =>
        name.Contains("spray", StringComparison.OrdinalIgnoreCase) ? "Spray recommendations" : name;

    private static string ActionDateText(BananaReportActionDto action) =>
        action.ActionDate?.ToString("dd/MM/yyyy") ?? "—";

    private static bool ActionAppliesToBlock(BananaReportActionDto action, string block) =>
        action.Blocks.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Any(value => string.Equals(value, block, StringComparison.OrdinalIgnoreCase));

    private static string PhotoHeading(BananaReportPhotoDto photo)
    {
        if (!string.IsNullOrWhiteSpace(photo.BlockName) && photo.PlantNo.HasValue)
            return $"{photo.BlockName}, plant {photo.PlantNo}";
        if (!string.IsNullOrWhiteSpace(photo.BlockName)) return photo.BlockName;
        return photo.PlantNo.HasValue ? $"Plant {photo.PlantNo}" : "Survey photo";
    }
}
