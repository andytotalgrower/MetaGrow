@page "/surveys/samples/generate-from-csv"
@using ApiModels
@using ApiModels.MetaGrow
@using MetaGrow.Web.Services
@using Metagen.Shared.Services
@attribute [Authorize(Roles = MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager + "," + MetaGrowRoles.Agronomist)]
@inject ITgsApiService TgsApi
@inject ApiTokenService ApiTokens
@inject AccountApiClient AccountApi
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IToastNotificationService ToastService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Generate Sample surveys from CSV | MetaGrow</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(PendingFiles.Count > 0 || _uploading || _committing)" OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<DxToastProvider Name="SampleSurveyGenerationMessages" MaxToastCount="3"
                 AnimationType="ToastAnimationType.Slide"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 StickToViewport="true" DisplayTime="TimeSpan.FromSeconds(10)" Width="410px" />

<div class="generation-page">
    <div class="generation-toolbar">
        <DxButton Text="Back to Sample surveys" RenderStyle="ButtonRenderStyle.Secondary" Click="BackToSamples" />
    </div>

    <header class="generation-hero">
        <div>
            <span class="generation-kicker">Returned laboratory data</span>
            <h1>Generate Sample surveys from CSV</h1>
            <p>Create the surveys, collected samples and linked @ResultTypeName results from returned laboratory files. Each file is imported independently.</p>
        </div>
        <div class="hero-safety">
            <span>Preview first</span>
            <strong>Then move on to final generation</strong>
        </div>
    </header>

    <SampleAreaNavigation ActivePage="generate" ShowGuide="@(_files.Count == 0)" GuideRequested="@(() => _importGuideRequest++)" />

    @if (_loading)
    {
        <div class="generation-loading"><DxWaitIndicator Visible="true" /><span>Loading properties and agronomists…</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger" role="alert">@_loadError</div>
    }
    else
    {
        <SampleImportGuideTarget Destination="generate" Label="Create a sample survey from CSV" RequestVersion="_importGuideRequest"
                                 Instruction="Start by choosing the farm, agronomist and Sample Type below. Then select your CSV files to preview the surveys and results.">
        <section class="setup-card" aria-labelledby="generation-setup-heading">
            <div class="section-heading">
                <span class="step-number">1</span>
                <div>
                    <h2 id="generation-setup-heading">Choose the destination</h2>
                    <p>The selected farm, agronomist and Sample Type will be used for every file in this queue. Clear the queue to change the destination.</p>
                </div>
            </div>
            <div class="setup-grid">
                <div class="field property-field">
                    <label for="generation-property">Farm</label>
                    <DxComboBox Id="generation-property" Data="@_properties" @bind-Value="_propertyId" @bind-Value:after="PropertyChangedAsync"
                                TextFieldName="@nameof(Property.PropertyName)" ValueFieldName="@nameof(Property.PropertyId)"
                                NullText="Search for a farm" SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" AllowUserInput="false"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" Enabled="@(!_uploading && !_committing && _files.Count == 0)" />
                </div>
                <div class="field">
                    <label for="generation-agronomist">Agronomist</label>
                    <DxComboBox Id="generation-agronomist" Data="@_agronomists" @bind-Value="_agronomistId" @bind-Value:after="SelectionChanged"
                                TextFieldName="@nameof(Staff.StaffName)" ValueFieldName="@nameof(Staff.StaffId)"
                                NullText="Select an agronomist" SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" AllowUserInput="false"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" Enabled="@(!_uploading && !_committing && _files.Count == 0)" />
                </div>
                <div class="field">
                    <label for="generation-result-type">Sample Type</label>
                    <DxComboBox Id="generation-result-type" Data="@ResultTypeOptions" @bind-Value="_resultTypeId" @bind-Value:after="SelectionChanged"
                                TextFieldName="@nameof(ResultTypeOption.Name)" ValueFieldName="@nameof(ResultTypeOption.Id)"
                                AllowUserInput="false" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                Enabled="@(!_uploading && !_committing && _files.Count == 0)" />
                </div>
            </div>

            <div id="generation-csv-drop-zone" class="csv-drop-zone @(_uploading ? "busy" : string.Empty) @(!CanUpload ? "disabled" : string.Empty)">
                <span class="drop-icon" aria-hidden="true">⇧</span>
                <strong>Drag and drop returned @ResultTypeName CSV files here</strong>
                <span>@(CanUpload ? "or select several files from your device" : _files.Count >= SampleGenerationBatchRules.MaxFiles ? "The queue is full — remove files or start a new queue" : Busy ? "Please wait for the current operation" : "Select a farm, agronomist and Sample Type first")</span>
                <DxButton Id="generationCsvSelectButton" Text="@(_uploading ? "Reading CSVs…" : "Select CSV files")"
                          RenderStyle="ButtonRenderStyle.Primary" Enabled="@(CanUpload && !_uploading && !_committing)" />
                @if (_uploading) { <DxWaitIndicator Visible="true" /> }
                <small>@ResultTypeName CSV · up to 10 files · maximum 20 MB each · nothing is written during preview</small>
            </div>
            <DxFileInput @ref="_fileInput"
                         ExternalDropZoneCssSelector="#generation-csv-drop-zone"
                         ExternalSelectButtonCssSelector="button#generationCsvSelectButton"
                         ExternalDropZoneDragOverCssClass="drop-zone-active"
                         MaxFileSize="@MaxFileBytes" MaxFileCount="@SampleGenerationBatchRules.MaxFiles"
                         FilesUploading="PreviewFilesAsync"
                         AcceptedFileTypes="@AcceptedFileTypes"
                         AllowMultiFileUpload="true" />
        </section>

        </SampleImportGuideTarget>


        @if (_files.Count > 0)
        {
            <section class="queue-card" aria-labelledby="file-queue-heading">
                <div class="section-heading split">
                    <div><h2 id="file-queue-heading">Results to import</h2><p>Review each file. Files are never merged; successful imports remain saved if another file fails.</p></div>
                    <DxButton Text="Clear queue" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(!Busy && !_files.Any(file => file.OutcomeUnknown))" Click="ResetAll" />
                </div>
                <div class="file-queue" aria-live="polite">
                    @foreach (var file in _files)
                    {
                        <article @key="file.Id" class="queue-file @(ReferenceEquals(file, _active) ? "selected" : string.Empty)">
                            <button type="button" class="file-review-button" disabled="@Busy" @onclick="@(() => _active = file)" aria-pressed="@ReferenceEquals(file, _active)">
                                <strong>@file.FileName</strong>
                                <span>@file.Status</span>
                                @if (file.Preview is not null)
                                {
                                    <small>@file.Preview.LabName · @file.Preview.Rows.Count results · @file.Preview.SurveyGroups.Count surveys</small>
                                    <small>@string.Join(", ", file.Preview.SurveyGroups.Select(group => group.SurveyDate.ToString("dd MMM yyyy")))</small>
                                }
                            </button>
                            <div class="queue-file-actions">
                                @if (file.OutcomeUnknown)
                                {
                                    <DxButton Text="Check import status" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!Busy)" Click="@(() => CheckOutcomeAsync(file))" />
                                }
                                else if (file.Receipt is null)
                                {
                                    @if (file.Preview is not null)
                                    {
                                        <DxButton Text="Refresh preview" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(!Busy)" Click="@(() => RefreshFileAsync(file))"
                                                  title="Recheck the uploaded CSV using the latest lab mappings and existing surveys. No data is imported. Upload again if you changed the CSV on your device." />
                                    }
                                    <DxButton Text="Remove" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(!Busy)" Click="@(() => RemoveFile(file))" />
                                }
                            </div>
                            @if (file.Error is not null) { <p class="queue-error" role="alert">@file.Error</p> }
                            @if (file.Receipt is not null)
                            {
                                <div class="queue-receipts">
                                    @foreach (var survey in file.Receipt.Surveys)
                                    {
                                        <a href="@SurveyUrl(survey.SurveyId)" target="_blank" rel="noopener">Survey @survey.SurveyId · @survey.SurveyDate.ToString("dd MMM yyyy")</a>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
                @if (BatchErrors.Count > 0)
                {
                    <div class="review-message danger" role="alert"><strong>Resolve these file conflicts</strong><ul>@foreach (var error in BatchErrors) { <li>@error</li> }</ul></div>
                }
                @if (_batchErrors.Count > 0)
                {
                    <div class="review-message danger" role="alert"><strong>Server checks</strong><ul>@foreach (var error in _batchErrors) { <li>@error</li> }</ul></div>
                }
                <div class="commit-bar">
                    <div><strong>@PendingFiles.Count files · @PendingSurveyCount surveys · @PendingResultCount results remaining</strong>
                        <span>@_files.Count(file => file.Receipt is not null) files imported. Each file succeeds or rolls back independently.</span></div>
                    <DxButton Text="@(_committing ? "Importing…" : "Create Survey & Import Data")" RenderStyle="ButtonRenderStyle.Primary" Enabled="@CanCommit" Click="OpenConfirmation" />
                </div>
            </section>
        }

        @if (_receipt is not null)
    {
        <section class="receipt-card" aria-labelledby="generation-receipt-heading">
            <div class="receipt-icon">✓</div>
            <div class="receipt-copy">
                <span class="generation-kicker">Generation complete</span>
                <h2 id="generation-receipt-heading">@_receipt.Surveys.Count Sample survey@(_receipt.Surveys.Count == 1 ? string.Empty : "s") created</h2>
                <p>@_receipt.ImportedRowCount @_receipt.ResultTypeName results from @_receipt.FileName · @_receipt.PropertyName</p>
                <small>@_receipt.ImportedUtc.ToLocalTime().ToString("dd MMM yyyy h:mm tt") by @_receipt.ImportedBy</small>
            </div>
            <div class="generated-surveys">
                @foreach (var survey in _receipt.Surveys.OrderBy(item => item.SurveyDate))
                {
                    <a href="@SurveyUrl(survey.SurveyId)" target="_blank" rel="noopener">
                        Survey @survey.SurveyId <span>@survey.SurveyDate.ToString("dd MMM yyyy") · @survey.ImportedRowCount result@(survey.ImportedRowCount == 1 ? string.Empty : "s")</span>
                    </a>
                }

            </div>
        </section>
    }

        @if (_preview is not null && _receipt is null)
        {
            <section @key="_active.Id" class="preview-card" aria-labelledby="generation-preview-heading">
                <div class="section-heading split">
                    <div>
                        <span class="step-number">2</span>
                        <div><h2 id="generation-preview-heading">Review what will be created</h2><p>Check the survey dates, destination blocks and test types before continuing.</p></div>
                    </div>
                    <div class="preview-file"><strong>@_preview.FileName</strong><span>@_preview.Rows.Count returned results</span></div>
                </div>

                <div class="preview-facts">
                    <div><span>Farm</span><strong>@_preview.PropertyName</strong></div>
                    <div><span>Agronomist</span><strong>@_preview.AgronomistName</strong></div>
                    <div><span>Detected laboratory</span><strong>@_preview.LabName</strong></div>
                    <div><span>Surveys to create</span><strong>@_preview.SurveyGroups.Count</strong></div>
                </div>

                @if (_preview.BlockingErrors.Count > 0)
                {
                    <div class="review-message danger" role="alert">
                        <strong>Generation blocked</strong>
                        <ul>@foreach (var error in _preview.BlockingErrors) { <li>@error</li> }</ul>
                    </div>
                }
                @if (_preview.Warnings.Count > 0)
                {
                    <div class="review-message warning">
                        <strong>Review these warnings</strong>
                        <ul>@foreach (var warning in _preview.Warnings) { <li>@warning</li> }</ul>
                    </div>
                }

                <div class="property-match-heading"><h3>Farm name check</h3><p>The grower name returned by the laboratory is compared with the selected MetaGrow farm.</p></div>
                <div class="property-match-list">
                    @foreach (var match in _preview.PropertyMatches)
                    {
                        <div class="property-match-row @(!match.IsCloseMatch ? "needs-override" : string.Empty)">
                            <div><span>Farm/Grower (in file)</span><strong>@(string.IsNullOrWhiteSpace(match.LabPropertyName) ? "(blank)" : match.LabPropertyName)</strong></div>
                            <span class="property-match-arrow" aria-hidden="true">→</span>
                            <div><span>Selected Farm/Grower</span><strong>@match.SelectedPropertyName</strong></div>
                            <span class="property-match-badge @(match.IsCloseMatch ? "matched" : "unmatched")">
                                @(match.IsExactMatch ? "Exact match" : match.IsCloseMatch ? $"Close match · {match.SimilarityPercent}%" : $"Override required · {match.SimilarityPercent}%")
                            </span>
                        </div>
                    }
                </div>
                @if (_preview.PropertyNameOverrideRequired)
                {
                    <div class="property-override" role="group" aria-label="Farm name override confirmation">
                        <DxCheckBox @bind-Checked="_propertyOverrideAccepted" Enabled="@(!Busy)">
                            I have checked the Lab Farm/Grower name and confirm these results belong to @_preview.PropertyName.
                        </DxCheckBox>
                        <small>This confirmation is required because at least one laboratory name is not a close match.</small>
                    </div>
                }

                <div class="survey-date-heading"><h3>Surveys from this file</h3><p>Rows are grouped by the laboratory received date.</p></div>
                <div class="survey-date-list">
                    @foreach (var group in _preview.SurveyGroups)
                    {
                        <article class="survey-date-card @(group.ExistingSurveyIds.Count > 0 ? "has-existing" : string.Empty)">
                            <div><span>Survey date</span><strong>@group.SurveyDate.ToString("dd MMMM yyyy")</strong></div>
                            <div><span>@ResultTypeName results</span><strong>@group.ResultCount</strong></div>
                            @if (group.ExistingSurveyIds.Count > 0)
                            {
                                <div class="existing-surveys"><span>Existing on this date</span><strong>@string.Join(", ", group.ExistingSurveyIds.Select(id => $"#{id}"))</strong></div>
                            }
                            else
                            {
                                <span class="ready-badge">New survey</span>
                            }
                        </article>
                    }
                </div>

                <SampleImportColumnReview Review="_preview.ColumnReview" DraftSelections="_active.ColumnSelections" Busy="@(Busy || _active.OutcomeUnknown)" Applied="ReviewColumnsAsync" />
                @if (HasDuplicateBlocks)
                {
                    <div class="review-message danger" role="alert">Duplicate blocks found. Select a different property block for each result row.</div>
                }
                <div class="mapping-heading"><h3>Block and test reconciliation</h3><p>Select one distinct property block per result row. Saved lab block mappings are preselected; other blocks require your selection.</p></div>
                <div class="mapping-list">
                    @foreach (var mapping in _mappingRows)
                    {
                        <div class="mapping-row">
                            <div class="raw-block">
                                <span>Block name in file</span>
                                <strong>@(string.IsNullOrWhiteSpace(mapping.RawBlockName) ? "(blank)" : mapping.RawBlockName)</strong>
                                <small>@mapping.RowLabel</small>
                            </div>
                            <span class="mapping-arrow" aria-hidden="true">→</span>
                            <div class="mapping-choice">
                                <label for="@mapping.BlockControlId">Block</label>
                                <DxComboBox Id="@mapping.BlockControlId" Data="@AvailableBlockChoices" @bind-Value="mapping.BlockKey"
                                            TextFieldName="@nameof(BlockChoice.Label)" ValueFieldName="@nameof(BlockChoice.Key)"
                                            NullText="Select a block" SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" AllowUserInput="false"
                                            Enabled="@(!Busy && !_active.OutcomeUnknown)" />
                                @if (mapping.BlockWasSuggested && !string.IsNullOrWhiteSpace(mapping.BlockKey)) { <small class="suggestion">Suggested — please check</small> }
                            </div>
                            <div class="mapping-choice test-choice">
                                <label for="@mapping.TestControlId">Test type</label>
                                <DxComboBox Id="@mapping.TestControlId" Data="@_testTypeChoices" @bind-Value="mapping.LabTestTypeId"
                                            TextFieldName="@nameof(TestTypeChoice.Label)" ValueFieldName="@nameof(TestTypeChoice.Id)"
                                            NullText="Select a test type" SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" AllowUserInput="false"
                                            Enabled="@(!Busy && !_active.OutcomeUnknown)" />
                            </div>
                        </div>
                    }
                </div>

                <div class="result-heading"><h3>Returned result rows</h3><p>These rows will become collected sample items and linked @ResultTypeName results.</p></div>
                <div class="result-grid-wrap">
                    <DxGrid Data="@_preview.Rows" PageSize="20" HighlightRowOnHover="true" TextWrapEnabled="false"
                            ColumnResizeMode="GridColumnResizeMode.NextColumn" CssClass="generation-preview-grid">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(SampleSoilSurveyGenerationRowDto.RowNumber)" Caption="CSV row" Width="82px" />
                            <DxGridDataColumn FieldName="@nameof(SampleSoilSurveyGenerationRowDto.OrderNo)" Caption="Sample ref." Width="115px" />
                            <DxGridDataColumn FieldName="@nameof(SampleSoilSurveyGenerationRowDto.DateReceived)" Caption="Received" Width="112px" DisplayFormat="dd/MM/yyyy" />
                            <DxGridDataColumn FieldName="@nameof(SampleSoilSurveyGenerationRowDto.RawPropertyName)" Caption="Lab Grower" MinWidth="150" />
                            <DxGridDataColumn FieldName="@nameof(SampleSoilSurveyGenerationRowDto.RawBlockName)" Caption="Block name in file" MinWidth="150" />
                            <DxGridDataColumn FieldName="@nameof(SampleSoilSurveyGenerationRowDto.RawCropName)" Caption="Lab crop" MinWidth="120" />
                            <DxGridDataColumn Caption="Checks" MinWidth="145" AllowSort="false">
                                <CellDisplayTemplate Context="cell">
                                    @{ var row = (SampleSoilSurveyGenerationRowDto)cell.DataItem; }
                                    @if (row.Warnings.Count == 0) { <span class="row-ok">Ready</span> }
                                    else { <span class="row-warning">@string.Join(" ", row.Warnings)</span> }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>
                    </DxGrid>
                </div>

                <p class="file-review-hint">@CommitReadinessText · Use “Create Survey &amp; Import Data” above after reviewing the queue.</p>
            </section>
        }
    }
</div>

<DxPopup @bind-Visible="_confirmVisible" ShowFooter="true" HeaderText="Confirm survey creation and data import"
         AllowDrag="true" ShowCloseButton="@(!_committing)" CloseOnEscape="@(!_committing)"
         Width="min(650px, 94vw)" CloseOnOutsideClick="@(!_committing)">
    <BodyContentTemplate>
        <div class="confirm-content">
            <p>Create <strong>@PendingSurveyCount surveys</strong> and import <strong>@PendingResultCount @ResultTypeName results</strong> from <strong>@PendingFiles.Count files</strong>?</p>
            <p>Farm: <strong>@_properties.FirstOrDefault(property => property.PropertyId == _propertyId)?.PropertyName</strong>.
                Agronomist: <strong>@_agronomists.FirstOrDefault(staff => staff.StaffId == _agronomistId)?.StaffName</strong>.</p>
            <p>Files are processed one at a time. A failed file rolls back completely; successful files remain imported. Retry only the remaining files.</p>
            @if (PendingFiles.Any(file => file.Preview!.SurveyGroups.Any(group => group.ExistingSurveyIds.Count > 0)))
            {
                <p>Some dates already have surveys. Separate surveys will be created; existing surveys will not be changed.</p>
            }
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate Context="footerContext">
        <div class="popup-actions">
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(!_committing)" Click="CloseConfirmation" />
            <DxButton RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!_committing)" Click="CommitAsync">
                @if (_committing)
                {
                    <span class="button-progress"><DxWaitIndicator Visible="true" /> Importing…</span>
                }
                else
                {
                    <span>Create Survey &amp; Import Data</span>
                }
            </DxButton>
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    private int _importGuideRequest;
    private const int MaxFileBytes = 20 * 1024 * 1024;
    private static readonly List<string> AcceptedFileTypes = [".csv"];
    private static readonly List<ResultTypeOption> ResultTypeOptions =
    [
        new(SampleLaboratoryResultType.Soil, "Soil"),
        new(SampleLaboratoryResultType.Tissue, "Tissue")
    ];
    private DxFileInput? _fileInput;
    private List<Property> _properties = [];
    private List<Staff> _agronomists = [];
    private List<BlockChoice> _blockChoices = [];
    private readonly List<SampleGenerationQueueEntry> _files = [];
    private SampleGenerationQueueEntry _active = new();
    private List<string> _batchErrors = [];
    private SampleSoilSurveyGenerationPreviewDto? _preview => _active.Preview;
    private SampleSoilSurveyGenerationReceiptDto? _receipt => _active.Receipt;
    private List<SampleGenerationMappingRow> _mappingRows => _active.Mappings;
    private IReadOnlyList<TestTypeChoice> _testTypeChoices => _preview?.LabTestTypes
        .Select(test => new TestTypeChoice(test.LabTestTypeId, TestTypeLabel(test))).OrderBy(test => test.Label).ToList() ?? [];
    private bool _propertyOverrideAccepted { get => _active.PropertyOverrideAccepted; set => _active.PropertyOverrideAccepted = value; }
    private int _propertyId;
    private int _agronomistId;
    private int _resultTypeId = SampleLaboratoryResultType.Soil;
    private bool _loading = true;
    private bool _uploading;
    private bool _committing;
    private bool _confirmVisible;
    private string? _loadError;
    private bool Busy => _loading || _uploading || _committing;
    private string ResultTypeName => SampleLaboratoryResultType.Name(_resultTypeId);
    private IReadOnlyList<BlockChoice> AvailableBlockChoices => _blockChoices;
    private bool HasDuplicateBlocks => _active.HasDuplicateBlocks;
    private bool CanUpload => _propertyId > 0 && _agronomistId > 0 && _files.Count < SampleGenerationBatchRules.MaxFiles &&
        SampleLaboratoryResultType.IsImportSupported(_resultTypeId) && !Busy;
    private List<SampleGenerationQueueEntry> PendingFiles => _files.Where(file => file.Receipt is null).ToList();
    private int PendingSurveyCount => PendingFiles.Sum(file => file.Preview?.SurveyGroups.Count ?? 0);
    private int PendingResultCount => PendingFiles.Sum(file => file.Preview?.Rows.Count ?? 0);
    private List<string> BatchErrors => _files.Any(file => file.Preview is not null)
        ? SampleGenerationBatchRules.Validate(_files.Where(file => file.Preview is not null).Select(file => file.Preview!).ToList()) : [];
    private bool CanCommit => !Busy && PendingFiles.Count > 0 && PendingFiles.All(file => file.IsReady) && BatchErrors.Count == 0;
    private string CommitReadinessText => _active.IsReady ? "This file is ready"
        : HasDuplicateBlocks ? "Select a different block for each result row"
        : "Complete this file's checks, block selections and test types";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var propertiesTask = TgsApi.GetProperties();
            var staffTask = TgsApi.GetActiveTgsStaff();
            await Task.WhenAll(propertiesTask, staffTask);
            _properties = (await propertiesTask ?? []).Where(item => item.IsActive).OrderBy(item => item.PropertyName).ToList();
            _agronomists = (await staffTask ?? []).OrderBy(item => item.StaffName).ToList();
            await SelectCurrentAgronomistAsync();
        }
        catch (Exception exception)
        {
            _loadError = exception.Message;
        }
        finally { _loading = false; }
    }

    private async Task SelectCurrentAgronomistAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        var primaryEmail = user.Claims.FirstOrDefault(claim =>
                               claim.Type.EndsWith("emailaddress", StringComparison.OrdinalIgnoreCase) ||
                               claim.Type.Equals("email", StringComparison.OrdinalIgnoreCase))?.Value
                           ?? user.Identity?.Name;
        var accountEmails = new List<string>();
        if (!string.IsNullOrWhiteSpace(primaryEmail)) accountEmails.Add(primaryEmail.Trim());

        var (additionalEmails, _) = await AccountApi.GetEmailsAsync();
        accountEmails.AddRange(additionalEmails?
            .Where(address => address.IsConfirmed && !string.IsNullOrWhiteSpace(address.Email))
            .Select(address => address.Email.Trim()) ?? []);

        foreach (var email in accountEmails.Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var matchingStaff = _agronomists.FirstOrDefault(item =>
                !string.IsNullOrWhiteSpace(item.Email) &&
                string.Equals(item.Email.Trim(), email, StringComparison.OrdinalIgnoreCase));
            if (matchingStaff is null) continue;
            _agronomistId = matchingStaff.StaffId;
            return;
        }
    }

    private async Task PropertyChangedAsync()
    {
        ClearQueue();
        _blockChoices = [];
        if (_propertyId <= 0) return;
        try
        {
            var bananaTask = TgsApi.GetBananaBlocksForProperty(_propertyId);
            var multiCropTask = TgsApi.GetMultiCropBlocksForProperty(_propertyId);
            await Task.WhenAll(bananaTask, multiCropTask);
            var blocks = (await bananaTask ?? []).Concat(await multiCropTask ?? [])
                .GroupBy(block => $"{NormalizeBlockType(block.BlockType)}:{block.BlockId}", StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First());
            _blockChoices = blocks.Select(block => new BlockChoice(
                    $"{NormalizeBlockType(block.BlockType)}:{block.BlockId}",
                    $"{(NormalizeBlockType(block.BlockType) == "banana" ? "Banana" : "Multi-crop")} · {block.BlockName}{(block.IsActive ? string.Empty : " · inactive")}",
                    block))
                .OrderBy(choice => choice.Label).ToList();
        }
        catch (Exception exception)
        {
            ShowToast("Blocks could not be loaded", exception.Message, ToastRenderStyle.Danger);
        }
    }


    private void SelectionChanged() => ClearQueue();

    private async Task<string> AccessTokenAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var token = await ApiTokens.GetAccessTokenAsync(state.User);
        return !string.IsNullOrWhiteSpace(token) ? token : throw new InvalidOperationException("Sign in again before importing files.");
    }

    private async Task PreviewFilesAsync(FilesUploadingEventArgs args)
    {
        if (!CanUpload || args.Files.Count == 0) return;
        if (_files.Count + args.Files.Count > SampleGenerationBatchRules.MaxFiles)
        {
            ShowToast("Too many files", "The queue can contain up to 10 files. Remove files or start a new queue.", ToastRenderStyle.Warning);
            _fileInput?.RemoveAllFiles();
            return;
        }
        _uploading = true;
        _batchErrors = [];
        try
        {
            var token = await AccessTokenAsync();
            foreach (var file in args.Files)
            {
                var entry = new SampleGenerationQueueEntry { FileName = file.Name, Reading = true };
                _files.Add(entry);
                if (_files.Count == 1) _active = entry;
                await InvokeAsync(StateHasChanged);
                try
                {
                    if (!Path.GetExtension(file.Name).Equals(".csv", StringComparison.OrdinalIgnoreCase))
                        throw new InvalidOperationException("Choose a file with a .csv extension.");
                    await using var stream = file.OpenReadStream(MaxFileBytes, file.CancellationTokenSource.Token);
                    var preview = await TgsApi.PreviewSampleChemistrySurveyGeneration(_propertyId, _agronomistId, _resultTypeId,
                        stream, file.Name, file.Type, token);
                    if (preview is null) throw new InvalidOperationException(TgsApi.ErrorMessage ?? "The CSV could not be previewed.");
                    entry.ApplyPreview(preview);
                }
                catch (Exception exception) { entry.Error = $"{exception.Message} Remove this entry and upload the file again."; }
                finally { entry.Reading = false; }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception exception) { ShowToast("Upload failed", exception.Message, ToastRenderStyle.Danger); }
        finally
        {
            _fileInput?.RemoveAllFiles();
            _uploading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ReviewColumnsAsync(List<SampleImportColumnSelectionDto> columns) => RefreshFileAsync(_active, columns);

    private async Task RefreshFileAsync(SampleGenerationQueueEntry file, List<SampleImportColumnSelectionDto>? columns = null)
    {
        if (Busy || file.Preview is null || file.Receipt is not null || file.OutcomeUnknown) return;
        _uploading = true;
        file.Reading = true;
        _batchErrors = [];
        try
        {
            var token = await AccessTokenAsync();
            var preview = await TgsApi.ReviewSampleChemistryGenerationColumns(
                new SampleImportColumnReviewRequest { PreviewToken = file.Preview.PreviewToken, Columns = columns ?? [] }, token);
            if (preview is null) throw new InvalidOperationException(TgsApi.ErrorMessage ?? "The preview could not be refreshed.");
            file.ApplyPreview(preview);
        }
        catch (Exception exception) { file.Error = exception.Message; }
        finally { file.Reading = false; _uploading = false; }
    }

    private void RemoveFile(SampleGenerationQueueEntry file)
    {
        if (Busy || file.Receipt is not null || file.OutcomeUnknown) return;
        _files.Remove(file);
        if (ReferenceEquals(_active, file)) _active = _files.FirstOrDefault() ?? new();
        _batchErrors = [];
    }

    private void OpenConfirmation()
    {
        if (CanCommit) { _batchErrors = []; _confirmVisible = true; }
    }
    private void CloseConfirmation() { if (!_committing) _confirmVisible = false; }

    private async Task CommitAsync()
    {
        if (!CanCommit) return;
        _committing = true;
        _confirmVisible = false;
        _batchErrors = [];
        var pending = PendingFiles;
        try
        {
            var token = await AccessTokenAsync();
            for (var index = 0; index < pending.Count; index++)
            {
                // Revalidate remaining files after each transaction: shared Hortus definitions may have changed.
                var validation = await TgsApi.ValidateSampleGenerationBatch(new()
                {
                    Files = pending.Skip(index).Select(file => file.ToRequest()).ToList()
                }, token);
                if (validation is null || !validation.CanGenerate)
                {
                    _batchErrors = validation?.Errors ?? [TgsApi.ErrorMessage ?? "Batch validation failed. Nothing further was imported."];
                    break;
                }
                var file = pending[index];
                file.Importing = true;
                file.Error = null;
                await InvokeAsync(StateHasChanged);
                try
                {
                    file.Receipt = await TgsApi.CommitSampleChemistrySurveyGeneration(file.ToRequest(), token);
                    if (file.Receipt is null)
                    {
                        file.Error = TgsApi.ErrorMessage ?? "The import did not return a receipt.";
                        await RecoverOutcomeAsync(file, token);
                    }
                }
                catch (Exception exception)
                {
                    file.Error = exception.Message;
                    await RecoverOutcomeAsync(file, token);
                }
                finally { file.Importing = false; }
                await InvokeAsync(StateHasChanged);
                // Do not start another write while an interrupted request may still be completing.
                if (file.OutcomeUnknown) break;
            }
        }
        catch (Exception exception) { _batchErrors = [exception.Message]; }
        finally
        {
            _committing = false;
            ShowToast("Import queue", $"{_files.Count(file => file.Receipt is not null)} files imported; {PendingFiles.Count} remaining.",
                PendingFiles.Count == 0 ? ToastRenderStyle.Success : ToastRenderStyle.Warning);
        }
    }

    private async Task RecoverOutcomeAsync(SampleGenerationQueueEntry file, string token)
    {
        file.OutcomeUnknown = true;
        try
        {
            var status = await TgsApi.GetSampleGenerationStatus(new() { PreviewToken = file.Preview!.PreviewToken }, token);
            if (status is null)
            {
                file.Error = $"{file.Error} The outcome could not be verified. Check import status before retrying.";
                return;
            }
            file.Receipt = status.Receipt;
            if (file.Receipt is not null)
            {
                file.Receipt.PropertyName = file.Preview!.PropertyName;
                file.Receipt.AgronomistName = file.Preview.AgronomistName;
                file.Receipt.LabName = file.Preview.LabName;
            }
            file.OutcomeUnknown = false;
            file.Error = status.Imported ? null : $"{file.Error ?? "No completed import was found."} Review this file, then select Create Survey & Import Data to retry.";
        }
        catch { file.Error = "The import outcome could not be checked. Check import status before retrying."; }
    }

    private async Task CheckOutcomeAsync(SampleGenerationQueueEntry file)
    {
        if (Busy || !file.OutcomeUnknown) return;
        _uploading = true;
        try { await RecoverOutcomeAsync(file, await AccessTokenAsync()); }
        catch (Exception exception) { file.Error = exception.Message; }
        finally { _uploading = false; }
    }

    private void ClearQueue()
    {
        _files.Clear();
        _active = new();
        _batchErrors = [];
        _confirmVisible = false;
    }

    private void ResetAll()
    {
        if (Busy || _files.Any(file => file.OutcomeUnknown)) return;
        ClearQueue();
    }

    private void ShowToast(string title, string text, ToastRenderStyle style) => ToastService.ShowToast(new ToastOptions
    {
        ProviderName = "SampleSurveyGenerationMessages", Title = title, Text = text, RenderStyle = style, DisplayTime = TimeSpan.FromSeconds(10)
    });
    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (_uploading || _committing || _files.Any(file => file.OutcomeUnknown))
        {
            context.PreventNavigation();
            ShowToast("Import queue", "Wait for the current operation, or check the unknown import status, before leaving this page.", ToastRenderStyle.Warning);
            return;
        }
        if (PendingFiles.Count > 0 && !await JS.InvokeAsync<bool>("confirm",
            "Leave this page and discard the remaining file previews? Completed imports will stay saved."))
            context.PreventNavigation();
    }

    private void BackToSamples() => Navigation.NavigateTo("/surveys/samples");
    private static string SurveyUrl(int surveyId) => $"/surveys/samples/{surveyId}/edit";
    private static string NormalizeBlockType(string? value) => value?.StartsWith("ban", StringComparison.OrdinalIgnoreCase) == true ? "banana" : "mcs";
    private static string TestTypeLabel(LabTestType test)
    {
        var name = string.IsNullOrWhiteSpace(test.TestName) ? "Unnamed test" : test.TestName.Trim();
        var code = test.TestCode?.Trim();
        return string.IsNullOrWhiteSpace(code) || string.Equals(code, name, StringComparison.OrdinalIgnoreCase)
            ? name
            : $"{name} ({code})";
    }

    private sealed record BlockChoice(string Key, string Label, Block MatchBlock);
    private sealed record TestTypeChoice(int Id, string Label);
    private sealed record ResultTypeOption(int Id, string Name);
}
