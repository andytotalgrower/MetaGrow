            ? "no linked lab results"
            : $"{request.LinkedLabResultCount:N0} linked lab results · lab data will be {(request.DeleteLinkedLabResults ? "deleted" : "retained")}";
    private void ShowToast(string title, string text, ToastRenderStyle style) => ToastService.ShowToast(new ToastOptions
    {
        ProviderName = "SampleSurveyFinderMessages",
        Title = title,
        Text = text,
        RenderStyle = style,
        DisplayTime = TimeSpan.FromSeconds(10)
    });

    public void Dispose()
    {
        _realtimeSubscription?.Dispose();
        var cancellation = Interlocked.Exchange(ref _realtimeRefreshCancellation, null);
        cancellation?.Cancel();
        cancellation?.Dispose();
    }
}
