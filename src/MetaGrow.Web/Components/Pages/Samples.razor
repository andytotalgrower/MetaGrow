            ? request.DeleteLinkedLabResults
                ? $" Its {request.LinkedLabResultCount:N0} linked lab result {(request.LinkedLabResultCount == 1 ? "row will also" : "rows will also")} be permanently deleted."
                : $" Its {request.LinkedLabResultCount:N0} linked lab result {(request.LinkedLabResultCount == 1 ? "row will" : "rows will")} be retained and returned to unlinked lab data."
            : string.Empty;
    private static string LabResultCompletionText(MetaGrowSampleSurveyDeletionDto request) =>
        request.LinkedLabResultCount > 0
            ? request.DeleteLinkedLabResults
                ? $" {request.LinkedLabResultCount:N0} linked lab result {(request.LinkedLabResultCount == 1 ? "row was" : "rows were")} permanently deleted."
                : $" {request.LinkedLabResultCount:N0} lab result {(request.LinkedLabResultCount == 1 ? "row was" : "rows were")} retained and unlinked."
            : string.Empty;
    private static string LabResultQueueText(MetaGrowSampleSurveyDeletionDto request) =>
