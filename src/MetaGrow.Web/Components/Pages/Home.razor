@page "/"
@using ApiModels
@using ApiModels.MetaGrow
@using MetaGrow.Shared
@using MetaGrow.Web.Components.Pages.Index
@using MetaGrow.Web.Services
@using ApiModels.Realtime
@using Metagen.Shared.Services
@attribute [Authorize(Roles = MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager + "," + MetaGrowRoles.Agronomist + "," + MetaGrowRoles.Accountant)]
@implements IAsyncDisposable
@inject ITgsApiService TgsApi
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IRealtimeChangeNotifier RealtimeChanges

<PageTitle>MetaGrow</PageTitle>

<div class="home-page">
    <div class="mg-hero">
        <span class="mg-eyebrow">Metagen Crop Intelligence Hub</span>
        <h1>MetaGrow</h1>
        <p>Survey reporting and farm information for Metagen and Total Grower Services staff.</p>
        <hr class="mg-keyline" />
    </div>

    <section aria-labelledby="work-areas-heading">
        <h2 id="work-areas-heading">My Hub</h2>
        <p class="section-intro">Choose a work area to open its dashboard and related pages.</p>
        <div class="tiles">
            <AuthorizeView Roles="@(MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager + "," + MetaGrowRoles.Agronomist)">
                <IndexTile NavigateUrl="/surveys/multicrop" Title="Multi-crop surveys" Description="Find surveys and open online or printable reports." IconCssClass="icon-chart" />
                <IndexTile NavigateUrl="/surveys/banana" Title="Banana surveys" Description="Open the dedicated banana survey dashboard." IconCssClass="icon-banana" />
            </AuthorizeView>
            <IndexTile NavigateUrl="/surveys/samples" Title="Sample surveys" Description="Find surveys, returned lab data and imports in one work area." IconCssClass="icon-flask" />
            <AuthorizeView Roles="@(MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager)">
                <IndexTile NavigateUrl="/farms" Title="Farm setup" Description="Maintain properties, growers and blocks." IconCssClass="icon-editable-grid" />
            </AuthorizeView>
            <AuthorizeView Roles="@MetaGrowRoles.Admin">
                <IndexTile NavigateUrl="/admin" Title="Administration" Description="Manage users, roles, MFA and application access." IconCssClass="icon-settings" />
            </AuthorizeView>
        </div>
    </section>

    <AuthorizeView Roles="@(MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager + "," + MetaGrowRoles.Agronomist)">
    <section class="incomplete-surveys" aria-labelledby="incomplete-surveys-heading">
        <div class="queue-heading">
            <div>
                <span class="mg-eyebrow">Work queue</span>
                <h2 id="incomplete-surveys-heading">To Do List</h2>
                <p>Surveys that still need work or sign off.</p>
            </div>
            @if (!_loading && _errorMessage is null && _surveys.Count > 0)
            {
                <span class="queue-count">@ResultSummary</span>
            }
        </div>

        @if (_loading)
        {
            <div class="queue-state" role="status">
                <DxWaitIndicator Visible="true" />
                <span>Loading incomplete surveys...</span>
            </div>
        }
        else if (_errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Incomplete surveys could not be loaded.</strong> @_errorMessage
            </div>
        }
        else if (_surveys.Count == 0)
        {
            <div class="queue-state queue-clear">
                <span class="queue-clear-icon" aria-hidden="true">✓</span>
                <div>
                    <strong>Everything is up to date.</strong>
                    <span>No incomplete banana or multi-crop surveys were found.</span>
                </div>
            </div>
        }
        else
        {
            <div class="queue-filters">
                <div class="queue-filter queue-property-filter">
                    <label for="home-survey-property">Property</label>
                    <DxTextBox Id="home-survey-property" @bind-Text="_propertySearch"
                               NullText="Type a property name" BindValueMode="BindValueMode.OnDelayedInput"
                               InputDelay="300" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </div>
                <div class="queue-filter">
                    <label for="home-survey-area">Area</label>
                    <DxComboBox Id="home-survey-area" Data="@AreaOptions" @bind-Value="_area"
                                TextFieldName="@nameof(AreaOption.Name)" ValueFieldName="@nameof(AreaOption.Area)"
                                NullText="All areas" AllowUserInput="false"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </div>
                <div class="queue-filter">
                    <label for="home-survey-status">Status</label>
                    <DxComboBox Id="home-survey-status" Data="@StatusOptions" @bind-Value="_statusId"
                                TextFieldName="@nameof(StatusOption.Name)" ValueFieldName="@nameof(StatusOption.Id)"
                                NullText="All statuses" AllowUserInput="false"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </div>
                <div class="queue-filter">
                    <label for="home-survey-agronomist">Agronomist</label>
                    <DxComboBox Id="home-survey-agronomist" Data="@AgronomistOptions" @bind-Value="_agronomistId"
                                TextFieldName="@nameof(AgronomistOption.Name)" ValueFieldName="@nameof(AgronomistOption.Id)"
                                NullText="All agronomists" AllowUserInput="false" SearchMode="ListSearchMode.AutoSearch"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </div>
                <DxButton Text="Clear" RenderStyle="ButtonRenderStyle.Secondary" Click="ClearFilters" CssClass="queue-clear-button" />
            </div>

            @if (FilteredSurveys.Count == 0)
            {
                <div class="queue-state">
                    <div>
                        <strong>No incomplete surveys match these filters.</strong>
                        <span>Clear one or more filters to see the full work queue.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="queue-desktop">
                    <DxGrid Data="@FilteredSurveys" PageSize="10" ShowAllRows="false"
                            TextWrapEnabled="false" HighlightRowOnHover="true"
                            ColumnResizeMode="GridColumnResizeMode.NextColumn" CssClass="home-survey-grid">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(IncompleteSurveySummaryDto.AreaName)" Caption="Area" Width="110px">
                                <CellDisplayTemplate Context="cell">
                                    @{ var survey = (IncompleteSurveySummaryDto)cell.DataItem; }
                                    @AreaBadge(survey)
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(IncompleteSurveySummaryDto.SurveyDate)" Caption="Survey date" Width="115px" DisplayFormat="dd/MM/yyyy" />
                            <DxGridDataColumn FieldName="@nameof(IncompleteSurveySummaryDto.PropertyName)" Caption="Property" MinWidth="190" />
                            <DxGridDataColumn FieldName="@nameof(IncompleteSurveySummaryDto.AgronomistName)" Caption="Agronomist" MinWidth="150" />
                            <DxGridDataColumn FieldName="@nameof(IncompleteSurveySummaryDto.StatusName)" Caption="Status" MinWidth="170">
                                <CellDisplayTemplate Context="cell">
                                    @{ var survey = (IncompleteSurveySummaryDto)cell.DataItem; }
                                    <span class="status-badge @MultiCropSurveyFilter.StatusBadgeClass(survey.StatusName)">@survey.StatusName</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(IncompleteSurveySummaryDto.LastModified)" Caption="Modified" Width="110px" DisplayFormat="dd/MM/yyyy" />
                            <DxGridDataColumn FieldName="@nameof(IncompleteSurveySummaryDto.PhotoCount)" Caption="Photos" Width="75px" />
                            <DxGridDataColumn Caption="Actions" Width="170px" AllowSort="false">
                                <CellDisplayTemplate Context="cell">
                                    @{ var survey = (IncompleteSurveySummaryDto)cell.DataItem; }
                                    <div class="mg-grid-actions" role="group" aria-label="Survey actions">
                                        <DxButton NavigateUrl="@IncompleteSurveyNavigation.EditUrl(survey)"
                                                  aria-label="Edit survey" title="Edit survey"
                                                  RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                  SizeMode="SizeMode.Small" CssClass="queue-icon-button" IconCssClass="oi oi-pencil" />
                                        <DxButton NavigateUrl="@IncompleteSurveyNavigation.OnlineReportUrl(survey)"
                                                  aria-label="View online report" title="View online report"
                                                  RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                  SizeMode="SizeMode.Small" CssClass="queue-icon-button" IconCssClass="oi oi-external-link" />
                                        <DxButton NavigateUrl="@IncompleteSurveyNavigation.PrintReportUrl(survey)"
                                                  aria-label="Print report" title="Print report"
                                                  RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                  SizeMode="SizeMode.Small" CssClass="queue-icon-button" IconCssClass="oi oi-print" />
                                        <DxButton aria-label="Delete survey" title="Delete survey"
                                                  RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                  SizeMode="SizeMode.Small" CssClass="queue-icon-button" IconCssClass="oi oi-trash"
                                                  Click="@(() => _deletionPopup!.ShowAsync(SurveyType(survey), survey.SurveyId))" />
                                    </div>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>
                    </DxGrid>
                </div>

                <div class="queue-mobile">
                    @foreach (var survey in FilteredSurveys)
                    {
                        <article class="queue-card @IncompleteSurveyFilter.AreaBadgeClass(survey.Area)">
                            <div class="queue-card-heading">
                                <div>
                                    <strong>@survey.PropertyName</strong>
                                    <span>@survey.SurveyDate.ToString("dd MMM yyyy")</span>
                                </div>
                                @AreaBadge(survey)
                            </div>
                            <dl>
                                <div><dt>Status</dt><dd><span class="status-badge @MultiCropSurveyFilter.StatusBadgeClass(survey.StatusName)">@survey.StatusName</span></dd></div>
                                <div><dt>Agronomist</dt><dd>@survey.AgronomistName</dd></div>
                                <div><dt>Modified</dt><dd>@survey.LastModified.ToString("dd MMM yyyy")</dd></div>
                                <div><dt>Photos</dt><dd>@survey.PhotoCount</dd></div>
                            </dl>
                            <div class="queue-card-actions">
                                <a class="btn btn-primary" href="@IncompleteSurveyNavigation.EditUrl(survey)">Edit survey</a>
                                <a class="btn btn-outline-secondary" href="@IncompleteSurveyNavigation.OnlineReportUrl(survey)">Online report</a>
                                <a class="btn btn-outline-secondary" href="@IncompleteSurveyNavigation.PrintReportUrl(survey)">Print report</a>
                                <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger"
                                          Click="@(() => _deletionPopup!.ShowAsync(SurveyType(survey), survey.SurveyId))" />
                            </div>
                        </article>
                    }
                </div>
            }
        }
    </section>
    </AuthorizeView>

    <AuthorizeView Roles="@(MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager + "," + MetaGrowRoles.Accountant)">
        <DashboardApprovals />
    </AuthorizeView>

</div>

<SurveyDeletionRequestPopup @ref="_deletionPopup" />

@code {
    private static readonly AreaOption[] AreaOptions =
    [
        new(IncompleteSurveyArea.Banana, "Banana"),
        new(IncompleteSurveyArea.MultiCrop, "Multi-crop")
    ];

    private bool _loading = true;
    private string? _errorMessage;
    private string? _propertySearch;
    private IncompleteSurveyArea? _area;
    private int? _statusId;
    private int? _agronomistId;
    private List<IncompleteSurveySummaryDto> _surveys = [];
    private readonly SemaphoreSlim _refreshGate = new(1, 1);
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private CancellationTokenSource? _debounceCancellation;
    private IDisposable? _realtimeSubscription;
    private Task? _reconciliationTask;
    private SurveyDeletionRequestPopup? _deletionPopup;
    private static MetaGrowSurveyType SurveyType(IncompleteSurveySummaryDto survey) =>
        survey.Area == IncompleteSurveyArea.Banana ? MetaGrowSurveyType.Banana : MetaGrowSurveyType.MultiCrop;

    private sealed record AreaOption(IncompleteSurveyArea Area, string Name);
    private sealed record StatusOption(int Id, string Name, int Priority);
    private sealed record AgronomistOption(int Id, string Name);

    private IReadOnlyList<IncompleteSurveySummaryDto> FilteredSurveys =>
        IncompleteSurveyFilter.Apply(_surveys, _propertySearch, _area, _statusId, _agronomistId);

    private IReadOnlyList<StatusOption> StatusOptions => _surveys
        .GroupBy(survey => new { survey.StatusId, survey.StatusName, survey.WorkflowPriority })
        .Select(group => new StatusOption(group.Key.StatusId, group.Key.StatusName, group.Key.WorkflowPriority))
        .OrderBy(status => status.Priority)
        .ThenBy(status => status.Name)
        .ToList();

    private IReadOnlyList<AgronomistOption> AgronomistOptions => _surveys
        .GroupBy(survey => new { survey.AgronomistId, survey.AgronomistName })
        .Select(group => new AgronomistOption(group.Key.AgronomistId, group.Key.AgronomistName))
        .OrderBy(agronomist => agronomist.Name)
        .ToList();

    private string ResultSummary => FilteredSurveys.Count == _surveys.Count
        ? $"{_surveys.Count} incomplete {SurveyText(_surveys.Count)}"
        : $"{FilteredSurveys.Count} of {_surveys.Count} incomplete surveys";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (!user.IsInRole(MetaGrowRoles.Admin) &&
            !user.IsInRole(MetaGrowRoles.AgricultureManager) &&
            !user.IsInRole(MetaGrowRoles.Agronomist))
        {
            _loading = false;
            return;
        }

        _realtimeSubscription = RealtimeChanges.Subscribe(HandleRealtimeChangeAsync);
        _reconciliationTask = ReconcilePeriodicallyAsync(_lifetimeCancellation.Token);
        await LoadSurveysAsync(isInitialLoad: true, _lifetimeCancellation.Token);
    }

    private async Task LoadSurveysAsync(bool isInitialLoad, CancellationToken cancellationToken)
    {
        await _refreshGate.WaitAsync(cancellationToken);
        try
        {
            var surveys = await TgsApi.GetIncompleteSurveySummaries();
            if (cancellationToken.IsCancellationRequested) return;

            await InvokeAsync(() =>
            {
                _surveys = surveys ?? [];
                _errorMessage = surveys is null
                    ? TgsApi.ErrorMessage ?? "The incomplete survey work queue could not be loaded from the TGS API."
                    : null;
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            await InvokeAsync(() => _errorMessage = exception.Message);
        }
        finally
        {
            if (isInitialLoad)
                await InvokeAsync(() => _loading = false);
            _refreshGate.Release();
        }
    }

    private Task HandleRealtimeChangeAsync(RealtimeEventEnvelope message)
    {
        if (message.EventType != RealtimeEventTypes.SurveyChangedV1)
            return Task.CompletedTask;

        var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCancellation.Token);
        var previous = Interlocked.Exchange(ref _debounceCancellation, cancellation);
        previous?.Cancel();
        previous?.Dispose();
        _ = RefreshAfterDebounceAsync(cancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RefreshAfterDebounceAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(500), cancellationToken);
            await LoadSurveysAsync(isInitialLoad: false, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task ReconcilePeriodicallyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await LoadSurveysAsync(isInitialLoad: false, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void ClearFilters()
    {
        _propertySearch = null;
        _area = null;
        _statusId = null;
        _agronomistId = null;
    }

    private static RenderFragment AreaBadge(IncompleteSurveySummaryDto survey) =>
        @<span class="area-badge @IncompleteSurveyFilter.AreaBadgeClass(survey.Area)">@survey.AreaName</span>;

    private static string SurveyText(int count) => count == 1 ? "survey" : "surveys";

    public async ValueTask DisposeAsync()
    {
        _realtimeSubscription?.Dispose();
        _lifetimeCancellation.Cancel();
        _debounceCancellation?.Cancel();

        if (_reconciliationTask is not null)
        {
            try { await _reconciliationTask; }
            catch (OperationCanceledException) { }
        }

        _debounceCancellation?.Dispose();
        _lifetimeCancellation.Dispose();
    }
}
