@page "/surveys/samples/{SurveyId:int}/edit"
@using ApiModels
@using ApiModels.MetaGrow
@using DevExpress.Blazor.Office
@using MetaGrow.Web.Services
@using Metagen.Shared.Services
@attribute [Authorize(Roles = MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager + "," + MetaGrowRoles.Agronomist + "," + MetaGrowRoles.Accountant)]
@inject ITgsApiService TgsApi
@inject ApiTokenService ApiTokens
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject SampleSurveyDeletionApiClient Deletions
@inject IToastNotificationService ToastService

<PageTitle>Sample survey @SurveyId | MetaGrow</PageTitle>

<DxToastProvider Name="SampleSurveyEditorMessages" MaxToastCount="3"
                 AnimationType="ToastAnimationType.Slide"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 StickToViewport="true" DisplayTime="TimeSpan.FromSeconds(10)" Width="410px" />

<div class="sample-editor-page">
    @if (_loading)
    {
        <div class="editor-loading"><DxWaitIndicator Visible="true" /><span>Loading Sample survey...</span></div>
    }
    else if (_editor is null)
    {
        <div class="alert alert-danger" role="alert">@_loadError</div>
        <DxButton Text="Back to Sample surveys" RenderStyle="ButtonRenderStyle.Secondary" Click="BackToSurveys" />
    }
    else
    {
        <div class="editor-toolbar" role="toolbar" aria-label="Sample survey actions">
            <div class="toolbar-left">
                <DxButton Text="Back to Sample surveys" RenderStyle="ButtonRenderStyle.Secondary" Click="BackToSurveys" />
                <DxButton Text="View imported results" RenderStyle="ButtonRenderStyle.Secondary" Click="ViewLabData" />
                @if (CanImportResults)
                {
                    <DxButton Text="@ImportResultsButtonText" RenderStyle="ButtonRenderStyle.Secondary" Click="ImportResults" />
                }
            </div>
            <div class="toolbar-actions">
                @if (_canEditOperations || _canEditFinance)
                {
                    <DxButton Text="Save changes" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!_busy)" Click="SaveAsync" />
                }
                <DxButton Text="@(_pendingDeletion is null ? "Request deletion" : "Deletion awaiting approval")"
                          RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!_busy && _pendingDeletion is null)" Click="OpenDeletionPreviewAsync" />
            </div>
        </div>

        <header class="editor-hero">
            <div>
                <span class="editor-kicker">Sample survey @SurveyId</span>
                <h1>@_editor.PropertyName</h1>
                <p>@_editor.SurveyDate.ToString("dd MMMM yyyy") · @_editor.AgronomistName · @_editor.Samples.Count samples</p>
            </div>
            <div class="type-summary">
                @if (_editor.Metagen is not null) { <span class="type-badge metagen">Metagen</span> }
                @if (_editor.Nutrition is not null) { <span class="type-badge nutrition">Chemistry</span> }
            </div>
        </header>

        <section class="workflow-section" aria-labelledby="workflow-heading">
            <div class="section-heading">
                <span class="editor-kicker">Independent status tracks</span>
                <h2 id="workflow-heading">Laboratory and report workflow</h2>
                <p>Metagen and chemistry samples move independently. Report QA only opens after every sample in that lane is lab-complete.</p>
            </div>
            <div class="workflow-lanes">
                @if (_editor.Metagen is not null)
                {
                    <SampleWorkflowLane Lane="@_editor.Metagen" CanMove="@_canMoveStatuses" Busy="@_busy"
                                        Move="@(action => TransitionAsync(SampleSurveyCategory.Metagen, action))" />
                }
                @if (_editor.Nutrition is not null)
                {
                    <SampleWorkflowLane Lane="@_editor.Nutrition" CanMove="@_canMoveStatuses" Busy="@_busy"
                                        Move="@(action => TransitionAsync(SampleSurveyCategory.Nutrition, action))" />
                }
            </div>
        </section>

        <div class="editor-grid">
            <section class="editor-card" aria-labelledby="details-heading">
                <div class="section-heading">
                    <span class="editor-kicker">Survey setup</span>
                    <h2 id="details-heading">Details and time</h2>
                </div>
                <div class="field-grid">
                    <div class="field">
                        <label for="sample-survey-date">Survey date</label>
                        <DxDateEdit Id="sample-survey-date" @bind-Date="_editor.SurveyDate" DisplayFormat="dd/MM/yyyy" Enabled="@_canEditOperations" />
                    </div>
                    <div class="field wide">
                        <label for="sample-agronomist">Agronomist</label>
                        <DxComboBox Id="sample-agronomist" Data="@_editor.Agronomists" @bind-Value="_editor.AgronomistId"
                                    TextFieldName="@nameof(Staff.StaffName)" ValueFieldName="@nameof(Staff.StaffId)"
                                    AllowUserInput="false" Enabled="@_canEditOperations" />
                    </div>
                    <div class="field">
                        <label for="sample-hours">Sample hours</label>
                        <DxSpinEdit Id="sample-hours" @bind-Value="_editor.SampleHours" Increment="0.25" MinValue="0" DisplayFormat="0.00" Enabled="@_canEditOperations" />
                    </div>
                    <div class="field">
                        <label for="sample-report-hours">Report hours</label>
                        <DxSpinEdit Id="sample-report-hours" @bind-Value="_editor.ReportHours" Increment="0.25" MinValue="0" DisplayFormat="0.00" Enabled="@_canEditOperations" />
                    </div>
                </div>
                <div class="field">
                    <label for="sample-general-notes">General notes</label>
                    <DxMemo Id="sample-general-notes" @bind-Text="_editor.GeneralNotes" Rows="4" Enabled="@_canEditOperations" />
                </div>
            </section>

            <section class="editor-card" aria-labelledby="billing-heading">
                <div class="section-heading">
                    <span class="editor-kicker">Billing</span>
                    <h2 id="billing-heading">Survey billing</h2>
                </div>
                <div class="field-grid">
                    <div class="field wide">
                        <label for="sample-billing-entity">Billing entity</label>
                        <DxComboBox Id="sample-billing-entity" Data="@_editor.BillingEntities" @bind-Value="_editor.BillingEntityId"
                                    TextFieldName="@nameof(BillingEntity.BillingEntityName)" ValueFieldName="@nameof(BillingEntity.BillingEntityId)"
                                    AllowUserInput="false" Enabled="@_canEditFinance" />
                    </div>
                    <div class="field">
                        <label for="sample-postage-bags">Postage bags</label>
                        <DxSpinEdit Id="sample-postage-bags" @bind-Value="_editor.NoPostageBags" MinValue="0" Enabled="@_canEditFinance" />
                    </div>
                    <div class="field wide">
                        <label for="sample-po">Survey P.O. number</label>
                        <DxTextBox Id="sample-po" @bind-Text="_editor.SurveyPurchaseOrderNumber" Enabled="@_canEditFinance"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </div>
                </div>
                <div class="field">
                    <label for="sample-accountant-notes">Notes for accountant</label>
                    <DxMemo Id="sample-accountant-notes" @bind-Text="_editor.NotesForAccountant" Rows="4" Enabled="@_canEditFinance" />
                </div>
            </section>

            <section class="editor-card full-width key-findings-card" aria-labelledby="key-findings-heading">
                <div class="section-heading split-heading">
                    <div>
                        <span class="editor-kicker">Report content</span>
                        <h2 id="key-findings-heading">Key findings</h2>
                        <p>These ordered findings will introduce the combined Soil, Tissue, Quick Soil and Sap report.</p>
                    </div>
                    @if (CanEditKeyFindings)
                    {
                        <DxButton Text="Add key finding" RenderStyle="ButtonRenderStyle.Primary"
                                  Enabled="@(!_keyFindingBusy)" Click="OpenNewKeyFindingEditor" />
                    }
                </div>

                @if (KeyFindingsLocked)
                {
                    <div class="key-findings-locked">This report is complete. Reopen it before changing its key findings.</div>
                }

                @if (_editor.KeyFindings.Count == 0)
                {
                    <div class="key-findings-empty">
                        <strong>No key findings have been recorded.</strong>
                        <span>Add the agronomist's report findings before submitting the report for QA.</span>
                    </div>
                }
                else
                {
                    <ol class="key-findings-list">
                        @for (var index = 0; index < _editor.KeyFindings.Count; index++)
                        {
                            var finding = _editor.KeyFindings[index];
                            var findingIndex = index;
                            <li class="key-finding-item">
                                <div class="key-finding-sequence" aria-label="Finding @(findingIndex + 1)">@(findingIndex + 1)</div>
                                <div class="key-finding-content">@((MarkupString)finding.Html)</div>
                                @if (CanEditKeyFindings)
                                {
                                    <div class="key-finding-actions" aria-label="Actions for finding @(findingIndex + 1)">
                                        <DxButton Text="↑" RenderStyle="ButtonRenderStyle.Secondary"
                                                  Enabled="@(!_keyFindingBusy && findingIndex > 0)"
                                                  Click="@(() => MoveKeyFindingAsync(finding, -1))" />
                                        <DxButton Text="↓" RenderStyle="ButtonRenderStyle.Secondary"
                                                  Enabled="@(!_keyFindingBusy && findingIndex < _editor.KeyFindings.Count - 1)"
                                                  Click="@(() => MoveKeyFindingAsync(finding, 1))" />
                                        <DxButton Text="Edit" RenderStyle="ButtonRenderStyle.Secondary"
                                                  Enabled="@(!_keyFindingBusy)" Click="@(() => OpenKeyFindingEditor(finding))" />
                                        <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger"
                                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                  Enabled="@(!_keyFindingBusy)" Click="@(() => OpenKeyFindingDelete(finding))" />
                                    </div>
                                }
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="editor-card full-width" aria-labelledby="samples-heading">
                <div class="section-heading split-heading">
                    <div>
                        <span class="editor-kicker">Collected samples</span>
                        <h2 id="samples-heading">Samples and laboratory progress</h2>
                    </div>
                    <span>@_editor.Samples.Count total</span>
                </div>
                <div class="sample-grid-wrap">
                    <DxGrid Data="@_editor.Samples" PageSize="20" HighlightRowOnHover="true" TextWrapEnabled="false"
                            ColumnResizeMode="GridColumnResizeMode.NextColumn" CssClass="editor-sample-grid">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(SampleSurveyItem.ItemId)" Caption="Item ID" Width="82px">
                                <CellDisplayTemplate Context="cell">
                                    @{ var item = (SampleSurveyItem)cell.DataItem; }
                                    <span class="item-id-value">@item.ItemId.ToString("0")</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Type" Width="92px" AllowSort="false">
                                <CellDisplayTemplate Context="cell">
                                    @{ var item = (SampleSurveyItem)cell.DataItem; }
                                    <span class="type-badge @(item.LabId == 6 ? "metagen" : "nutrition")">@(item.LabId == 6 ? "Metagen" : "Chemistry")</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(SampleSurveyItem.LabName)" Caption="Laboratory" MinWidth="130" />
                            <DxGridDataColumn FieldName="@nameof(SampleSurveyItem.LabStatusName)" Caption="Lab status" MinWidth="130" />
                            <DxGridDataColumn FieldName="@nameof(SampleSurveyItem.BarcodeId)" Caption="Barcode" Width="95px">
                                <CellDisplayTemplate Context="cell">
                                    @{ var item = (SampleSurveyItem)cell.DataItem; }
                                    <span class="barcode-value">@item.BarcodeId.ToString("0")</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(SampleSurveyItem.BlockName)" Caption="Block" MinWidth="140" />
                            <DxGridDataColumn FieldName="@nameof(SampleSurveyItem.TestName)" Caption="Test" MinWidth="140" />
                            <DxGridDataColumn FieldName="@nameof(SampleSurveyItem.CropTypeName)" Caption="Crop" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(SampleSurveyItem.IsBillable)" Caption="Billable" Width="80px" />
                            <DxGridDataColumn Caption="Actions" Width="82px" AllowSort="false">
                                <CellDisplayTemplate Context="cell">
                                    @{ var item = (SampleSurveyItem)cell.DataItem; }
                                    @if (_canEditOperations && item.LabId != 6)
                                    {
                                        <DxButton Text="Edit" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => OpenItemEditor(item))" />
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>
                    </DxGrid>
                </div>
            </section>

            <section class="editor-card full-width imported-results-card" aria-labelledby="imported-results-heading">
                <div class="section-heading split-heading">
                    <div>
                        <span class="editor-kicker">Laboratory data</span>
                        <h2 id="imported-results-heading">Imported lab results</h2>
                        <p>Results linked to this survey across Soil, Tissue, Quick Soil and Sap.</p>
                    </div>
                    @if (!_labResultsLoading)
                    {
                        <span>@_importedLabResults.Count result@(_importedLabResults.Count == 1 ? string.Empty : "s")</span>
                    }
                </div>

                @if (_labResultsLoading)
                {
                    <div class="imported-results-state"><DxWaitIndicator Visible="true" /><span>Loading imported results…</span></div>
                }
                else if (!string.IsNullOrWhiteSpace(_labResultsError))
                {
                    <div class="imported-results-error" role="alert">
                        <div><strong>Imported results could not be loaded.</strong><span>@_labResultsError</span></div>
                        <DxButton Text="Try again" RenderStyle="ButtonRenderStyle.Secondary" Click="LoadImportedLabResultsAsync" />
                    </div>
                }
                else if (_importedLabResults.Count == 0)
                {
                    <div class="imported-results-empty">
                        <div><strong>No imported lab results are linked to this survey.</strong><span>Import the laboratory CSV when it becomes available.</span></div>
                        @if (CanImportResults)
                        {
                            <DxButton Text="Import results" RenderStyle="ButtonRenderStyle.Primary" Click="ImportResults" />
                        }
                    </div>
                }
                else
                {
                    <div class="imported-result-types" aria-label="Imported result types">
                        @foreach (var summary in ImportedResultSummaries)
                        {
                            <div class="imported-result-type">
                                <span>@summary.ResultType</span>
                                <strong>@summary.Count</strong>
                                <small>result@(summary.Count == 1 ? string.Empty : "s")</small>
                            </div>
                        }
                    </div>

                    <div class="imported-results-grid-wrap">
                        <DxGrid Data="@SortedImportedLabResults" PageSize="10" HighlightRowOnHover="true" TextWrapEnabled="false"
                                ColumnResizeMode="GridColumnResizeMode.NextColumn" CssClass="imported-results-grid">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(UnifiedLabResultRow.DateReceived)" Caption="Received" Width="105px" DisplayFormat="dd/MM/yyyy" />
                                @if (ImportedResultSummaries.Count > 1)
                                {
                                    <DxGridDataColumn FieldName="@nameof(UnifiedLabResultRow.ResultType)" Caption="Type" Width="92px" />
                                }
                                <DxGridDataColumn FieldName="@nameof(UnifiedLabResultRow.PropertyName)" Caption="Property" MinWidth="155" />
                                <DxGridDataColumn FieldName="@nameof(UnifiedLabResultRow.BlockName)" Caption="Block" MinWidth="130" />
                                <DxGridDataColumn FieldName="@nameof(UnifiedLabResultRow.CropName)" Caption="Crop" MinWidth="110" />
                                <DxGridDataColumn FieldName="@nameof(UnifiedLabResultRow.Reference)" Caption="Field reference" MinWidth="135" />
                                <DxGridDataColumn FieldName="@nameof(UnifiedLabResultRow.OrderNumber)" Caption="Order / sample" MinWidth="125" />
                                <DxGridDataColumn FieldName="@nameof(UnifiedLabResultRow.KeyResults)" Caption="Key results" MinWidth="300">
                                    <CellDisplayTemplate Context="cell">
                                        @{ var result = (UnifiedLabResultRow)cell.DataItem; }
                                        <span class="key-results-value">@result.KeyResults</span>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                            </Columns>
                        </DxGrid>
                    </div>

                    <div class="imported-results-actions">
                        <DxButton Text="View full results" RenderStyle="ButtonRenderStyle.Secondary" Click="ViewLabData" />
                        @if (CanImportResults)
                        {
                            <DxButton Text="@ImportResultsButtonText" RenderStyle="ButtonRenderStyle.Primary" Click="ImportResults" />
                        }
                    </div>
                }
            </section>

            <section class="editor-card full-width" aria-labelledby="invoice-heading">
                <div class="section-heading">
                    <span class="editor-kicker">Accounts</span>
                    <h2 id="invoice-heading">Invoice details</h2>
                </div>
                <div class="field-grid invoice-grid">
                    <div class="field">
                        <label for="sample-invoice-number">Invoice number</label>
                        <DxTextBox Id="sample-invoice-number" @bind-Text="_editor.InvoiceNumber" Enabled="@_canEditFinance" />
                    </div>
                    <div class="field">
                        <label for="sample-invoice-date">Invoice date</label>
                        <DxDateEdit Id="sample-invoice-date" @bind-Date="_editor.InvoiceDate" DisplayFormat="dd/MM/yyyy" Enabled="@_canEditFinance" />
                    </div>
                    <div class="field">
                        <label for="sample-invoice-email-date">Invoice emailed</label>
                        <DxDateEdit Id="sample-invoice-email-date" @bind-Date="_editor.InvoiceEmailedDate" DisplayFormat="dd/MM/yyyy" Enabled="@_canEditFinance" />
                    </div>
                </div>
                <div class="field">
                    <label for="sample-invoice-notes">Invoice notes</label>
                    <DxMemo Id="sample-invoice-notes" @bind-Text="_editor.InvoiceNotes" Rows="3" Enabled="@_canEditFinance" />
                </div>
            </section>
        </div>

        <footer class="audit-strip">
            <span><strong>Created</strong> @_editor.CreationDate.ToString("dd MMM yyyy HH:mm") by @_editor.CreatedBy</span>
            @if (_editor.ModificationDate.HasValue)
            {
                <span><strong>Last changed</strong> @_editor.ModificationDate.Value.ToString("dd MMM yyyy HH:mm") by @_editor.ModifiedBy</span>
            }
        </footer>
    }
</div>

<DxPopup @bind-Visible="_keyFindingEditorVisible" ShowFooter="true" HeaderText="@KeyFindingEditorTitle"
         AllowDrag="true" ShowCloseButton="@(!_keyFindingBusy)" CloseOnEscape="@(!_keyFindingBusy)"
         CloseOnOutsideClick="false" Width="min(820px, calc(100vw - 2rem))">
    <BodyContentTemplate>
        <div class="key-finding-editor-dialog">
            <p>Use concise findings for the grower. Formatting is limited to report-safe text styles and lists.</p>
            <DxHtmlEditor @bind-Markup="_keyFindingDraftHtml"
                          BindMarkupMode="HtmlEditorBindMarkupMode.OnDelayedInput"
                          InputDelay="500"
                          CustomizeToolbar="CustomizeKeyFindingToolbar"
                          ReadOnly="@_keyFindingBusy"
                          Height="260px" Width="100%" />
            @if (!string.IsNullOrWhiteSpace(_keyFindingError))
            {
                <div class="dialog-error" role="alert">@_keyFindingError</div>
            }
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="dialog-footer">
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(!_keyFindingBusy)" Click="CloseKeyFindingEditor" />
            @if (_keyFindingBusy)
            {
                <div class="inline-progress"><DxWaitIndicator Visible="true" /><span>Saving key finding…</span></div>
            }
            <DxButton Text="Save key finding" RenderStyle="ButtonRenderStyle.Primary"
                      Enabled="@(!_keyFindingBusy)" Click="SaveKeyFindingAsync" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="_keyFindingDeleteVisible" ShowFooter="true" HeaderText="Delete key finding"
         AllowDrag="true" ShowCloseButton="@(!_keyFindingBusy)" CloseOnEscape="@(!_keyFindingBusy)"
         CloseOnOutsideClick="false" Width="min(520px, calc(100vw - 2rem))">
    <BodyContentTemplate>
        <div class="key-finding-delete-dialog">
            <p>Delete key finding <strong>@(_keyFindingDeleteTarget is null ? string.Empty : $"#{_keyFindingDeleteTarget.Sequence}")</strong>?</p>
            <p>The deletion is recorded in the report audit history.</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="dialog-footer">
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(!_keyFindingBusy)" Click="CloseKeyFindingDelete" />
            @if (_keyFindingBusy)
            {
                <div class="inline-progress"><DxWaitIndicator Visible="true" /><span>Deleting key finding…</span></div>
            }
            <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger"
                      Enabled="@(!_keyFindingBusy)" Click="DeleteKeyFindingAsync" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="_itemEditorVisible" ShowFooter="true" HeaderText="@ItemEditorTitle"
         AllowDrag="true" ShowCloseButton="@(!_itemBusy)" CloseOnEscape="@(!_itemBusy)"
         CloseOnOutsideClick="false" Width="min(760px, calc(100vw - 2rem))">
    <BodyContentTemplate>
        @if (_editingItem is not null && _itemEdit is not null)
        {
            <div class="sample-item-dialog">
                <div class="sample-item-summary">
                    <div><span>Item ID</span><strong>@_editingItem.ItemId</strong></div>
                    <div><span>Barcode</span><strong>@_editingItem.BarcodeId.ToString("0")</strong></div>
                    <div><span>Lab status</span><strong>@(_editingItem.LabStatusName ?? "Sent by agronomist")</strong></div>
                    <div><span>Sample</span><strong>@_editingItem.SequenceNo</strong></div>
                </div>

                @if (_editingItem.LabStatusId >= 100)
                {
                    <div class="sample-item-warning">Lab results are already loaded for this sample. Changes here do not rewrite the raw laboratory result rows.</div>
                }
                @if (!string.IsNullOrWhiteSpace(_itemError))
                {
                    <div class="dialog-error" role="alert">@_itemError</div>
                }

                <div class="sample-item-fields">
                    <div class="field wide block-mode-field">
                        <DxCheckBox @bind-Checked="_useTypedBlockName" Enabled="@(!_itemBusy)">Use a typed block name</DxCheckBox>
                    </div>
                    @if (_useTypedBlockName)
                    {
                        <div class="field wide">
                            <label for="sample-item-block-name">Block name</label>
                            <DxTextBox Id="sample-item-block-name" @bind-Text="_itemEdit.BlockName" Enabled="@(!_itemBusy)"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </div>
                    }
                    else
                    {
                        <div class="field wide">
                            <label for="sample-item-block">Property block</label>
                            <DxComboBox Id="sample-item-block" Data="@BlockChoices" @bind-Value="_itemBlockKey"
                                        TextFieldName="@nameof(SampleBlockChoice.Label)" ValueFieldName="@nameof(SampleBlockChoice.Key)"
                                        NullText="Select a banana or multi-crop block" AllowUserInput="false"
                                        SearchMode="ListSearchMode.AutoSearch" SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        Enabled="@(!_itemBusy)" />
                        </div>
                    }
                    <div class="field wide">
                        <label for="sample-item-crop">Crop</label>
                        <DxComboBox Id="sample-item-crop" Data="@_editor?.Crops" @bind-Value="_itemEdit.CropTypeId"
                                    TextFieldName="@nameof(CropType.CropTypeName)" ValueFieldName="@nameof(CropType.CropTypeId)"
                                    NullText="Select a crop" AllowUserInput="false" SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" Enabled="@(!_itemBusy)" />
                    </div>
                    <div class="field">
                        <label for="sample-item-lab">Laboratory</label>
                        <DxComboBox Id="sample-item-lab" Data="@ExternalLaboratories" Value="@_itemEdit.LabId"
                                    ValueChanged="@((int value) => ItemLaboratoryChanged(value))"
                                    TextFieldName="@nameof(Lab.LabDisplayName)" ValueFieldName="@nameof(Lab.LabId)"
                                    NullText="Select a laboratory" AllowUserInput="false" Enabled="@(!_itemBusy)" />
                    </div>
                    <div class="field">
                        <label for="sample-item-test">Lab test</label>
                        <DxComboBox Id="sample-item-test" Data="@AvailableLabTests" @bind-Value="_itemEdit.TestTypeId"
                                    TextFieldName="@nameof(LabTestType.TestName)" ValueFieldName="@nameof(LabTestType.LabTestTypeId)"
                                    NullText="Select a lab test" AllowUserInput="false" SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" Enabled="@(!_itemBusy)" />
                    </div>
                    <div class="field wide">
                        <label for="sample-item-reference">Laboratory reference</label>
                        <DxTextBox Id="sample-item-reference" @bind-Text="_itemEdit.LabReference" Enabled="@(!_itemBusy)"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </div>
                    <div class="field wide billable-field">
                        <DxCheckBox @bind-Checked="_itemEdit.IsBillable" Enabled="@(!_itemBusy)">Billable sample</DxCheckBox>
                    </div>
                    <div class="field wide">
                        <label for="sample-item-comments">Comments</label>
                        <DxMemo Id="sample-item-comments" @bind-Text="_itemEdit.Comments" Rows="4" Enabled="@(!_itemBusy)" />
                    </div>
                </div>
            </div>
        }
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="dialog-footer">
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="CloseItemEditor" Enabled="@(!_itemBusy)" />
            @if (_itemBusy)
            {
                <div class="inline-progress"><DxWaitIndicator Visible="true" /><span>Saving collected sample…</span></div>
            }
            <DxButton Text="Save sample" RenderStyle="ButtonRenderStyle.Primary" Click="SaveItemAsync" Enabled="@CanSaveItem" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="_deletionPopupVisible" ShowFooter="true" HeaderText="Request Sample survey deletion"
         AllowDrag="true" ShowCloseButton="@(!_deletionBusy)" CloseOnEscape="@(!_deletionBusy)"
         CloseOnOutsideClick="false" Width="min(650px, calc(100vw - 2rem))">
    <BodyContentTemplate>
        @if (_deletionBusy && _deletionPreview is null)
        {
            <div class="editor-loading"><DxWaitIndicator Visible="true" /><span>Running live deletion safety checks…</span></div>
        }
        else if (!string.IsNullOrWhiteSpace(_deletionError))
        {
            <div class="alert alert-danger" role="alert">@_deletionError</div>
        }
        else if (_deletionPreview is not null)
        {
            <div class="deletion-review">
                <p><strong>@_deletionPreview.PropertyName</strong> · survey @_deletionPreview.SurveyId · @_deletionPreview.SurveyDate.ToString("dd MMM yyyy")</p>
                <div class="deletion-impact-grid">
                    <div><strong>@_deletionPreview.SampleCount</strong><span>Collected samples</span></div>
                    <div><strong>@_deletionPreview.PhotoCount</strong><span>Photo records</span></div>
                    <div><strong>@_deletionPreview.ActionCount</strong><span>Actions</span></div>
                    <div><strong>@_deletionPreview.ReportCount</strong><span>Reports</span></div>
                    <div><strong>@_deletionPreview.LinkedLabResultCount</strong><span>Linked lab results</span></div>
                </div>
                @if (_deletionPreview.CanDelete)
                {
                    @if (_deletionPreview.LinkedLabResultCount > 0)
                    {
                        <div class="lab-deletion-choice">
                            <DxCheckBox @bind-Checked="_deleteLinkedLabResults">
                                Permanently delete the linked lab data as well
                            </DxCheckBox>
                            @if (_deleteLinkedLabResults)
                            {
                                <div class="dialog-error" role="alert">
                                    The @_deletionPreview.LinkedLabResultCount linked lab result @(_deletionPreview.LinkedLabResultCount == 1 ? "row will" : "rows will") be permanently deleted with the survey. Choose this only when the laboratory file contains unusable data.
                                </div>
                            }
                            else
                            {
                                <div class="sample-item-warning">
                                    The @_deletionPreview.LinkedLabResultCount linked lab result @(_deletionPreview.LinkedLabResultCount == 1 ? "row will" : "rows will") be retained and returned to the unlinked lab-data workflow.
                                </div>
                            }
                        </div>
                    }
                    <div class="sample-item-warning">This permanently removes the survey and its operational child records. Approval is required before anything changes.</div>
                }
                else
                {
                    <div class="dialog-error" role="alert">@_deletionPreview.BlockReason</div>
                }
            </div>
        }
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="dialog-footer">
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="CloseDeletionPopup" Enabled="@(!_deletionBusy)" />
            @if (_deletionBusy && _deletionPreview is not null)
            {
                <div class="inline-progress"><DxWaitIndicator Visible="true" /><span>Submitting request…</span></div>
            }
            <DxButton Text="Request deletion" RenderStyle="ButtonRenderStyle.Danger" Click="RequestDeletionAsync"
                      Enabled="@(!_deletionBusy && _deletionPreview?.CanDelete == true)" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [Parameter] public int SurveyId { get; set; }

    private SampleSurveyEditorDto? _editor;
    private bool _loading = true;
    private bool _busy;
    private bool _canEditOperations;
    private bool _canEditFinance;
    private bool _canMoveStatuses;
    private bool _keyFindingEditorVisible;
    private bool _keyFindingDeleteVisible;
    private bool _keyFindingBusy;
    private int? _keyFindingDraftId;
    private string _keyFindingDraftHtml = string.Empty;
    private string? _keyFindingError;
    private SampleSurveyKeyFindingDto? _keyFindingDeleteTarget;
    private bool _itemEditorVisible;
    private bool _itemBusy;
    private bool _useTypedBlockName;
    private bool _labResultsLoading;
    private string? _loadError;
    private string? _itemError;
    private string? _labResultsError;
    private string? _itemBlockKey;
    private List<UnifiedLabResultRow> _importedLabResults = [];
    private SampleSurveyItem? _editingItem;
    private SampleSurveyItemEditorUpdateRequest? _itemEdit;
    private bool _deletionPopupVisible;
    private bool _deletionBusy;
    private bool _deleteLinkedLabResults;
    private string? _deletionError;
    private SampleSurveyDeletionPreviewDto? _deletionPreview;
    private MetaGrowSampleSurveyDeletionDto? _pendingDeletion;
    private bool KeyFindingsLocked => (_editor?.Nutrition ?? _editor?.Metagen)?.ReportStatusId == MultiCropSurveyStatus.Complete;
    private bool CanEditKeyFindings => _canEditOperations && !KeyFindingsLocked;
    private string KeyFindingEditorTitle => _keyFindingDraftId.HasValue ? "Edit key finding" : "Add key finding";
    private bool HasImportedResults => _importedLabResults.Count > 0;
    private bool CanImportResults => _editor?.Samples.Any(item => item.LabId != 6 && item.LabStatusId < 100) == true;
    private string ImportResultsButtonText => HasImportedResults ? "Import more results" : "Import results";
    private IReadOnlyList<UnifiedLabResultRow> SortedImportedLabResults => _importedLabResults
        .OrderByDescending(result => result.DateReceived ?? result.SurveyDate)
        .ThenBy(result => ResultTypeOrder(result.ResultType))
        .ThenBy(result => result.OrderNumber)
        .ToList();
    private IReadOnlyList<ImportedResultSummary> ImportedResultSummaries => _importedLabResults
        .GroupBy(result => result.ResultType)
        .Select(group => new ImportedResultSummary(group.Key, group.Count()))
        .OrderBy(summary => ResultTypeOrder(summary.ResultType))
        .ToList();
    private string ItemEditorTitle => _editingItem is null ? "Edit collected sample" : $"Edit collected sample {_editingItem.ItemId}";
    private IReadOnlyList<Lab> ExternalLaboratories => _editor?.Laboratories
        .Where(lab => lab.LabId != 6)
        .ToList() ?? [];
    private IReadOnlyList<LabTestType> AvailableLabTests => _editor?.LabTestTypes
        .Where(test => _itemEdit is not null && test.LabId == _itemEdit.LabId)
        .ToList() ?? [];
    private IReadOnlyList<SampleBlockChoice> BlockChoices => _editor?.Blocks
        .Select(block => new SampleBlockChoice(
            $"{block.BlockType?.ToLowerInvariant()}:{block.BlockId}",
            $"{block.BlockName} · {(string.Equals(block.BlockType, "banana", StringComparison.OrdinalIgnoreCase) ? "Banana" : "Multi-crop")}{(block.IsActive ? string.Empty : " · Inactive")}"))
        .ToList() ?? [];
    private bool CanSaveItem => !_itemBusy && _itemEdit is not null &&
        _itemEdit.CropTypeId > 0 && _itemEdit.LabId > 0 && _itemEdit.TestTypeId > 0 &&
        (_useTypedBlockName ? !string.IsNullOrWhiteSpace(_itemEdit.BlockName) : !string.IsNullOrWhiteSpace(_itemBlockKey));

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _loadError = null;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        _canEditOperations = user.IsInRole(MetaGrowRoles.Admin) || user.IsInRole(MetaGrowRoles.AgricultureManager) || user.IsInRole(MetaGrowRoles.Agronomist);
        _canEditFinance = user.IsInRole(MetaGrowRoles.Admin) || user.IsInRole(MetaGrowRoles.AgricultureManager) || user.IsInRole(MetaGrowRoles.Accountant);
        _canMoveStatuses = _canEditOperations;

        _editor = await TgsApi.GetSampleSurveyEditor(SurveyId);
        if (_editor is null) _loadError = TgsApi.ErrorMessage ?? "The Sample survey could not be loaded.";
        _labResultsLoading = _editor is not null;
        _loading = false;
        await InvokeAsync(StateHasChanged);

        if (_editor is not null)
            await LoadImportedLabResultsAsync();

        var (pending, _) = await Deletions.GetPendingAsync();
        _pendingDeletion = pending?.FirstOrDefault(item => item.SurveyId == SurveyId);
    }

    private async Task LoadImportedLabResultsAsync()
    {
        _labResultsLoading = true;
        _labResultsError = null;
        try
        {
            var soilTask = TgsApi.GetUnifiedLabSoil(null, null, SurveyId);
            var tissueTask = TgsApi.GetUnifiedLabTissue(null, null, SurveyId);
            var quickSoilTask = TgsApi.GetUnifiedLabQuickSoil(null, null, SurveyId);
            var sapTask = TgsApi.GetUnifiedLabSap(null, null, SurveyId);

            await Task.WhenAll((Task)soilTask, tissueTask, quickSoilTask, sapTask);

            _importedLabResults =
            [
                .. UnifiedLabResultPresentation.FromSoil(await soilTask ?? []),
                .. UnifiedLabResultPresentation.FromTissue(await tissueTask ?? []),
                .. UnifiedLabResultPresentation.FromQuickSoil(await quickSoilTask ?? []),
                .. UnifiedLabResultPresentation.FromSap(await sapTask ?? [])
            ];
        }
        catch (Exception exception)
        {
            _labResultsError = exception.Message;
            _importedLabResults = [];
        }
        finally
        {
            _labResultsLoading = false;
        }
    }

    private async Task OpenDeletionPreviewAsync()
    {
        if (_pendingDeletion is not null) return;
        _deletionPopupVisible = true;
        _deletionBusy = true;
        _deletionError = null;
        _deletionPreview = null;
        _deleteLinkedLabResults = false;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var accessToken = await ApiTokens.GetAccessTokenAsync(authenticationState.User);
            if (string.IsNullOrWhiteSpace(accessToken))
            {
                _deletionError = "Your session has expired. Sign in again before requesting deletion.";
                return;
            }
            _deletionPreview = await TgsApi.GetSampleSurveyDeletionPreview(SurveyId, accessToken);
            if (_deletionPreview is null)
                _deletionError = TgsApi.ErrorMessage ?? "The deletion safety check could not be completed.";
        }
        finally { _deletionBusy = false; }
    }

    private async Task RequestDeletionAsync()
    {
        if (_deletionPreview?.CanDelete != true || _deletionBusy) return;
        _deletionBusy = true;
        _deletionError = null;
        try
        {
            var (request, error) = await Deletions.RequestAsync(SurveyId, _deleteLinkedLabResults);
            if (request is null)
            {
                _deletionError = error ?? "The deletion request could not be submitted.";
                return;
            }
            _pendingDeletion = request;
            _deletionPopupVisible = false;
            ShowToast(
                "Deletion requested",
                _deleteLinkedLabResults
                    ? "The request includes permanent deletion of the linked lab data and can now be reviewed from the approval queue."
                    : "The request will preserve any linked lab data and can now be reviewed from the approval queue.",
                ToastRenderStyle.Success);
        }
        finally { _deletionBusy = false; }
    }

    private void CloseDeletionPopup()
    {
        if (_deletionBusy) return;
        _deletionPopupVisible = false;
        _deletionPreview = null;
        _deletionError = null;
        _deleteLinkedLabResults = false;
    }

    private async Task SaveAsync() => await SaveAsync(showSuccess: true);

    private void OpenNewKeyFindingEditor()
    {
        if (!CanEditKeyFindings || _keyFindingBusy) return;
        _keyFindingDraftId = null;
        _keyFindingDraftHtml = string.Empty;
        _keyFindingError = null;
        _keyFindingEditorVisible = true;
    }

    private void OpenKeyFindingEditor(SampleSurveyKeyFindingDto finding)
    {
        if (!CanEditKeyFindings || _keyFindingBusy) return;
        _keyFindingDraftId = finding.KeyPointId;
        _keyFindingDraftHtml = finding.Html;
        _keyFindingError = null;
        _keyFindingEditorVisible = true;
    }

    private void CloseKeyFindingEditor()
    {
        if (_keyFindingBusy) return;
        _keyFindingEditorVisible = false;
        _keyFindingDraftId = null;
        _keyFindingDraftHtml = string.Empty;
        _keyFindingError = null;
    }

    private async Task SaveKeyFindingAsync()
    {
        if (_editor is null || !CanEditKeyFindings || _keyFindingBusy) return;
        if (string.IsNullOrWhiteSpace(_keyFindingDraftHtml))
        {
            _keyFindingError = "Enter the key finding before saving.";
            return;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var accessToken = await ApiTokens.GetAccessTokenAsync(authenticationState.User);
        if (string.IsNullOrWhiteSpace(accessToken))
        {
            _keyFindingError = "Your session has expired. Sign in again before saving the key finding.";
            return;
        }

        _keyFindingBusy = true;
        _keyFindingError = null;
        try
        {
            var request = new SampleSurveyKeyFindingSaveRequest
            {
                Html = _keyFindingDraftHtml,
                ExpectedModificationDate = _editor.ModificationDate,
                ModifiedBy = authenticationState.User.Identity?.Name ?? "MetaGrow"
            };
            var updated = _keyFindingDraftId.HasValue
                ? await TgsApi.UpdateSampleSurveyKeyFinding(SurveyId, _keyFindingDraftId.Value, request, accessToken)
                : await TgsApi.AddSampleSurveyKeyFinding(SurveyId, request, accessToken);
            if (updated is null)
            {
                _keyFindingError = TgsApi.ErrorMessage ?? "The key finding could not be saved.";
                return;
            }

            ApplyKeyFindingResult(updated);
            _keyFindingEditorVisible = false;
            _keyFindingDraftId = null;
            _keyFindingDraftHtml = string.Empty;
            ShowToast("Key finding saved", "The report findings and audit history have been updated.", ToastRenderStyle.Success);
        }
        finally { _keyFindingBusy = false; }
    }

    private async Task MoveKeyFindingAsync(SampleSurveyKeyFindingDto finding, int direction)
    {
        if (_editor is null || !CanEditKeyFindings || _keyFindingBusy) return;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var accessToken = await ApiTokens.GetAccessTokenAsync(authenticationState.User);
        if (string.IsNullOrWhiteSpace(accessToken))
        {
            SetError("Your session has expired. Sign in again before moving the key finding.");
            return;
        }

        _keyFindingBusy = true;
        try
        {
            var updated = await TgsApi.MoveSampleSurveyKeyFinding(
                SurveyId,
                finding.KeyPointId,
                new SampleSurveyKeyFindingMoveRequest
                {
                    Direction = direction,
                    ExpectedModificationDate = _editor.ModificationDate,
                    ModifiedBy = authenticationState.User.Identity?.Name ?? "MetaGrow"
                },
                accessToken);
            if (updated is null)
            {
                SetError(TgsApi.ErrorMessage ?? "The key finding could not be moved.");
                return;
            }
            ApplyKeyFindingResult(updated);
        }
        finally { _keyFindingBusy = false; }
    }

    private void OpenKeyFindingDelete(SampleSurveyKeyFindingDto finding)
    {
        if (!CanEditKeyFindings || _keyFindingBusy) return;
        _keyFindingDeleteTarget = finding;
        _keyFindingDeleteVisible = true;
    }

    private void CloseKeyFindingDelete()
    {
        if (_keyFindingBusy) return;
        _keyFindingDeleteVisible = false;
        _keyFindingDeleteTarget = null;
    }

    private async Task DeleteKeyFindingAsync()
    {
        if (_editor is null || _keyFindingDeleteTarget is null || !CanEditKeyFindings || _keyFindingBusy) return;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var accessToken = await ApiTokens.GetAccessTokenAsync(authenticationState.User);
        if (string.IsNullOrWhiteSpace(accessToken))
        {
            SetError("Your session has expired. Sign in again before deleting the key finding.");
            return;
        }

        _keyFindingBusy = true;
        try
        {
            var updated = await TgsApi.DeleteSampleSurveyKeyFinding(
                SurveyId,
                _keyFindingDeleteTarget.KeyPointId,
                new SampleSurveyKeyFindingMutationRequest
                {
                    ExpectedModificationDate = _editor.ModificationDate,
                    ModifiedBy = authenticationState.User.Identity?.Name ?? "MetaGrow"
                },
                accessToken);
            if (updated is null)
            {
                SetError(TgsApi.ErrorMessage ?? "The key finding could not be deleted.");
                return;
            }
            ApplyKeyFindingResult(updated);
            _keyFindingDeleteVisible = false;
            _keyFindingDeleteTarget = null;
            ShowToast("Key finding deleted", "The finding was removed and the remaining findings were reordered.", ToastRenderStyle.Success);
        }
        finally { _keyFindingBusy = false; }
    }

    private void ApplyKeyFindingResult(SampleSurveyEditorDto updated)
    {
        if (_editor is null) return;
        _editor.KeyFindings = updated.KeyFindings;
        _editor.ModificationDate = updated.ModificationDate;
        _editor.ModifiedBy = updated.ModifiedBy;
    }

    private static void CustomizeKeyFindingToolbar(IToolbar toolbar)
    {
        toolbar.Groups.Clear();
        toolbar.Groups.Add(HtmlEditorToolbarGroupNames.UndoRedo);

        var font = toolbar.Groups.Add(HtmlEditorToolbarGroupNames.Font);
        font.Items.Clear();
        font.Items.Add(HtmlEditorToolbarItemNames.FontSize);
        font.Items.Add(HtmlEditorToolbarItemNames.FontBold);
        font.Items.Add(HtmlEditorToolbarItemNames.FontItalic);
        font.Items.Add(HtmlEditorToolbarItemNames.FontUnderline);
        font.Items.Add(HtmlEditorToolbarItemNames.ClearFormatting);

        var paragraph = toolbar.Groups.Add(HtmlEditorToolbarGroupNames.Paragraph);
        paragraph.Items.Clear();
        paragraph.Items.Add(HtmlEditorToolbarItemNames.BulletList);
        paragraph.Items.Add(HtmlEditorToolbarItemNames.NumberedList);
    }

    private async Task<bool> SaveAsync(bool showSuccess)
    {
        if (_editor is null || !ValidateEditor()) return false;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var accessToken = await ApiTokens.GetAccessTokenAsync(authenticationState.User);
        if (string.IsNullOrWhiteSpace(accessToken))
        {
            SetError("Your session has expired. Sign in again before saving the survey.");
            return false;
        }

        _busy = true;
        try
        {
            var updated = await TgsApi.UpdateSampleSurveyEditor(
                SurveyId,
                new SampleSurveyEditorUpdateRequest
                {
                    SurveyDate = _editor.SurveyDate,
                    AgronomistId = _editor.AgronomistId,
                    BillingEntityId = _editor.BillingEntityId,
                    SampleHours = _editor.SampleHours,
                    ReportHours = _editor.ReportHours,
                    GeneralNotes = _editor.GeneralNotes,
                    NotesForAccountant = _editor.NotesForAccountant,
                    NoPostageBags = _editor.NoPostageBags,
                    InvoiceNumber = _editor.InvoiceNumber,
                    InvoiceDate = _editor.InvoiceDate,
                    InvoiceNotes = _editor.InvoiceNotes,
                    InvoiceEmailedDate = _editor.InvoiceEmailedDate,
                    SurveyPurchaseOrderNumber = _editor.SurveyPurchaseOrderNumber,
                    ExpectedModificationDate = _editor.ModificationDate,
                    ModifiedBy = authenticationState.User.Identity?.Name ?? "MetaGrow"
                },
                accessToken);
            if (updated is null)
            {
                SetError(TgsApi.ErrorMessage ?? "The Sample survey could not be saved.");
                return false;
            }

            _editor = updated;
            if (showSuccess)
                ShowToast("Survey saved", "Sample survey changes saved.", ToastRenderStyle.Success);
            return true;
        }
        finally { _busy = false; }
    }

    private async Task TransitionAsync(SampleSurveyCategory category, SampleSurveyWorkflowAction action)
    {
        if (_editor is null || !await SaveAsync(showSuccess: false)) return;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var accessToken = await ApiTokens.GetAccessTokenAsync(authenticationState.User);
        if (string.IsNullOrWhiteSpace(accessToken))
        {
            SetError("Your session has expired. Sign in again before moving the survey status.");
            return;
        }

        _busy = true;
        try
        {
            var updated = await TgsApi.TransitionSampleSurvey(
                SurveyId,
                new SampleSurveyTransitionRequest
                {
                    Category = category,
                    Action = action,
                    ExpectedModificationDate = _editor.ModificationDate,
                    ModifiedBy = authenticationState.User.Identity?.Name ?? "MetaGrow"
                },
                accessToken);
            if (updated is null)
            {
                SetError(TgsApi.ErrorMessage ?? "The Sample survey status could not be changed.");
                return;
            }

            _editor = updated;
            var lane = category == SampleSurveyCategory.Metagen ? updated.Metagen : updated.Nutrition;
            ShowToast(
                "Status updated",
                $"{SampleSurveyCategoryNames.DisplayName(category)} moved to {lane?.WorkflowName.ToLowerInvariant() ?? "the next stage"}.",
                ToastRenderStyle.Success);
        }
        finally { _busy = false; }
    }

    private void OpenItemEditor(SampleSurveyItem item)
    {
        if (_editor is null || item.LabId == 6) return;

        var crop = _editor.Crops.FirstOrDefault(candidate => candidate.CropTypeId == item.CropTypeId);
        var expectedBlockType = crop is not null && (crop.CropTypeId == 1 || crop.ParentCropTypeId == 1)
            ? "banana"
            : "mcs";
        var block = _editor.Blocks.FirstOrDefault(candidate =>
                        candidate.BlockId == item.BlockId &&
                        string.Equals(candidate.BlockType, expectedBlockType, StringComparison.OrdinalIgnoreCase))
                    ?? _editor.Blocks.FirstOrDefault(candidate => candidate.BlockId == item.BlockId);

        _editingItem = item;
        _itemEdit = new SampleSurveyItemEditorUpdateRequest
        {
            BlockId = block?.BlockId ?? 0,
            BlockType = block?.BlockType,
            BlockName = block is null ? item.BlockName : null,
            CropTypeId = item.CropTypeId,
            LabId = item.LabId,
            TestTypeId = item.TestTypeId,
            IsBillable = item.IsBillable,
            Comments = item.Comments,
            LabReference = item.LabRefNo,
            ExpectedModificationDate = item.ModificationDate
        };
        _useTypedBlockName = block is null;
        _itemBlockKey = block is null ? null : $"{block.BlockType?.ToLowerInvariant()}:{block.BlockId}";
        _itemError = null;
        _itemEditorVisible = true;
    }

    private void ItemLaboratoryChanged(int labId)
    {
        if (_itemEdit is null) return;
        _itemEdit.LabId = labId;
        if (_editor?.LabTestTypes.Any(test => test.LabId == labId && test.LabTestTypeId == _itemEdit.TestTypeId) != true)
        {
            _itemEdit.TestTypeId = _editor?.LabTestTypes
                .Where(test => test.LabId == labId)
                .OrderBy(test => test.TestName)
                .Select(test => test.LabTestTypeId)
                .FirstOrDefault() ?? 0;
        }
    }

    private void CloseItemEditor()
    {
        if (_itemBusy) return;
        _itemEditorVisible = false;
        _editingItem = null;
        _itemEdit = null;
        _itemBlockKey = null;
        _itemError = null;
    }

    private async Task SaveItemAsync()
    {
        if (_editor is null || _editingItem is null || _itemEdit is null || !CanSaveItem) return;

        if (_useTypedBlockName)
        {
            _itemEdit.BlockId = 0;
            _itemEdit.BlockType = null;
            _itemEdit.BlockName = _itemEdit.BlockName?.Trim();
        }
        else
        {
            var keyParts = _itemBlockKey?.Split(':', 2);
            if (keyParts is null || keyParts.Length != 2 || !int.TryParse(keyParts[1], out var blockId))
            {
                _itemError = "Select a valid property block.";
                return;
            }
            _itemEdit.BlockId = blockId;
            _itemEdit.BlockType = keyParts[0];
            _itemEdit.BlockName = null;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var accessToken = await ApiTokens.GetAccessTokenAsync(authenticationState.User);
        if (string.IsNullOrWhiteSpace(accessToken))
        {
            _itemError = "Your session has expired. Sign in again before saving the sample.";
            return;
        }

        _itemEdit.ModifiedBy = authenticationState.User.Identity?.Name ?? "MetaGrow";
        _itemBusy = true;
        _itemError = null;
        try
        {
            var itemId = _editingItem.ItemId;
            var updated = await TgsApi.UpdateSampleSurveyItem(SurveyId, itemId, _itemEdit, accessToken);
            if (updated is null)
            {
                _itemError = TgsApi.ErrorMessage ?? "The collected sample could not be saved.";
                return;
            }

            _editor.Samples = updated.Samples;
            _editor.Metagen = updated.Metagen;
            _editor.Nutrition = updated.Nutrition;
            _editor.Blocks = updated.Blocks;
            _editor.Crops = updated.Crops;
            _editor.Laboratories = updated.Laboratories;
            _editor.LabTestTypes = updated.LabTestTypes;
            _editor.ModificationDate = updated.ModificationDate;
            _editor.ModifiedBy = updated.ModifiedBy;
            ShowToast("Sample saved", $"Collected sample {itemId} saved.", ToastRenderStyle.Success);
            _itemEditorVisible = false;
            _editingItem = null;
            _itemEdit = null;
            _itemBlockKey = null;
        }
        finally { _itemBusy = false; }
    }

    private bool ValidateEditor()
    {
        if (_editor is null) return false;
        if (_editor.SurveyDate == default) { SetError("Enter a survey date."); return false; }
        if (_editor.AgronomistId <= 0) { SetError("Select an agronomist."); return false; }
        if (_editor.BillingEntityId <= 0) { SetError("Select a billing entity."); return false; }
        if (!IsQuarterHour(_editor.SampleHours) || !IsQuarterHour(_editor.ReportHours))
        {
            SetError("Sample and report hours must be entered in quarter-hour increments.");
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_editor.InvoiceNumber) && !_editor.InvoiceDate.HasValue)
        {
            SetError("Enter the invoice date or clear the invoice number.");
            return false;
        }
        return true;
    }

    private static bool IsQuarterHour(double value) => value >= 0 && Math.Abs(value * 4 - Math.Round(value * 4)) < .0001;
    private void SetError(string message) =>
        ShowToast("Action could not be completed", message, ToastRenderStyle.Danger);
    private void ShowToast(string title, string text, ToastRenderStyle style) => ToastService.ShowToast(new ToastOptions
    {
        ProviderName = "SampleSurveyEditorMessages",
        Title = title,
        Text = text,
        RenderStyle = style,
        DisplayTime = TimeSpan.FromSeconds(10)
    });
    private void BackToSurveys() => Navigation.NavigateTo("/surveys/samples");
    private void ViewLabData() => Navigation.NavigateTo($"/surveys/samples/{SurveyId}/lab-results");
    private void ImportResults() => Navigation.NavigateTo($"/surveys/samples/{SurveyId}/import");
    private static int ResultTypeOrder(string resultType) => resultType switch
    {
        "Soil" => 0,
        "Tissue" => 1,
        "Quick Soil" => 2,
        "Sap" => 3,
        _ => 4
    };

    private sealed record ImportedResultSummary(string ResultType, int Count);
    private sealed record SampleBlockChoice(string Key, string Label);
}
