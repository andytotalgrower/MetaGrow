@page "/surveys/banana"
@using ApiModels
@using ApiModels.MetaGrow
@using ApiModels.Realtime
@using MetaGrow.Shared
@using MetaGrow.Web.Services
@using Metagen.Shared.Services
@using System.Text.Json
@implements IDisposable
@attribute [Authorize(Roles = MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager + "," + MetaGrowRoles.Agronomist)]
@inject ITgsApiService TgsApi
@inject IJSRuntime JS
@inject IRealtimeChangeNotifier RealtimeChanges

<PageTitle>Banana surveys | MetaGrow</PageTitle>

<div class="banana-page">
    <div class="title">
        <div class="title-header-text">Banana surveys</div>
        <div class="title-content-text">Find an existing banana survey and continue its review.</div>
    </div>

    <section class="filter-panel" aria-labelledby="banana-search-heading">
        <div class="filter-heading">
            <div>
                <h2 id="banana-search-heading">Find surveys</h2>
                <p>Choose the survey period, then narrow the results by property or status.</p>
            </div>
            <div class="filter-actions">
                <DxButton Text="Clear" RenderStyle="ButtonRenderStyle.Secondary" Click="ClearFiltersAsync" Enabled="@(!_loading)" />
                <DxButton Text="Search" RenderStyle="ButtonRenderStyle.Primary" Click="SearchAsync" Enabled="@(!_loading)" />
            </div>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="banana-start-date">From</label>
                <DxDateEdit Id="banana-start-date" @bind-Date="_startDate" @bind-Date:after="DateRangeChangedAsync" DisplayFormat="dd/MM/yyyy" />
            </div>
            <div class="filter-field">
                <label for="banana-end-date">To</label>
                <DxDateEdit Id="banana-end-date" @bind-Date="_endDate" @bind-Date:after="DateRangeChangedAsync" DisplayFormat="dd/MM/yyyy" />
            </div>
            <div class="filter-field property-filter">
                <label for="banana-property">Property</label>
                <DxTextBox Id="banana-property" @bind-Text="_propertySearch" @bind-Text:after="PropertySearchChangedAsync"
                           NullText="Type a property name" BindValueMode="BindValueMode.OnDelayedInput" InputDelay="300"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </div>
            <div class="filter-field">
                <label for="banana-status">Status</label>
                <DxComboBox Id="banana-status" Data="@StatusOptions" @bind-Value="_statusId" @bind-Value:after="SaveFiltersAsync"
                            TextFieldName="@nameof(StatusOption.StatusName)" ValueFieldName="@nameof(StatusOption.StatusId)"
                            NullText="All statuses" AllowUserInput="false"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </div>
        </div>
    </section>

    @if (_loading)
    {
        <div class="loading-state" role="status">
            <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
            <span>Loading banana surveys...</span>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Surveys could not be loaded.</strong> @_errorMessage
        </div>
    }
    else
    {
        <div class="result-heading">
            <div>
                <h2>Results</h2>
                <span>@ResultSummary</span>
            </div>
            @if (_surveys.Count > 0)
            {
                <DxButton Text="Choose columns" RenderStyle="ButtonRenderStyle.Secondary" Click="ShowColumnChooser" CssClass="desktop-only" />
            }
        </div>

        @if (_surveys.Count == 0)
        {
            <div class="empty-state">
                <strong>No surveys were found.</strong>
                <span>Try a wider date range.</span>
            </div>
        }
        else if (FilteredSurveys.Count == 0)
        {
            <div class="empty-state">
                <strong>No surveys match the current filters.</strong>
                <span>Clear the property or status filter to see more results.</span>
            </div>
        }
        else
        {
            <div class="desktop-results">
                <DxGrid @ref="_grid" Data="@FilteredSurveys" PageSize="20" ShowAllRows="false"
                        TextWrapEnabled="false" HighlightRowOnHover="true" ColumnResizeMode="GridColumnResizeMode.NextColumn"
                        CssClass="banana-grid">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.SurveyDate)" Caption="Date" Width="110px" DisplayFormat="dd/MM/yyyy" />
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.PropertyName)" Caption="Property" MinWidth="190" />
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.AgronomistName)" Caption="Agronomist" MinWidth="150" />
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.StatusName)" Caption="Status" Width="150px">
                            <CellDisplayTemplate Context="cell">
                                @{ var survey = (BananaSurveySummaryDto)cell.DataItem; }
                                <span class="status-badge @MultiCropSurveyFilter.StatusBadgeClass(survey.StatusName)">@survey.StatusName</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.LeafCount)" Caption="Leaf" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.IsBwbSurvey)" Caption="BWB" Width="70px">
                            <CellDisplayTemplate Context="cell">@Flag(((BananaSurveySummaryDto)cell.DataItem).IsBwbSurvey)</CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.IsPhmbSurvey)" Caption="PHMB" Width="75px">
                            <CellDisplayTemplate Context="cell">@Flag(((BananaSurveySummaryDto)cell.DataItem).IsPhmbSurvey)</CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.IsSoilHealthSurvey)" Caption="Soil Hlth" Width="85px">
                            <CellDisplayTemplate Context="cell">@Flag(((BananaSurveySummaryDto)cell.DataItem).IsSoilHealthSurvey)</CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.PhotoCount)" Caption="Photos" Width="75px" />
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.LastModified)" Caption="Modified" Width="110px" DisplayFormat="dd/MM/yyyy" Visible="false" />
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.SurveyHours)" Caption="Survey hours" Width="110px" DisplayFormat="N2" Visible="false" />
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.ReportHours)" Caption="Report hours" Width="110px" DisplayFormat="N2" Visible="false" />
                        <DxGridDataColumn FieldName="@nameof(BananaSurveySummaryDto.ModifiedBy)" Caption="Modified by" MinWidth="150" Visible="false" />
                        <DxGridDataColumn Caption="Actions" Width="150px" AllowSort="false">
                            <CellDisplayTemplate Context="cell">
                                @{ var survey = (BananaSurveySummaryDto)cell.DataItem; }
                                <div class="mg-grid-actions" role="group" aria-label="Survey actions">
                                    <DxButton NavigateUrl="@EditSurveyUrl(survey)"
                                              aria-label="Edit survey" title="Edit survey"
                                              RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                              SizeMode="SizeMode.Small" CssClass="mg-grid-icon-button" IconCssClass="oi oi-pencil" />
                                    <DxButton NavigateUrl="@OnlineReportUrl(survey)"
                                              aria-label="View online report" title="View online report"
                                              RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                              SizeMode="SizeMode.Small" CssClass="mg-grid-icon-button" IconCssClass="oi oi-external-link" />
                                    <DxButton NavigateUrl="@PrintReportUrl(survey)"
                                              aria-label="Print report" title="Print report"
                                              RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                              SizeMode="SizeMode.Small" CssClass="mg-grid-icon-button" IconCssClass="oi oi-print" />
                                    <DxButton aria-label="Delete survey" title="Delete survey"
                                              RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                              SizeMode="SizeMode.Small" CssClass="mg-grid-icon-button" IconCssClass="oi oi-trash"
                                              Click="@(() => _deletionPopup!.ShowAsync(MetaGrowSurveyType.Banana, survey.SurveyId))" />
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>
                </DxGrid>
            </div>

            <div class="mobile-results">
                @foreach (var survey in FilteredSurveys)
                {
                    <article class="survey-card">
                        <div class="survey-card-heading">
                            <div>
                                <strong>@survey.PropertyName</strong>
                                <span>@survey.SurveyDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <span class="status-badge @MultiCropSurveyFilter.StatusBadgeClass(survey.StatusName)">@survey.StatusName</span>
                        </div>
                        <dl>
                            <div><dt>Agronomist</dt><dd>@survey.AgronomistName</dd></div>
                            <div><dt>Leaf records</dt><dd>@survey.LeafCount</dd></div>
                            <div><dt>Survey types</dt><dd>@SurveyTypeSummary(survey)</dd></div>
                            <div><dt>Photos</dt><dd>@survey.PhotoCount</dd></div>
                        </dl>
                        <div class="survey-card-actions">
                            <a class="btn btn-primary" href="@EditSurveyUrl(survey)">Edit survey</a>
                            <a class="btn btn-outline-secondary" href="@OnlineReportUrl(survey)">Online report</a>
                            <a class="btn btn-outline-secondary" href="@PrintReportUrl(survey)">Print report</a>
                            <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger"
                                      Click="@(() => _deletionPopup!.ShowAsync(MetaGrowSurveyType.Banana, survey.SurveyId))" />
                        </div>
                    </article>
                }
            </div>
        }
    }
</div>

<SurveyDeletionRequestPopup @ref="_deletionPopup" />

@code {
    [SupplyParameterFromQuery(Name = "property")]
    public string? RequestedProperty { get; set; }

    [SupplyParameterFromQuery(Name = "propertyId")]
    public int? RequestedPropertyId { get; set; }

    private IGrid? _grid;
    private const string FilterCookieName = "metagrow.banana.filters";
    private readonly DateTime _today = DateTime.Today;
    private DateTime _startDate;
    private DateTime _endDate;
    private string? _propertySearch;
    private int? _statusId;
    private bool _loading = true;
    private string? _errorMessage;
    private List<BananaSurveySummaryDto> _surveys = [];
    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private IDisposable? _realtimeSubscription;
    private CancellationTokenSource? _realtimeRefreshCancellation;
    private SurveyDeletionRequestPopup? _deletionPopup;

    private sealed record StatusOption(int StatusId, string StatusName);

    private IReadOnlyList<StatusOption> StatusOptions => _surveys
        .GroupBy(survey => new { survey.StatusId, survey.StatusName })
        .Select(group => new StatusOption(group.Key.StatusId, group.Key.StatusName))
        .OrderBy(status => status.StatusName)
        .ToList();

    private IReadOnlyList<BananaSurveySummaryDto> FilteredSurveys =>
        BananaSurveyFilter.Apply(_surveys, _propertySearch, _statusId)
            .Where(survey => RequestedPropertyId is null || survey.PropertyId == RequestedPropertyId)
            .ToList();

    private string ResultSummary => FilteredSurveys.Count == _surveys.Count
        ? $"{_surveys.Count} survey{(_surveys.Count == 1 ? string.Empty : "s")}"
        : $"{FilteredSurveys.Count} of {_surveys.Count} surveys";

    protected override void OnInitialized()
    {
        ApplyFilters(BananaSurveyFilterPreferences.CreateDefault(_today));
        _realtimeSubscription = RealtimeChanges.Subscribe(HandleRealtimeChangeAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RestoreFiltersAsync();
        ApplyLinkedPropertyFilter();
        await LoadSurveysAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyLinkedPropertyFilter()
    {
        if (string.IsNullOrWhiteSpace(RequestedProperty)) return;

        _startDate = new DateTime(1990, 1, 1);
        _endDate = _today;
        _propertySearch = RequestedProperty.Trim();
        _statusId = null;
    }

    private async Task LoadSurveysAsync()
    {
        if (_endDate.Date < _startDate.Date)
        {
            _errorMessage = "The end date must be on or after the start date.";
            return;
        }

        await _loadGate.WaitAsync();
        try
        {
            _loading = true;
            _errorMessage = null;
            try
            {
                var surveys = await TgsApi.GetBananaSurveySummaries(_startDate.Date, _endDate.Date);
                _surveys = surveys ?? [];
                _errorMessage = surveys is null
                    ? TgsApi.ErrorMessage ?? "The banana surveys could not be loaded from the TGS API."
                    : null;
            }
            finally
            {
                _loading = false;
            }
        }
        finally
        {
            _loadGate.Release();
        }
    }

    private Task HandleRealtimeChangeAsync(RealtimeEventEnvelope message)
    {
        if (!RealtimeEventFilters.IsSurveyChangeFor(message, RealtimeSurveyTypes.Banana))
            return Task.CompletedTask;

        var cancellation = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref _realtimeRefreshCancellation, cancellation);
        previous?.Cancel();
        previous?.Dispose();
        _ = RefreshAfterRealtimeChangeAsync(cancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RefreshAfterRealtimeChangeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(500), cancellationToken);
            await InvokeAsync(async () =>
            {
                await LoadSurveysAsync();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task SearchAsync()
    {
        await SaveFiltersAsync();
        await LoadSurveysAsync();
    }

    private async Task DateRangeChangedAsync()
    {
        await SaveFiltersAsync();
        await LoadSurveysAsync();
    }

    private async Task ClearFiltersAsync()
    {
        RequestedPropertyId = null;
        ApplyFilters(BananaSurveyFilterPreferences.CreateDefault(_today));
        await SaveFiltersAsync();
        await LoadSurveysAsync();
    }

    private async Task PropertySearchChangedAsync()
    {
        RequestedPropertyId = null;
        await SaveFiltersAsync();
    }

    // Saved filters are still written to the cookie, but they are no longer restored:
    // a stale end date made the dashboard look empty on the next visit.
    private Task RestoreFiltersAsync()
    {
        ApplyFilters(BananaSurveyFilterPreferences.CreateDefault(_today));
        return Task.CompletedTask;
    }

    private async Task SaveFiltersAsync()
    {
        var filters = new BananaSurveyFilterPreferences(
            _startDate.Date,
            _endDate.Date,
            _propertySearch,
            _statusId);
        await JS.InvokeVoidAsync(
            "metaGrowFilterPreferences.set",
            FilterCookieName,
            JsonSerializer.Serialize(filters));
    }

    private void ApplyFilters(BananaSurveyFilterPreferences filters)
    {
        _startDate = filters.StartDate.Date;
        _endDate = filters.EndDate.Date;
        _propertySearch = filters.PropertySearch;
        _statusId = filters.StatusId;
    }

    private void ShowColumnChooser() => _grid?.ShowColumnChooser();
    private static string EditSurveyUrl(BananaSurveySummaryDto survey) => $"/surveys/banana/{survey.SurveyId}/edit";
    private static string OnlineReportUrl(BananaSurveySummaryDto survey) => $"/surveys/banana/{survey.SurveyId}/report";
    private static string PrintReportUrl(BananaSurveySummaryDto survey) => $"/surveys/banana/{survey.SurveyId}/report?print=true";
    private static string Flag(bool value) => value ? "Yes" : "—";

    private static string SurveyTypeSummary(BananaSurveySummaryDto survey)
    {
        var types = new List<string>();
        if (survey.IsBwbSurvey) types.Add("BWB");
        if (survey.IsPhmbSurvey) types.Add("PHMB");
        if (survey.IsSoilHealthSurvey) types.Add("Soil health");
        return types.Count == 0 ? "Standard" : string.Join(", ", types);
    }

    public void Dispose()
    {
        _realtimeSubscription?.Dispose();
        var cancellation = Interlocked.Exchange(ref _realtimeRefreshCancellation, null);
        cancellation?.Cancel();
        cancellation?.Dispose();
    }
}
