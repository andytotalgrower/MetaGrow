@page "/surveys/multicrop"
@using ApiModels
@using ApiModels.MetaGrow
@using ApiModels.Realtime
@using MetaGrow.Shared
@using MetaGrow.Web.Services
@using Metagen.Shared.Services
@using System.Text.Json
@implements IDisposable
@attribute [Authorize(Roles = MetaGrowRoles.Admin + "," + MetaGrowRoles.AgricultureManager + "," + MetaGrowRoles.Agronomist)]
@inject ITgsApiService TgsApi
@inject IJSRuntime JS
@inject IRealtimeChangeNotifier RealtimeChanges

<PageTitle>Multi-crop surveys | MetaGrow</PageTitle>

<div class="multicrop-page">
    <div class="title">
        <div class="title-header-text">Multi-crop surveys</div>
        <div class="title-content-text">Find an existing survey and open its online or printable report.</div>
    </div>

    <section class="filter-panel" aria-labelledby="survey-search-heading">
        <div class="filter-heading">
            <div>
                <h2 id="survey-search-heading">Find surveys</h2>
                <p>Choose the survey period, then narrow the results by property or survey type.</p>
            </div>
            <div class="filter-actions">
                <DxButton Text="Clear" RenderStyle="ButtonRenderStyle.Secondary" Click="ClearFiltersAsync" Enabled="@(!_loading)" />
                <DxButton Text="Search" RenderStyle="ButtonRenderStyle.Primary" Click="SearchAsync" Enabled="@(!_loading)" />
            </div>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="survey-start-date">From</label>
                <DxDateEdit Id="survey-start-date" @bind-Date="_startDate" @bind-Date:after="DateRangeChangedAsync" DisplayFormat="dd/MM/yyyy" />
            </div>
            <div class="filter-field">
                <label for="survey-end-date">To</label>
                <DxDateEdit Id="survey-end-date" @bind-Date="_endDate" @bind-Date:after="DateRangeChangedAsync" DisplayFormat="dd/MM/yyyy" />
            </div>
            <div class="filter-field property-filter">
                <label for="survey-property">Property</label>
                <DxTextBox Id="survey-property" @bind-Text="_propertySearch" @bind-Text:after="PropertySearchChangedAsync" NullText="Type a property name"
                           BindValueMode="BindValueMode.OnDelayedInput" InputDelay="300" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </div>
            <div class="filter-field">
                <label for="survey-type">Survey type</label>
                <DxComboBox Id="survey-type" Data="@_surveyTypes" @bind-Value="_applicationId" @bind-Value:after="SaveFiltersAsync"
                            TextFieldName="@nameof(MultiCropSurveyTypeDto.ApplicationName)"
                            ValueFieldName="@nameof(MultiCropSurveyTypeDto.ApplicationId)"
                            NullText="All survey types" AllowUserInput="false"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </div>
            <div class="filter-field">
                <label for="survey-status">Status</label>
                <DxComboBox Id="survey-status" Data="@StatusOptions" @bind-Value="_statusId" @bind-Value:after="SaveFiltersAsync"
                            TextFieldName="@nameof(StatusOption.StatusName)"
                            ValueFieldName="@nameof(StatusOption.StatusId)"
                            NullText="All statuses" AllowUserInput="false"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </div>
        </div>
    </section>

    @if (_loading)
    {
        <div class="loading-state" role="status">
            <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
            <span>Loading multi-crop surveys…</span>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Surveys could not be loaded.</strong> @_errorMessage
        </div>
    }
    else
    {
        <div class="result-heading">
            <div>
                <h2>Results</h2>
                <span>@ResultSummary</span>
            </div>
            @if (_surveys.Count > 0)
            {
                <DxButton Text="Choose columns" RenderStyle="ButtonRenderStyle.Secondary" Click="ShowColumnChooser" CssClass="desktop-only" />
            }
        </div>

        @if (_surveys.Count == 0)
        {
            <div class="empty-state">
                <strong>No surveys were found.</strong>
                <span>Try a wider date range.</span>
            </div>
        }
        else if (FilteredSurveys.Count == 0)
        {
            <div class="empty-state">
                <strong>No surveys match the current filters.</strong>
                <span>Clear the property, survey type or status filter to see more results.</span>
            </div>
        }
        else
        {
            <div class="desktop-results">
                <DxGrid @ref="_grid" Data="@FilteredSurveys" PageSize="20" ShowAllRows="false"
                        TextWrapEnabled="false" HighlightRowOnHover="true" ColumnResizeMode="GridColumnResizeMode.NextColumn"
                        CssClass="multicrop-grid">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.SurveyDate)" Caption="Date" Width="110px"
                                          DisplayFormat="dd/MM/yyyy" />
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.PropertyName)" Caption="Property" MinWidth="180" />
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.ApplicationName)" Caption="Survey type" MinWidth="140" />
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.CropTypeName)" Caption="Crop" MinWidth="120" />
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.AgronomistName)" Caption="Agronomist" MinWidth="150" />
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.StatusName)" Caption="Status" Width="150px">
                            <CellDisplayTemplate Context="cell">
                                @{ var statusName = (cell.DataItem as MultiCropSurveySummaryDto)?.StatusName; }
                                <span class="status-badge @MultiCropSurveyFilter.StatusBadgeClass(statusName)">@statusName</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.PhotoCount)" Caption="Photos" Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.LastModified)" Caption="Modified" Width="110px" DisplayFormat="dd/MM/yyyy" />
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.SurveyHours)" Caption="Survey hours" Width="110px" DisplayFormat="N2" Visible="false" />
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.ReportHours)" Caption="Report hours" Width="110px" DisplayFormat="N2" Visible="false" />
                        <DxGridDataColumn FieldName="@nameof(MultiCropSurveySummaryDto.ModifiedBy)" Caption="Modified by" MinWidth="150" Visible="false" />
                        <DxGridDataColumn Caption="Actions" Width="155px" AllowSort="false">
                            <CellDisplayTemplate Context="cell">
                                @{ var survey = (MultiCropSurveySummaryDto)cell.DataItem; }
                                <div class="mg-grid-actions">
                                    <a class="mg-grid-link" href="@EditSurveyUrl(survey)">Edit</a>
                                    <a class="mg-grid-link" href="@OnlineReportUrl(survey)">Online</a>
                                    <a class="mg-grid-link" href="@PrintReportUrl(survey)">Print</a>
                                    <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger" SizeMode="SizeMode.Small"
                                              Click="@(() => _deletionPopup!.ShowAsync(MetaGrowSurveyType.MultiCrop, survey.SurveyId))" />
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>
                </DxGrid>
            </div>

            <div class="mobile-results">
                @foreach (var survey in FilteredSurveys)
                {
                    <article class="survey-card">
                        <div class="survey-card-heading">
                            <div>
                                <strong>@survey.PropertyName</strong>
                                <span>@survey.SurveyDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <span class="status-badge @MultiCropSurveyFilter.StatusBadgeClass(survey.StatusName)">@survey.StatusName</span>
                        </div>
                        <dl>
                            <div><dt>Type</dt><dd>@survey.ApplicationName</dd></div>
                            <div><dt>Crop</dt><dd>@survey.CropTypeName</dd></div>
                            <div><dt>Agronomist</dt><dd>@survey.AgronomistName</dd></div>
                            <div><dt>Photos</dt><dd>@survey.PhotoCount</dd></div>
                        </dl>
                        <div class="survey-card-actions">
                            <a class="btn btn-primary" href="@EditSurveyUrl(survey)">Edit survey</a>
                            <a class="btn btn-outline-secondary" href="@OnlineReportUrl(survey)">Online report</a>
                            <a class="btn btn-outline-secondary" href="@PrintReportUrl(survey)">Print report</a>
                            <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger"
                                      Click="@(() => _deletionPopup!.ShowAsync(MetaGrowSurveyType.MultiCrop, survey.SurveyId))" />
                        </div>
                    </article>
                }
            </div>
        }
    }
</div>

<SurveyDeletionRequestPopup @ref="_deletionPopup" />

@code {
    [SupplyParameterFromQuery(Name = "property")]
    public string? RequestedProperty { get; set; }

    [SupplyParameterFromQuery(Name = "propertyId")]
    public int? RequestedPropertyId { get; set; }

    private IGrid? _grid;
    private const string FilterCookieName = "metagrow.multicrop.filters";
    private readonly DateTime _today = DateTime.Today;
    private DateTime _startDate;
    private DateTime _endDate;
    private string? _propertySearch;
    private int? _applicationId;
    private int? _statusId;
    private bool _loading = true;
    private string? _errorMessage;
    private List<MultiCropSurveySummaryDto> _surveys = [];
    private List<MultiCropSurveyTypeDto> _surveyTypes = [];
    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private IDisposable? _realtimeSubscription;
    private CancellationTokenSource? _realtimeRefreshCancellation;
    private SurveyDeletionRequestPopup? _deletionPopup;

    private sealed record StatusOption(int StatusId, string StatusName);

    private IReadOnlyList<StatusOption> StatusOptions => _surveys
        .GroupBy(survey => new { survey.StatusId, survey.StatusName })
        .Select(group => new StatusOption(group.Key.StatusId, group.Key.StatusName))
        .OrderBy(status => status.StatusName)
        .ToList();

    private IReadOnlyList<MultiCropSurveySummaryDto> FilteredSurveys =>
        MultiCropSurveyFilter.Apply(_surveys, _propertySearch, _applicationId, _statusId)
            .Where(survey => RequestedPropertyId is null || survey.PropertyId == RequestedPropertyId)
            .ToList();

    private string ResultSummary => FilteredSurveys.Count == _surveys.Count
        ? $"{_surveys.Count} survey{(_surveys.Count == 1 ? string.Empty : "s")}"
        : $"{FilteredSurveys.Count} of {_surveys.Count} surveys";

    protected override async Task OnInitializedAsync()
    {
        ApplyFilters(MultiCropSurveyFilterPreferences.CreateDefault(_today));
        _realtimeSubscription = RealtimeChanges.Subscribe(HandleRealtimeChangeAsync);
        _surveyTypes = await TgsApi.GetMultiCropSurveyTypes() ?? [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await RestoreFiltersAsync();
        ApplyLinkedPropertyFilter();
        await LoadSurveysAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyLinkedPropertyFilter()
    {
        if (string.IsNullOrWhiteSpace(RequestedProperty)) return;

        _startDate = new DateTime(1990, 1, 1);
        _endDate = _today;
        _propertySearch = RequestedProperty.Trim();
        _applicationId = null;
        _statusId = null;
    }

    private async Task LoadSurveysAsync()
    {
        if (_endDate.Date < _startDate.Date)
        {
            _errorMessage = "The end date must be on or after the start date.";
            return;
        }

        await _loadGate.WaitAsync();
        try
        {
            _loading = true;
            _errorMessage = null;
            try
            {
                var surveys = await TgsApi.GetMultiCropSurveySummaries(_startDate.Date, _endDate.Date);
                _surveys = surveys ?? [];
                _errorMessage = surveys is null
                    ? TgsApi.ErrorMessage ?? "The multi-crop surveys could not be loaded from the TGS API."
                    : null;

                if (_surveyTypes.Count == 0 && _surveys.Count > 0)
                {
                    _surveyTypes = _surveys
                        .GroupBy(survey => new { survey.ApplicationId, survey.ApplicationName })
                        .Select(group => new MultiCropSurveyTypeDto
                        {
                            ApplicationId = group.Key.ApplicationId,
                            ApplicationName = group.Key.ApplicationName
                        })
                        .OrderBy(type => type.ApplicationName)
                        .ToList();
                }
            }
            finally
            {
                _loading = false;
            }
        }
        finally
        {
            _loadGate.Release();
        }
    }

    private Task HandleRealtimeChangeAsync(RealtimeEventEnvelope message)
    {
        if (!RealtimeEventFilters.IsSurveyChangeFor(message, RealtimeSurveyTypes.MultiCrop))
            return Task.CompletedTask;

        var cancellation = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref _realtimeRefreshCancellation, cancellation);
        previous?.Cancel();
        previous?.Dispose();
        _ = RefreshAfterRealtimeChangeAsync(cancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RefreshAfterRealtimeChangeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(500), cancellationToken);
            await InvokeAsync(async () =>
            {
                await LoadSurveysAsync();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task SearchAsync()
    {
        await SaveFiltersAsync();
        await LoadSurveysAsync();
    }

    private async Task DateRangeChangedAsync()
    {
        await SaveFiltersAsync();
        await LoadSurveysAsync();
    }

    private async Task ClearFiltersAsync()
    {
        RequestedPropertyId = null;
        ApplyFilters(MultiCropSurveyFilterPreferences.CreateDefault(_today));
        await SaveFiltersAsync();
        await LoadSurveysAsync();
    }

    private async Task PropertySearchChangedAsync()
    {
        RequestedPropertyId = null;
        await SaveFiltersAsync();
    }

    private async Task RestoreFiltersAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("metaGrowFilterPreferences.get", FilterCookieName);
            if (string.IsNullOrWhiteSpace(json))
            {
                return;
            }

            var filters = JsonSerializer.Deserialize<MultiCropSurveyFilterPreferences>(json);
            if (filters?.HasValidDateRange == true)
            {
                ApplyFilters(filters);
            }
        }
        catch (JsonException)
        {
            ApplyFilters(MultiCropSurveyFilterPreferences.CreateDefault(_today));
        }
    }

    private async Task SaveFiltersAsync()
    {
        var filters = new MultiCropSurveyFilterPreferences(
            _startDate.Date,
            _endDate.Date,
            _propertySearch,
            _applicationId,
            _statusId);
        var json = JsonSerializer.Serialize(filters);
        await JS.InvokeVoidAsync("metaGrowFilterPreferences.set", FilterCookieName, json);
    }

    private void ApplyFilters(MultiCropSurveyFilterPreferences filters)
    {
        _startDate = filters.StartDate.Date;
        _endDate = filters.EndDate.Date;
        _propertySearch = filters.PropertySearch;
        _applicationId = filters.ApplicationId;
        _statusId = filters.StatusId;
    }

    private void ShowColumnChooser() => _grid?.ShowColumnChooser();
    private static string EditSurveyUrl(MultiCropSurveySummaryDto survey) => $"/surveys/multicrop/{survey.SurveyId}/edit";
    private static string OnlineReportUrl(MultiCropSurveySummaryDto survey) => $"/surveys/multicrop/{survey.SurveyId}/report";
    private static string PrintReportUrl(MultiCropSurveySummaryDto survey) => $"/surveys/multicrop/{survey.SurveyId}/report?print=true";

    public void Dispose()
    {
        _realtimeSubscription?.Dispose();
        var cancellation = Interlocked.Exchange(ref _realtimeRefreshCancellation, null);
        cancellation?.Cancel();
        cancellation?.Dispose();
    }
}
