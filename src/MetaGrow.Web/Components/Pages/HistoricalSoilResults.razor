    private async Task<string?> GetAccessTokenAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var token = await ApiTokens.GetAccessTokenAsync(authenticationState.User);
        if (!string.IsNullOrWhiteSpace(token)) return token;
        _dialogError = "Your session has expired. Sign in again before changing historical Soil data.";
        return null;
    }

    private void CaptureExpandedRows()
    {
        _expandedGroupKeys.Clear();
        if (_historicalGrid is null) return;

        for (var visibleIndex = 0; visibleIndex < _historicalGrid.GetVisibleRowCount(); visibleIndex++)
        {
            if (_historicalGrid.IsDetailRowExpanded(visibleIndex) &&
                _historicalGrid.GetDataItem(visibleIndex) is HistoricalSoilResultGroupDto group)
            {
                _expandedGroupKeys.Add(group.GroupKey);
            }
        }
    }

    private void CloseMapping() { if (!_mappingBusy) _mappingVisible = false; }
    private void CloseGeneration() { if (!_generationBusy) _generationVisible = false; }
    private void ShowToast(string title, string message, ToastRenderStyle renderStyle)
    {
        ToastService.ShowToast(new ToastOptions
        {
            ProviderName = "HistoricalSoilMessages",
            Title = title,
            Text = message,
            RenderStyle = renderStyle,
            DisplayTime = TimeSpan.FromSeconds(5)
        });
    }
    private static bool Contains(string? source, string? value) => !string.IsNullOrWhiteSpace(source) && !string.IsNullOrWhiteSpace(value) && source.Contains(value.Trim(), StringComparison.OrdinalIgnoreCase);
    private static List<HistoricalSoilResultItemDto> GetDistinctUnmappedResults(HistoricalSoilResultGroupDto group) => group.Results
        .Where(item => !item.IsMapped)
        .GroupBy(RawMappingKey, StringComparer.OrdinalIgnoreCase)
        .Select(items => items.First())
        .OrderBy(item => item.RawFieldReference)
        .ThenBy(item => item.RawCropName)
        .ToList();
    private static string RawMappingKey(HistoricalSoilResultItemDto item) =>
        string.Join("\u001f", item.RawCustomerName?.Trim() ?? string.Empty, item.RawFieldReference?.Trim() ?? string.Empty, item.RawCropName?.Trim() ?? string.Empty);
    private int CountMatchingRawRows(HistoricalSoilResultItemDto selected) => _groups
        .SelectMany(group => group.Results)
        .Count(item => SameRawValue(item.RawCustomerName, selected.RawCustomerName) &&
                       SameRawValue(item.RawFieldReference, selected.RawFieldReference) &&
                       SameRawValue(item.RawCropName, selected.RawCropName));
    private static bool SameRawValue(string? left, string? right) => string.Equals(left?.Trim() ?? string.Empty, right?.Trim() ?? string.Empty, StringComparison.OrdinalIgnoreCase);
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();
}
