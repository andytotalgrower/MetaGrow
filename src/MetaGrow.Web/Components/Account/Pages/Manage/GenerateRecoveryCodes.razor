@page "/Account/Manage/GenerateRecoveryCodes"
@attribute [Authorize]
@inject AccountApiClient Api
<PageTitle>Recovery codes | MetaGrow</PageTitle>

<a class="settings-back-link" href="Account/Manage/TwoFactorAuthentication"><span class="icon icon-back" aria-hidden="true"></span> Back to two-factor authentication</a>
<h3>Recovery codes</h3>
<p class="settings-page-intro">Create a fresh set of one-time codes for emergency account access.</p>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
@if (codes is null)
{
    <div class="alert alert-warning">
        <strong>Put these codes in a safe place.</strong>
        Generating new codes invalidates any previous recovery codes.
    </div>
    <EditForm Model="model" method="post" OnValidSubmit="Generate" FormName="generate-codes">
        <DxButton SubmitFormOnClick="true" Text="Generate new recovery codes" RenderStyle="ButtonRenderStyle.Danger" />
    </EditForm>
}
else
{
    <div class="alert alert-warning"><strong>Save these codes now.</strong> They will not be shown again.</div>
    <ul class="recovery-code-list">
        @foreach (var recoveryCode in codes)
        {
            <li><kbd>@recoveryCode</kbd></li>
        }
    </ul>
}
@code { private readonly object model=new(); private string[]? codes; private string? error; private async Task Generate(){var result=await Api.NewRecoveryCodesAsync();codes=result.Item1?.RecoveryCodes;error=result.Item2;} }
