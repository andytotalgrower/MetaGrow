@page "/Account/Manage/ResetAuthenticator"
@attribute [Authorize]
@inject AccountApiClient Api
@inject MfaFlowState MfaFlow
<PageTitle>Reset authenticator | MetaGrow</PageTitle>
<div class="main-content"><div class="block-content"><div class="title"><div class="title-header-text">Reset authenticator</div></div>
    <div class="alert alert-warning">You will be required to set up an authenticator again at your next login.</div>
    @if(error is not null){<div class="alert alert-danger">@error</div>} @if(done){<div class="alert alert-success">Authenticator reset. <a href="Account/Logout">Log out</a> to complete setup again.</div>}
    else {<EditForm Model="model" method="post" OnValidSubmit="Reset" FormName="reset-authenticator"><DxButton SubmitFormOnClick="true" Text="Reset authenticator" RenderStyle="ButtonRenderStyle.Danger" /></EditForm>}
</div></div>
@code { [CascadingParameter] private HttpContext HttpContext {get;set;}=default!; private readonly object model=new();private bool done;private string? error;private async Task Reset(){error=await Api.ResetAuthenticatorAsync();done=error is null;if(done)MfaFlow.ClearDeviceToken(HttpContext);} }
