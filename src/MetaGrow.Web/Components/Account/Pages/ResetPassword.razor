@page "/Account/ResetPassword"
@using System.ComponentModel.DataAnnotations
@inject AuthApiClient AuthApi
<PageTitle>Reset password | MetaGrow</PageTitle>
<div class="main-content"><div class="block-content"><div class="title"><div class="title-header-text">Reset password</div></div>
    @if (error is not null) { <div class="alert alert-danger">@error</div> }
    @if (complete) { <div class="alert alert-success">Your password has been reset. <a href="Account/Login">Log in</a>.</div> }
    else if (LinkValid) {
        <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="reset-password" Context="resetForm"><DataAnnotationsValidator /><ValidationSummary class="text-danger" />
            <input type="hidden" name="Input.Email" value="@Input.Email" /><input type="hidden" name="Input.Code" value="@Input.Code" />
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical"><DxFormLayoutItem Caption="New password" ColSpanMd="12"><InputText class="form-control" type="password" @bind-Value="Input.Password" name="Input.Password" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Confirm password" ColSpanMd="12"><InputText class="form-control" type="password" @bind-Value="Input.ConfirmPassword" name="Input.ConfirmPassword" /></DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="12"><DxButton CssClass="w-100" SubmitFormOnClick="true" Text="Reset password" /></DxFormLayoutItem></DxFormLayout>
        </EditForm>
    } else { <div class="alert alert-danger">The reset link is incomplete.</div> }
</div></div>
@code {
    [SupplyParameterFromQuery] private string? Email { get; set; } [SupplyParameterFromQuery] private string? Code { get; set; }
    [SupplyParameterFromForm(Name = "Input")] private ResetInput? FormInput { get; set; } private ResetInput Input => FormInput ??= new(); private string? error; private bool complete;
    private bool LinkValid => !string.IsNullOrWhiteSpace(Input.Email) && !string.IsNullOrWhiteSpace(Input.Code);
    protected override void OnInitialized() { if (string.IsNullOrEmpty(Input.Email)) Input.Email = Email ?? ""; if (string.IsNullOrEmpty(Input.Code)) Input.Code = Code ?? ""; }
    private async Task Submit() { var errors = await AuthApi.ResetPasswordAsync(new() { Email = Input.Email, Code = Input.Code, Password = Input.Password }); complete = errors.Length == 0; error = complete ? null : string.Join(" ", errors); }
    private sealed class ResetInput { public string Email { get; set; } = ""; public string Code { get; set; } = ""; [Required, StringLength(100, MinimumLength=8)] public string Password { get; set; } = ""; [Compare(nameof(Password))] public string ConfirmPassword { get; set; } = ""; }
}
