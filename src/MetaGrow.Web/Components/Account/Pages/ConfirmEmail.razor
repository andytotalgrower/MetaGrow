@page "/Account/ConfirmEmail"
@inject AuthApiClient AuthApi
<PageTitle>Confirm email | MetaGrow</PageTitle>
<div class="main-content"><div class="block-content"><div class="title"><div class="title-header-text">Confirm email</div></div>
    @if (working) { <p>Confirming your email address…</p> }
    else if (errors.Length == 0) { <div class="alert alert-success">Your email is confirmed. You can now <a href="Account/Login">log in</a>.</div> }
    else { <div class="alert alert-danger">@string.Join(" ", errors)</div> }
</div></div>
@code {
    [SupplyParameterFromQuery] private string? UserId { get; set; }
    [SupplyParameterFromQuery] private string? Code { get; set; }
    private bool working = true; private string[] errors = [];
    protected override async Task OnInitializedAsync()
    {
        errors = string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code)
            ? ["The confirmation link is incomplete."] : await AuthApi.ConfirmEmailAsync(UserId, Code);
        working = false;
    }
}
