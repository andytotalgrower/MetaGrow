@page "/Account/ForgotPassword"
@using System.ComponentModel.DataAnnotations
@inject AuthApiClient AuthApi
<PageTitle>Forgot password | MetaGrow</PageTitle>
<div class="main-content"><div class="block-content"><div class="title"><div class="title-header-text">Forgot password</div><div class="title-content-text">We’ll email a reset link if the address belongs to a confirmed account.</div></div>
    @if (error is not null) { <div class="alert alert-danger">@error</div> }
    @if (sent) { <div class="alert alert-success">Check your email for a password reset link.</div> }
    <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="forgot-password" Context="forgotForm"><DataAnnotationsValidator /><ValidationSummary class="text-danger" />
        <DxFormLayout CaptionPosition="CaptionPosition.Vertical"><DxFormLayoutItem Caption="Email" ColSpanMd="12"><InputText class="form-control" @bind-Value="Input.Email" name="Input.Email" /></DxFormLayoutItem>
        <DxFormLayoutItem ColSpanMd="12"><DxButton CssClass="w-100" SubmitFormOnClick="true" Text="Send reset link" /></DxFormLayoutItem></DxFormLayout>
    </EditForm>
</div></div>
@code {
    [SupplyParameterFromForm(Name = "Input")] private EmailInput? FormInput { get; set; } private EmailInput Input => FormInput ??= new(); private bool sent; private string? error;
    private async Task Submit() { var errors = await AuthApi.ForgotPasswordAsync(Input.Email); sent = errors.Length == 0; error = sent ? null : string.Join(" ", errors); }
    private sealed class EmailInput { [Required, EmailAddress] public string Email { get; set; } = string.Empty; }
}
