@page "/Account/LoginWithRecoveryCode"
@using System.ComponentModel.DataAnnotations
@inject AuthApiClient AuthApi
@inject ServerTokenStore TokenStore
@inject MfaFlowState MfaFlow
@inject MetaGrow.Web.Components.Account.IdentityRedirectManager Redirect
<PageTitle>Recovery code | MetaGrow</PageTitle>
<div class="main-content"><div class="block-content"><div class="title"><div class="title-header-text">Recovery code</div><div class="title-content-text">Each recovery code can be used once.</div></div>
    @if (error is not null) { <div class="alert alert-danger">@error</div> }
    @if (pending is null) { <p>Your login session has expired. <a href="Account/Login">Log in again</a>.</p> } else {
        <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="recovery-login" Context="recoveryForm"><DataAnnotationsValidator /><ValidationSummary class="text-danger" />
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical"><DxFormLayoutItem Caption="Recovery code" ColSpanMd="12"><InputText class="form-control" @bind-Value="Input.Code" name="Input.Code" /></DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="12"><DxButton CssClass="w-100" SubmitFormOnClick="true" Text="Log in" /></DxFormLayoutItem></DxFormLayout>
        </EditForm>
    }
</div></div>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!; [SupplyParameterFromForm(Name = "Input")] private CodeInput? FormInput { get; set; } private CodeInput Input => FormInput ??= new(); [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private MfaPending? pending; private string? error; protected override void OnInitialized() => pending = MfaFlow.ReadPending(HttpContext);
    private async Task Submit() { pending=MfaFlow.ReadPending(HttpContext); if (pending is null) return; var (auth, errors)=await AuthApi.MfaVerifyAsync(new() { ChallengeToken=pending.ChallengeToken, Code=Input.Code, IsRecoveryCode=true }); if (auth is null) { error=string.Join(" ", errors); return; } MfaFlow.ClearPending(HttpContext); await AuthCookieHelper.SignInAsync(HttpContext, TokenStore, auth, pending.RememberMe); Redirect.RedirectTo(ReturnUrl); }
    private sealed class CodeInput { [Required] public string Code { get; set; } = ""; }
}
