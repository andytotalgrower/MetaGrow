@inject NavigationManager NavigationManager
@implements IDisposable

<div>
    <DxMenu Orientation="Orientation.Vertical" CssClass="menu">
        <Items>
            <DxMenuItem NavigateUrl="/" Text="Home" CssClass="@MenuItemCssClass("/")" IconCssClass="icon icon-home" />
            <DxMenuItem NavigateUrl="/surveys/multicrop" Text="Multi-crop" CssClass="@MenuItemCssClass("/surveys/multicrop")" IconCssClass="icon icon-chart" />
            <DxMenuItem NavigateUrl="/surveys/banana" Text="Banana" CssClass="@MenuItemCssClass("/surveys/banana")" IconCssClass="icon icon-banana" />
            <AuthorizeView Roles="@(ApiModels.MetaGrow.MetaGrowRoles.Admin + "," + ApiModels.MetaGrow.MetaGrowRoles.AgricultureManager + "," + ApiModels.MetaGrow.MetaGrowRoles.Agronomist + "," + ApiModels.MetaGrow.MetaGrowRoles.Accountant)">
                <DxMenuItem NavigateUrl="/surveys/samples" Text="Samples" CssClass="@MenuItemCssClass("/surveys/samples")" IconCssClass="icon icon-flask" />
            </AuthorizeView>
            <AuthorizeView Roles="@(ApiModels.MetaGrow.MetaGrowRoles.Admin + "," + ApiModels.MetaGrow.MetaGrowRoles.AgricultureManager)">
                <DxMenuItem NavigateUrl="/farms" Text="Farms/Growers" CssClass="@MenuItemCssClass("/farms")" IconCssClass="icon icon-editable-grid" />
            </AuthorizeView>
            <AuthorizeView Roles="@ApiModels.MetaGrow.MetaGrowRoles.Agronomist">
                <DxMenuItem NavigateUrl="/farms/duplicates" Text="Duplicate farms" CssClass="@MenuItemCssClass("/farms/duplicates")" IconCssClass="icon icon-editable-grid" />
            </AuthorizeView>
        </Items>
    </DxMenu>
    <hr class="menu-separator" />
    <DxMenu Orientation="Orientation.Vertical" CssClass="menu">
        <Items>
            <AuthorizeView Roles="@(ApiModels.MetaGrow.MetaGrowRoles.Admin + "," + ApiModels.MetaGrow.MetaGrowRoles.AgricultureManager + "," + ApiModels.MetaGrow.MetaGrowRoles.Agronomist)">
                <DxMenuItem Text="Reports" CssClass="@MenuSectionCssClass("/reports")" IconCssClass="icon icon-chart">
                    <Items>
                        <DxMenuItem NavigateUrl="/reports/multicrop" Text="Multi-crop" CssClass="@MenuSectionCssClass("/reports/multicrop")" />
                        <DxMenuItem NavigateUrl="/reports/banana" Text="Banana" CssClass="@MenuSectionCssClass("/reports/banana")" />
                    </Items>
                </DxMenuItem>
            </AuthorizeView>
        </Items>
    </DxMenu>
    <hr class="menu-separator" />
    <DxMenu Orientation="Orientation.Vertical" CssClass="menu">
        <Items>
            <AuthorizeView Roles="@ApiModels.MetaGrow.MetaGrowRoles.Admin">
                <DxMenuItem NavigateUrl="/admin" Text="Administration" CssClass="@MenuItemCssClass("/admin")" IconCssClass="icon icon-settings" />
            </AuthorizeView>
            <AuthorizeView>
                <DxMenuItem Text="My account" CssClass="@MenuSectionCssClass("/Account/Manage")" IconCssClass="icon icon-user">
                    <Items>
                        <DxMenuItem NavigateUrl="/Account/Manage/EmailAddresses" Text="Email addresses" CssClass="@MenuItemCssClass("/Account/Manage/EmailAddresses")" />
                        <DxMenuItem NavigateUrl="/Account/Manage/TwoFactorAuthentication" Text="Two-factor authentication" CssClass="@MenuItemCssClass("/Account/Manage/TwoFactorAuthentication")" />
                        <DxMenuItem NavigateUrl="/Account/Manage/Passkeys" Text="Passkeys" CssClass="@MenuItemCssClass("/Account/Manage/Passkeys")" />
                    </Items>
                </DxMenuItem>
            </AuthorizeView>
        </Items>
    </DxMenu>
</div>

@code {
    private string? currentLocalPath;

    protected override void OnInitialized()
    {
        currentLocalPath = new Uri(NavigationManager.Uri).LocalPath;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentLocalPath = new Uri(e.Location).LocalPath;
        InvokeAsync(StateHasChanged);
    }

    private string? MenuItemCssClass(string itemPath) =>
        string.Equals(currentLocalPath, itemPath, StringComparison.OrdinalIgnoreCase) ? "menu-item-active" : null;

    private string? MenuSectionCssClass(string itemPath) =>
        currentLocalPath?.StartsWith(itemPath, StringComparison.OrdinalIgnoreCase) == true ? "menu-item-active" : null;

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
