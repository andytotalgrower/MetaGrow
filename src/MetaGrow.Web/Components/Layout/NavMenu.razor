@inject NavigationManager NavigationManager
@implements IDisposable

<div>
    <DxMenu Orientation="Orientation.Vertical" CssClass="menu">
        <Items>
            <DxMenuItem NavigateUrl="/" Text="Home" CssClass="@MenuItemCssClass("/")" IconCssClass="icon icon-home" />
            <DxMenuItem NavigateUrl="/surveys/multicrop" Text="Multi-crop surveys" CssClass="@MenuItemCssClass("/surveys/multicrop")" IconCssClass="icon icon-chart" />
            <DxMenuItem NavigateUrl="/surveys/banana" Text="Banana surveys" CssClass="@MenuItemCssClass("/surveys/banana")" IconCssClass="icon icon-basic-form" />
            <AuthorizeView Roles="@(ApiModels.MetaGrow.MetaGrowRoles.Admin + "," + ApiModels.MetaGrow.MetaGrowRoles.AgricultureManager + "," + ApiModels.MetaGrow.MetaGrowRoles.Agronomist + "," + ApiModels.MetaGrow.MetaGrowRoles.Accountant)">
                <DxMenuItem NavigateUrl="/surveys/samples" Text="Sample surveys" CssClass="@MenuItemCssClass("/surveys/samples")" IconCssClass="icon icon-demos" />
            </AuthorizeView>
            <AuthorizeView Roles="@(ApiModels.MetaGrow.MetaGrowRoles.Admin + "," + ApiModels.MetaGrow.MetaGrowRoles.AgricultureManager)">
                <DxMenuItem NavigateUrl="/farms" Text="Farm setup" CssClass="@MenuItemCssClass("/farms")" IconCssClass="icon icon-editable-grid" />
            </AuthorizeView>
            <AuthorizeView Roles="@ApiModels.MetaGrow.MetaGrowRoles.Agronomist">
                <DxMenuItem NavigateUrl="/farms/duplicates" Text="Duplicate farms" CssClass="@MenuItemCssClass("/farms/duplicates")" IconCssClass="icon icon-editable-grid" />
            </AuthorizeView>
        </Items>
    </DxMenu>
    <hr class="menu-separator" />
    <DxMenu Orientation="Orientation.Vertical" CssClass="menu">
        <Items>
            <AuthorizeView Roles="@ApiModels.MetaGrow.MetaGrowRoles.Admin">
                <DxMenuItem NavigateUrl="/admin" Text="Administration" CssClass="@MenuItemCssClass("/admin")" IconCssClass="icon icon-settings" />
            </AuthorizeView>
            <AuthorizeView>
                <DxMenuItem NavigateUrl="/Account/Manage/EmailAddresses" Text="My email addresses" CssClass="@MenuItemCssClass("/Account/Manage/EmailAddresses")" IconCssClass="icon icon-user" />
                <DxMenuItem NavigateUrl="/Account/Manage/TwoFactorAuthentication" Text="Two-factor auth" CssClass="@MenuItemCssClass("/Account/Manage/TwoFactorAuthentication")" IconCssClass="icon icon-settings" />
            </AuthorizeView>
        </Items>
    </DxMenu>
</div>

@code {
    private string? currentLocalPath;

    protected override void OnInitialized()
    {
        currentLocalPath = new Uri(NavigationManager.Uri).LocalPath;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentLocalPath = new Uri(e.Location).LocalPath;
        InvokeAsync(StateHasChanged);
    }

    private string? MenuItemCssClass(string itemPath) =>
        string.Equals(currentLocalPath, itemPath, StringComparison.OrdinalIgnoreCase) ? "menu-item-active" : null;

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
