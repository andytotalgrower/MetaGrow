@inject IThemeChangeService _themeChangeService
@inject IJSRuntime _js

<button type="button" class="theme-toggle" title="Toggle colour scheme"
        aria-label="Toggle colour scheme" aria-pressed="@(_isDark ? "true" : "false")" disabled="@_switching" @onclick="ToggleAsync">
    @if (_isDark)
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
    }
</button>

@code {
    private bool _isDark;
    private bool _switching;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _isDark = await _js.InvokeAsync<string>("mantineScheme.get") == "dark";
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        // Serialize switches so rapid clicks cannot leave component and page colours in different modes.
        if (_switching) return;
        _switching = true;
        try
        {
            var nextIsDark = !_isDark;
            await _themeChangeService.SetTheme(nextIsDark ? App._mantineDark : App._mantineLight);
            await _js.InvokeVoidAsync("mantineScheme.set", nextIsDark ? "dark" : "light");
            _isDark = nextIsDark;
        }
        finally { _switching = false; }
    }
}
