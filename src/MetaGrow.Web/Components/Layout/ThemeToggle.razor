@inject IThemeChangeService ThemeChangeService
@inject IJSRuntime JS

<button type="button" class="theme-toggle" title="Toggle colour scheme"
        aria-label="Toggle colour scheme" @onclick="ToggleAsync">
    @if (isDark)
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
    }
</button>

@code {
    private bool isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        isDark = await JS.InvokeAsync<string>("mantineScheme.get") == "dark";
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        isDark = !isDark;
        await ThemeChangeService.SetTheme(isDark ? App.MantineDark : App.MantineLight);
        await JS.InvokeVoidAsync("mantineScheme.set", isDark ? "dark" : "light");
        await JS.InvokeVoidAsync("mantineScheme.applyBody", isDark);
    }
}
