@inherits DrawerStateLayoutComponentBase
@inject NavigationManager NavigationManager

<div class="page">
    <Drawer CssClass="navigation-drawer" PanelWidth="240px">
        <HeaderTemplate>
            <div class="navigation-drawer-header">
                <NavLink href="@AddDrawerStateToUrl("/")">
                    <img class="logo" src="images/logo-metagen-inverted.png" alt="Metagen logo" />
                </NavLink>
                <NavLink aria-label="Close menu" href="@AddDrawerStateToUrlToggled(LocalPath)">
                    <DxButton aria-label="Close menu" RenderStyle="ButtonRenderStyle.Light"
                              RenderStyleMode="ButtonRenderStyleMode.Text" CssClass="btn-icon-only"
                              IconCssClass="@(ToggledDrawer ? "icon icon-close" : "icon icon-menu")" />
                </NavLink>
            </div>
        </HeaderTemplate>
        <BodyTemplate>
            <div class="w-100">
                @if (RequiresInteractiveNavigationIsland)
                {
                    <NavMenu @rendermode="InteractiveServer" />
                }
                else
                {
                    <NavMenu />
                }
            </div>
        </BodyTemplate>
        <FooterTemplate>
            <div class="navigation-drawer-footer">
                <span class="mg-text-brand">MetaGrow Crop Intelligence</span>
            </div>
        </FooterTemplate>
        <TargetContent>
            <div class="drawer-content">
                <div class="nav-buttons-container">
                    <NavLink aria-label="Open menu" href="@AddDrawerStateToUrlToggled(LocalPath)" class="menu-button">
                        <DxButton aria-label="Open menu" RenderStyle="ButtonRenderStyle.Secondary"
                                  RenderStyleMode="ButtonRenderStyleMode.Text" CssClass="btn-icon-only"
                                  IconCssClass="icon icon-menu" />
                    </NavLink>
                    @if (LocalPath != "/")
                    {
                        <NavLink href="@AddDrawerStateToUrl("/")" class="button-link">
                            <DxButton Text="Back to Home" RenderStyle="ButtonRenderStyle.Secondary"
                                      RenderStyleMode="ButtonRenderStyleMode.Text" CssClass="back-button"
                                      IconCssClass="icon icon-back" />
                        </NavLink>
                    }
                    <div class="switcher-panel"><ThemeToggle /></div>
                    <AuthorizeView>
                        <Authorized Context="auth">
                            <NavLink href="@AddDrawerStateToUrl("/Account/Manage/EmailAddresses")"
                                     class="display-desktop mg-user-name">@auth.User.Identity?.Name</NavLink>
                            <form action="Account/Logout" method="post" class="display-desktop">
                                <AntiforgeryToken />
                                <DxButton Text="Log out" SubmitFormOnClick="true" RenderStyle="ButtonRenderStyle.Secondary"
                                          RenderStyleMode="ButtonRenderStyleMode.Text" IconCssClass="icon icon-log-out" />
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <NavLink href="Account/Login" class="button-link display-desktop">
                                <DxButton Text="Log in" RenderStyle="ButtonRenderStyle.Secondary"
                                          RenderStyleMode="ButtonRenderStyleMode.Text" IconCssClass="icon icon-log-in" />
                            </NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
                <div class="page-content-container">@Body</div>
            </div>
        </TargetContent>
    </Drawer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string LocalPath => new Uri(NavigationManager.Uri).LocalPath;

    private bool RequiresInteractiveNavigationIsland =>
        HttpContext is not null && !HttpContext.AcceptsInteractiveRouting();
}
