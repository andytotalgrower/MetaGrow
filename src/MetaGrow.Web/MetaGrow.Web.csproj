      <NoWarn>NU1510</NoWarn>
    </PackageReference>
    <ProjectReference Include="..\MetaGrow.Shared\MetaGrow.Shared.csproj" />
    <ProjectReference Include="..\..\..\Metagen.Shared\Metagen.Shared.csproj" />
